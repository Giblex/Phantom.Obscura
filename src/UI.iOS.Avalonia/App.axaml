<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhantomVault.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Resources/Strings.en-US.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="MonoFontFamily">Menlo</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <StyleInclude Source="avares://PhantomVault.UI/Assets/Themes/PhantomTheme.Dark.axaml" />

    </Application.Styles>

</Application>
