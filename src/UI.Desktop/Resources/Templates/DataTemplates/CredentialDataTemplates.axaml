<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Giblex.Controls;assembly=PhantomVault.UI"
                    xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls;assembly=PhantomVault.UI"
                    xmlns:vm="clr-namespace:PhantomVault.UI.ViewModels;assembly=PhantomVault.UI">

    <DataTemplate x:Key="CredentialListTileTemplate">

        <Button Command="{Binding $parent[Window].DataContext.TileClickCommand}"
                CommandParameter="{Binding}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Margin="0"
                Classes="tile-button"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                MinHeight="96"
                Height="96"
                AutomationProperties.Name="{Binding Title}">
            <Panel>
            <Border x:Name="ListTileBorder"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    MinHeight="96"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    BoxShadow="{DynamicResource Shadow.ListTile}">
                <Border.Styles>
                    <Style Selector="Button.tile-button:pointerover Border#ListTileBorder">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="BoxShadow" Value="{DynamicResource TileHoverShadow}"/>
                    </Style>
                    <Style Selector="Button.tile-button:pointerover Border#ListTileHighlightOverlay">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Opacity" Value="0.10"/>
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    </Style>
                    <Style Selector="Button.tile-button:pressed Border#ListTileBorder">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="BoxShadow" Value="{DynamicResource TilePressedShadow}"/>
                    </Style>
                    <Style Selector="Button.tile-button:pressed Border#ListTileHighlightOverlay">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Opacity" Value="0.16"/>
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    </Style>
                </Border.Styles>

                <Grid Classes="tile-entrance">

                    <Border Background="#182C5278" IsHitTestVisible="False"/>

                    <Border Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="0" Margin="0" IsHitTestVisible="False"
                            Opacity="{Binding HasGroup, Converter={StaticResource BoolToOpacityConverter}}"
                            IsVisible="{Binding $parent[Window].DataContext.ShowCardSideBar}">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource CategoryNameToBrushConverter}">
                                <Binding Path="Group"/>
                                <Binding Path="$parent[Window].DataContext.Categories"/>
                            </MultiBinding>
                        </Border.Background>
                    </Border>

                    <!-- The padding lives here, on the content, not on ListTileBorder. With it on
                         the border, the tint layer, side bar and hover overlay above were all inset
                         by 16x12, which drew a frame of bare card around a tinted inner panel. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,12">

                        <Grid Grid.Column="0" Margin="12,0,16,0" VerticalAlignment="Center">
                            <Border Background="{Binding IconBackgroundBrush}" Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{Binding $parent[Window].DataContext.ShowEntryIcons}">
                                <Grid>
                                    <Image Source="{Binding AutoDetectedIconBitmap}" Width="64" Height="64" Stretch="Uniform" IsVisible="{Binding HasAutoDetectedIcon}"/>
                                    <StackPanel IsVisible="{Binding !HasAutoDetectedIcon}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayIcon}" FontSize="{StaticResource Type.H2.Size}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" IsVisible="{Binding HasCustomIcon}"/>
                                        <!-- No logo or custom icon: the entry type's icon instead of initials. -->
                                        <dcontrols:SvgIcon IconName="{Binding TypeIconName}" Width="34" Height="34"
                                                           IconColor="{DynamicResource PrimaryTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsVisible="{Binding ShowTypeIcon}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock FontSize="{StaticResource Type.H3.Size}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource PrivacyMaskConverter}">
                                            <Binding Path="Title"/>
                                            <Binding Path="$parent[Window].DataContext.PrivacyModeEnabled"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <dcontrols:SvgIcon IconName="Assets/SVG/Favourites.svg" Width="14" Height="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IconColor="{Binding FavoriteIconBrush}"
                                                   Opacity="{Binding FavoriteIconOpacity}"/>

                                <!-- Several entries for this service share this tile. -->
                                <Border IsVisible="{Binding HasMultipleAccounts}"
                                        CornerRadius="9"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding AccountCountText}"
                                               FontSize="{StaticResource Type.Tiny.Size}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsTotpEntry}">
                                <Border Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,6">
                                    <dcontrols:RollingCodeText Text="{Binding CurrentTotpCode}"
                                                               FontSize="{StaticResource Type.H2.Size}"
                                                               FontFamily="Consolas,monospace"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               CharacterSpacing="2"/>
                                </Border>
                                <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotpSecondsRemaining, StringFormat='{}{0}s remaining'}"
                                               FontSize="{StaticResource Type.Small.Size}"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <ProgressBar Value="{Binding TotpProgressPercent}"
                                                 Maximum="100"
                                                 Width="80"
                                                 Height="4"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource ControlBackgroundBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Vertical" Spacing="2" IsVisible="{Binding !IsTotpEntry}">
                                <TextBlock FontSize="{StaticResource Type.H5.Size}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource PrivacyMaskConverter}" ConverterParameter="DetailLine1">
                                            <Binding Path="DetailLine1"/>
                                            <Binding Path="$parent[Window].DataContext.PrivacyModeEnabled"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock FontSize="{StaticResource Type.Body.Size}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" IsVisible="{Binding HasDetailLine2}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource PrivacyMaskConverter}" ConverterParameter="DetailLine2">
                                            <Binding Path="DetailLine2"/>
                                            <Binding Path="$parent[Window].DataContext.PrivacyModeEnabled"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                    x:Name="QuickActionsPanel"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                            <!-- Clickable only while shown. At Opacity 0 the buttons were still
                                 hit-testable, so a click on the right of a tile silently hit an
                                 invisible copy (or, before, edit) button instead of the tile. -->
                            <StackPanel.Styles>
                                <Style Selector="Button:pointerover StackPanel#QuickActionsPanel">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                </Style>
                                <Style Selector="Border:pointerover StackPanel#QuickActionsPanel">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="IsHitTestVisible" Value="True"/>
                                </Style>
                            </StackPanel.Styles>
                            <StackPanel.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </StackPanel.Transitions>

                            <Button Command="{Binding $parent[Window].DataContext.CopyUsernameCommand}"
                                    CommandParameter="{Binding}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="{StaticResource Radius.Sm}"
                                    Padding="0"
                                    ToolTip.Tip="Copy username">
                                <TextBlock Text="👤"
                                           FontSize="{StaticResource Type.Body.Size}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>

                            <controls:LiquidGlassButton Command="{Binding $parent[Window].DataContext.CopyPasswordCommand}"
                                    CommandParameter="{Binding}"
                                    WidthOverride="34"
                                    HeightOverride="34"
                                    CornerRadiusValue="8"
                                    PaddingOverride="0"
                                    ToolTipText="Copy password">
                                <controls:LiquidGlassButton.ButtonContent>
                                    <TextBlock Text="🔑"
                                               FontSize="{StaticResource Type.Body.Size}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </controls:LiquidGlassButton.ButtonContent>
                            </controls:LiquidGlassButton>

                            <!-- No edit button here: double-click the tile (or use Edit on the
                                 display card). A one-click edit target on every tile opened the
                                 editor when people meant to select. -->
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ListTileHighlightOverlay"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Background="Transparent"
                            CornerRadius="0"
                            Opacity="0"
                            IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Category colour on the card, per the Category Manager's "Card colour" choice:
                 a border around the card or a bar across its top. Drawn over the tile rather
                 than inside its padding so the colour reaches the card's own edge; hit-testing
                 is off so clicks still reach the tile. -->
            <Border IsHitTestVisible="False"
                    BorderThickness="2"
                    Opacity="{Binding HasGroup, Converter={StaticResource BoolToOpacityConverter}}"
                    IsVisible="{Binding $parent[Window].DataContext.ShowCardColourBorder}">
                <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource CategoryNameToBrushConverter}">
                        <Binding Path="Group"/>
                        <Binding Path="$parent[Window].DataContext.Categories"/>
                    </MultiBinding>
                </Border.BorderBrush>
            </Border>
            <Border IsHitTestVisible="False"
                    Height="4"
                    VerticalAlignment="Top"
                    Opacity="{Binding HasGroup, Converter={StaticResource BoolToOpacityConverter}}"
                    IsVisible="{Binding $parent[Window].DataContext.ShowCardTopBar}">
                <Border.Background>
                    <MultiBinding Converter="{StaticResource CategoryNameToBrushConverter}">
                        <Binding Path="Group"/>
                        <Binding Path="$parent[Window].DataContext.Categories"/>
                    </MultiBinding>
                </Border.Background>
            </Border>
            </Panel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="CredentialGridTileTemplate">
        <Grid Margin="6,4,6,8" HorizontalAlignment="Stretch" Classes="tile-entrance">
            <Button Command="{Binding $parent[Window].DataContext.TileClickCommand}"
                    CommandParameter="{Binding}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Classes="tile-button-grid">
                <Border x:Name="GridTileBorder"
                        MinWidth="{StaticResource GridTileWidth}"
                        Height="{StaticResource GridTileHeight}"
                        Padding="0"
                        CornerRadius="{StaticResource Radius.Xl}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1"
                        ClipToBounds="False"
                        BoxShadow="{DynamicResource Shadow.GridTile}">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#55FFFFFF"/>
                    </Border.BorderBrush>
                    <Border.Styles>
                        <Style Selector="Button.tile-button-grid:pointerover Border#GridTileBorder">
                            <Setter Property="BorderBrush" Value="{DynamicResource QuickFilterGlassActiveBorderBrush}"/>
                            <Setter Property="BoxShadow" Value="{DynamicResource TileHoverShadow}"/>
                        </Style>
                        <Style Selector="Button.tile-button-grid:pointerover Border#GridTileHighlightOverlay">
                            <Setter Property="BorderBrush" Value="{DynamicResource QuickFilterGlassActiveBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Opacity" Value="0.12"/>
                            <Setter Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                        </Style>
                        <Style Selector="Button.tile-button-grid:pressed Border#GridTileBorder">
                            <Setter Property="BorderBrush" Value="{DynamicResource QuickFilterGlassActiveBorderBrush}"/>
                            <Setter Property="BoxShadow" Value="{DynamicResource TilePressedShadow}"/>
                        </Style>
                        <Style Selector="Button.tile-button-grid:pressed Border#GridTileHighlightOverlay">
                            <Setter Property="BorderBrush" Value="{DynamicResource QuickFilterGlassActiveBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Opacity" Value="0.18"/>
                            <Setter Property="Background" Value="{DynamicResource TilePressedBrush}"/>
                        </Style>
                    </Border.Styles>
                    <Grid>

                        <Border Background="#182C5278"
                                CornerRadius="{StaticResource Radius.Xl}"
                                IsHitTestVisible="False"/>

                        <Border Height="6"
                            Grid.ColumnSpan="2"
                            Grid.RowSpan="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                            CornerRadius="{StaticResource Radius.Xl},{StaticResource Radius.Xl},0,0"
                                Margin="0"
                                IsHitTestVisible="False"
                                Opacity="{Binding HasGroup, Converter={StaticResource BoolToOpacityConverter}}">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource CategoryNameToBrushConverter}">
                                    <Binding Path="Group"/>
                                    <Binding Path="$parent[Window].DataContext.Categories"/>
                                </MultiBinding>
                            </Border.Background>
                        </Border>

                        <Border Background="Transparent"
                            Grid.ColumnSpan="2"
                            Grid.RowSpan="2"
                                CornerRadius="{StaticResource Radius.Xl}"
                                IsHitTestVisible="False"
                                Margin="0,6,0,0"
                                Opacity="0"/>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="16"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="12,14,10,0">
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    IsVisible="{Binding $parent[Window].DataContext.ShowEntryIcons}"
                                    Background="{Binding IconBackgroundBrush}">
                                <Grid>
                                    <Image Source="{Binding AutoDetectedIconBitmap}"
                                           Width="34"
                                           Height="34"
                                           Stretch="Uniform"
                                           IsVisible="{Binding HasAutoDetectedIcon}"/>
                                    <dcontrols:SvgIcon IconName="{Binding TypeIconName}"
                                                       Width="20" Height="20"
                                                       IconColor="{DynamicResource PrimaryTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasAutoDetectedIcon}"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Spacing="2" Margin="0,14,12,0">
                            <TextBlock FontSize="{StaticResource Type.Label.Size}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1">
                                <TextBlock.Effect>
                                    <Binding Path="$parent[Window].DataContext.PrivacyModeEnabled"
                                             Converter="{StaticResource PrivacyBlurEffectConverter}"/>
                                </TextBlock.Effect>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource PrivacyMaskConverter}">
                                        <Binding Path="Title"/>
                                        <Binding Path="$parent[Window].DataContext.PrivacyModeEnabled"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontSize="{StaticResource Type.Tiny.Size}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1">
                                <TextBlock.Effect>
                                    <Binding Path="$parent[Window].DataContext.PrivacyModeEnabled"
                                             Converter="{StaticResource PrivacyBlurEffectConverter}"/>
                                </TextBlock.Effect>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource PrivacyMaskConverter}"
                                                  ConverterParameter="DetailLine1">
                                        <Binding Path="DetailLine1"/>
                                        <Binding Path="$parent[Window].DataContext.PrivacyModeEnabled"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <Rectangle Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Height="2"
                                   Opacity="0.0"
                                   Fill="Transparent"/>
                        <Rectangle Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Height="1"
                                   Fill="{DynamicResource ControlBorderBrush}"
                                   Opacity="0.0"
                                   VerticalAlignment="Bottom"/>

                        <Border x:Name="GridTileHighlightOverlay"
                                Grid.ColumnSpan="2"
                                Grid.RowSpan="2"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Background="Transparent"
                                CornerRadius="{StaticResource Radius.Xl}"
                                Opacity="0"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Button>

            <Border Width="48"
                    Height="{StaticResource GridTileHeight}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="-36,0,0,0"
                    Background="Transparent"
                    IsHitTestVisible="False">
                <Canvas IsHitTestVisible="True">
                    <Border Canvas.Top="-18"
                            Canvas.Right="0"
                            CornerRadius="{StaticResource Radius.Lg}"
                            Padding="0"
                            Width="48"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Effect="{x:Null}"
                            Opacity="0">
                        <Grid Width="48" Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <controls:LiquidGlassButton Grid.Row="0"
                                    Command="{Binding $parent[Window].DataContext.CopyPasswordCommand}"
                                    CommandParameter="{Binding}"
                                    WidthOverride="22"
                                    HeightOverride="22"
                                    CornerRadiusValue="6"
                                    PaddingOverride="0"
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,0">
                                <controls:LiquidGlassButton.ButtonContent>
                                    <TextBlock Text="⧉" FontSize="{StaticResource Type.Tiny.Size}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </controls:LiquidGlassButton.ButtonContent>
                            </controls:LiquidGlassButton>

                            <!-- Edit is a double-click on the tile (see CredentialListView), not a
                                 one-click button, so a stray click never opens the editor. -->

                            <controls:LiquidGlassButton Grid.Row="2"
                                    Command="{Binding $parent[Window].DataContext.DeleteCredentialCommand}"
                                    CommandParameter="{Binding}"
                                    WidthOverride="22"
                                    HeightOverride="22"
                                    CornerRadiusValue="6"
                                    PaddingOverride="0"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0">
                                <controls:LiquidGlassButton.ButtonContent>
                                    <TextBlock Text="🗑" FontSize="{StaticResource Type.Tiny.Size}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </controls:LiquidGlassButton.ButtonContent>
                            </controls:LiquidGlassButton>

                            <controls:LiquidGlassButton Grid.Row="3"
                                    Command="{Binding $parent[Window].DataContext.ToggleFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    WidthOverride="22"
                                    HeightOverride="22"
                                    CornerRadiusValue="6"
                                    PaddingOverride="0"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0">
                                <controls:LiquidGlassButton.ButtonContent>
                                    <dcontrols:SvgIcon IconName="Assets/SVG/Favourites.svg" Width="12" Height="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IconColor="{Binding FavoriteIconBrush}"
                                                       Opacity="{Binding FavoriteIconOpacity}"/>
                                </controls:LiquidGlassButton.ButtonContent>
                            </controls:LiquidGlassButton>
                        </Grid>
                    </Border>
                </Canvas>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GroupedListItemTemplate" DataType="vm:ListItemWrapper">
        <ContentControl>
            <ContentControl.Styles>
                <Style Selector="ContentControl">
                    <Setter Property="Content" Value="{Binding}"/>
                </Style>
            </ContentControl.Styles>

            <Grid>

                <!-- Deliberately mirrors the sidebar category pills: a faint tint of the
                     category colour, a bright accent bar carrying the identity, light text
                     and a muted count. A saturated pastel fill with dark text read as a
                     different design language sitting beside them.

                     Brushes come ready-made from ListItemWrapper. Binding a colour STRING at
                     SolidColorBrush.Color left the brush transparent - the binding resolved,
                     so FallbackValue never applied, but the string never coerced to a Color -
                     which is why these headers rendered as bare page background.

                     Sizing is tight on purpose: this is a separator between groups, not a
                     card. H5 at 16,12 padding made each header nearly as tall as the entries
                     it grouped.

                     Edge to edge, square and with no margin: the header is a banner across the
                     column that sits flush on the tiles it groups. The old 4px side inset and
                     8/1px vertical margins left it floating as a pill with a gap above its
                     first tile. -->
                <Border IsVisible="{Binding IsCategoryHeader}"
                        CornerRadius="0"
                        BorderThickness="0"
                        Padding="16,6"
                        Margin="0"
                        HorizontalAlignment="Stretch"
                        Background="{Binding CategoryBrush}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <!-- The accent bar carries the colour identity, exactly as the 8x22
                             bar does on the sidebar category pills. -->
                        <Border Grid.Column="0"
                                Width="8"
                                Height="18"
                                CornerRadius="4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="{Binding CategoryAccentBrush}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CategoryName}"
                                   FontSize="{StaticResource Type.Body.Size}"
                                   FontWeight="Bold"
                                   Foreground="{Binding CategoryForegroundBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding CategoryItemCount}"
                                   FontSize="{StaticResource Type.Small.Size}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,2,0"/>
                    </Grid>
                </Border>

                <ContentControl IsVisible="{Binding !IsCategoryHeader}"
                                Content="{Binding Credential}"
                                ContentTemplate="{StaticResource CredentialListTileTemplate}"/>
            </Grid>
        </ContentControl>
    </DataTemplate>

</ResourceDictionary>

