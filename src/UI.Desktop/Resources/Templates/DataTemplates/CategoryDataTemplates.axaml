<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="CategoryItemTemplate">

        <ToggleButton Command="{Binding $parent[Window].DataContext.SelectCategoryCommand}"
                      CommandParameter="{Binding Name}"
                      Classes="sidebar-filter-item-toggle category-filter"
                      Classes.bar-only="{Binding $parent[Window].DataContext.ShowCategoryColorBarOnly}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Height="36"
                      CornerRadius="14"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      IsChecked="{Binding IsActive, Mode=TwoWay}"
                      Tag="{Binding TileColor}"
                      AutomationProperties.Name="{Binding Name, StringFormat='Category: {0} ({1} items)'}"
                      Margin="6,2">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0,0,0">

                <Border Width="8" Height="22" CornerRadius="4" VerticalAlignment="Center"
                        IsVisible="{Binding $parent[Window].DataContext.ShowCategoryColors}">
                    <Border.Background>
                        <Binding Path="TileColor" Converter="{StaticResource HexToBrushConverter}"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="{Binding Count}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </StackPanel>
        </ToggleButton>
    </DataTemplate>

</ResourceDictionary>

