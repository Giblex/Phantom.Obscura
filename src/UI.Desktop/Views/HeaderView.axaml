<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Giblex.Controls"
             xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="70"
             x:Class="PhantomVault.UI.Views.HeaderView">

    <UserControl.Styles>

        <Style Selector="TextBox.search-box">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox.search-box /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.search-box:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox.search-box:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="FlyoutPresenter.actions-menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MaxHeight" Value="900"/>
            <Setter Property="MaxWidth" Value="500"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>

        <Style Selector="Button#ActionsMenuButton">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.28">
                        <CornerRadiusTransition.Easing>
                            <CubicEaseOut/>
                        </CornerRadiusTransition.Easing>
                    </CornerRadiusTransition>
                    <ThicknessTransition Property="BorderThickness" Duration="0:0:0.28">
                        <ThicknessTransition.Easing>
                            <CubicEaseOut/>
                        </ThicknessTransition.Easing>
                    </ThicknessTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#ActionsMenuButton /template/ Border#BaseBorder">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                    <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.28">
                        <CornerRadiusTransition.Easing>
                            <CubicEaseOut/>
                        </CornerRadiusTransition.Easing>
                    </CornerRadiusTransition>
                    <ThicknessTransition Property="BorderThickness" Duration="0:0:0.28">
                        <ThicknessTransition.Easing>
                            <CubicEaseOut/>
                        </ThicknessTransition.Easing>
                    </ThicknessTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#ActionsMenuButton /template/ controls|BorderEnergyTrace">
            <Setter Property="Transitions">
                <Transitions>
                    <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.28">
                        <CornerRadiusTransition.Easing>
                            <CubicEaseOut/>
                        </CornerRadiusTransition.Easing>
                    </CornerRadiusTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#ActionsMenuButton.menu-open /template/ controls|BorderEnergyTrace">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <!-- Menu-open state intentionally does not override the button's appearance,
             so the dropdown toggle looks the same whether the menu is closed or open. -->
        <Style Selector="Button#ActionsMenuButton /template/ Border">
            <Setter Property="Transitions">
                <Transitions>
                    <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.28">
                        <CornerRadiusTransition.Easing>
                            <CubicEaseOut/>
                        </CornerRadiusTransition.Easing>
                    </CornerRadiusTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#ActionsMenuButton /template/ Border#Sheen">
            <Setter Property="Transitions">
                <Transitions>
                    <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.28">
                        <CornerRadiusTransition.Easing>
                            <CubicEaseOut/>
                        </CornerRadiusTransition.Easing>
                    </CornerRadiusTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.25" Easing="SineEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#ActionsMenuButton /template/ Border#DisabledMask">
            <Setter Property="Transitions">
                <Transitions>
                    <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.28">
                        <CornerRadiusTransition.Easing>
                            <CubicEaseOut/>
                        </CornerRadiusTransition.Easing>
                    </CornerRadiusTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#ActionsMenuButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.28">
                        <CornerRadiusTransition.Easing>
                            <CubicEaseOut/>
                        </CornerRadiusTransition.Easing>
                    </CornerRadiusTransition>
                </Transitions>
            </Setter>
        </Style>
        <!-- Menu-open state — no styling override. Button looks identical
             whether the menu is open or closed. -->

    </UserControl.Styles>

    <Border Classes="header-surface"
            Background="{DynamicResource HeaderPrimaryBrush}"
            Padding="{StaticResource DialogPadding}"
            BorderBrush="#4013758C"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,12,12"
            ClipToBounds="True"
            Effect="{x:Null}">
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- Sporadic teal radial blobs — inside a zero-measure Canvas so
                 they don't grow the banner. Each blob is anchor-positioned via
                 Canvas.Left/Top and clips against the parent Border's ClipToBounds. -->
            <Canvas Grid.Column="0" Grid.ColumnSpan="3"
                    IsHitTestVisible="False"
                    Width="0" Height="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Canvas.Left="240" Canvas.Top="-60" Width="180" Height="180">
                    <Border.Background>
                        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                            <GradientStop Color="{DynamicResource HeaderBlob1Color}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border Canvas.Left="520" Canvas.Top="-40" Width="160" Height="160">
                    <Border.Background>
                        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                            <GradientStop Color="{DynamicResource HeaderBlob2Color}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border Canvas.Left="880" Canvas.Top="-60" Width="200" Height="200">
                    <Border.Background>
                        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                            <GradientStop Color="{DynamicResource HeaderBlob3Color}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border Canvas.Left="1200" Canvas.Top="-40" Width="140" Height="140">
                    <Border.Background>
                        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                            <GradientStop Color="{DynamicResource HeaderBlob4Color}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
            </Canvas>

            <!-- Dot-grid overlay (matches welcome page / giblex.com). -->
            <Border Grid.Column="0" Grid.ColumnSpan="3"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="-24,-16,-24,-16"
                    RenderOptions.BitmapInterpolationMode="None">
                <Border.Background>
                    <ImageBrush Source="avares://PhantomVault.UI/Assets/dot_pattern.png"
                                TileMode="Tile"
                                Stretch="None"
                                SourceRect="0,0,8,8"
                                DestinationRect="0,0,8,8"/>
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                <Image Source="avares://PhantomVault.UI/Assets/Visuals/Giblex Icons/Icon Transparent background.png" Width="48" Height="48" VerticalAlignment="Center"/>
                <StackPanel Spacing="2">
                    <TextBlock Text="PhantomObscura"
                               FontSize="{StaticResource Type.H4.Size}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource LogoTitleBrush}"/>
                    <TextBlock Text="{Binding VaultName}"
                               FontSize="{StaticResource Type.Tiny.Size}"
                               Classes="header-muted"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="30,0" VerticalAlignment="Center">
                <Border Grid.Column="0"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        MinWidth="320"
                        MaxWidth="700"
                        Margin="0,0,1,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0"
                              Data="{StaticResource Icon.Search}"
                              Width="20"
                              Height="20"
                              Margin="12,0,0,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Stroke="{DynamicResource MutedTextBrush}"
                              StrokeThickness="1.5"
                              Fill="Transparent"/>
                        <TextBox Grid.Column="1"
                                 Classes="search-box"
                                 Text="{Binding SearchText}"
                                 Watermark="Search credentials..."
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 Padding="8,8"
                                 FontSize="{StaticResource Type.Label.Size}">
                            <InputElement.KeyBindings>
                                <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}"/>
                            </InputElement.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                Classes="liquid-glass"
                                Width="30"
                                Height="30"
                                MinWidth="30"
                                MinHeight="30"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Margin="0,0,4,0"
                                ToolTip.Tip="Clear search"
                                AutomationProperties.Name="Clear search"
                                IsVisible="{Binding HasSearchText}">
                            <Path Data="{StaticResource Icon.X}"
                                  Width="14"
                                  Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource HeaderSvgIconColor}"
                                  StrokeThickness="1.5"
                                  Fill="Transparent"/>
                        </Button>
                    </Grid>
                </Border>

                <controls:LiquidGlassButton Grid.Column="1"
                        Command="{Binding ToggleViewModeCommand}"
                        WidthOverride="44"
                        HeightOverride="44"
                        CornerRadiusValue="12"
                        PaddingOverride="8,12,8,8"
                        ToolTipText="Toggle list/grid view"
                        AutomationProperties.Name="Toggle list or grid view"
                        IsVisible="{Binding !IsShowingSecureTrash}">
                    <controls:LiquidGlassButton.ButtonContent>

                        <Grid Width="22" Height="22">
                            <Viewbox Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding !IsGridView}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M14,14 L21,14 L21,21 L14,21 Z M3,14 L10,14 L10,21 L3,21 Z"
                                          Stroke="{DynamicResource HeaderSvgIconColor}"
                                          StrokeThickness="1.5"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <Viewbox Width="22" Height="22"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsGridView}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4 6h16M4 12h16M4 18h16"
                                          Stroke="{DynamicResource HeaderSvgIconColor}"
                                          StrokeThickness="1.7"
                                          StrokeLineCap="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </controls:LiquidGlassButton.ButtonContent>
                </controls:LiquidGlassButton>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                <Button x:Name="ActionsMenuButton"
                        Classes="liquid-glass icon"
                        Width="44"
                        Height="44"
                        MinWidth="44"
                        MinHeight="44"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Actions menu"
                        AutomationProperties.Name="Add credential or actions menu">

                    <Button.Styles>

                        <!-- Menu-open state keeps the button's normal rounded shape.
                             (Previously flattened its bottom corners to fake a seamless
                             join with the dropdown, but that showed a hard seam / dark
                             line whenever the two backgrounds didn't match perfectly.) -->
                    </Button.Styles>
                    <Button.Flyout>
                        <!-- VerticalOffset was 6 — a visible gap that broke the intended
                             "seamless panel" look (the button flattens its bottom corners via
                             the menu-open style, and the flyout below shares the exact same
                             background gradient, clearly meant to read as one continuous
                             shape). Flush against the button instead. -->
                        <Flyout Placement="BottomEdgeAlignedRight"
                                FlyoutPresenterClasses="actions-menu"
                                HorizontalOffset="0"
                                VerticalOffset="12">

                            <Grid x:Name="ActionsDropRootWrapper"
                                  Opacity="0"
                                  RenderTransformOrigin="1,0"
                                  RenderTransform="scaleY(0.001)">
                                <Grid.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.24">
                                            <DoubleTransition.Easing>
                                                <CubicEaseOut/>
                                            </DoubleTransition.Easing>
                                        </DoubleTransition>
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28">
                                            <TransformOperationsTransition.Easing>
                                                <CubicEaseOut/>
                                            </TransformOperationsTransition.Easing>
                                        </TransformOperationsTransition>
                                    </Transitions>
                                </Grid.Transitions>
                            <!-- Was the same hardcoded dark-navy gradient as the button above —
                                 matched here too, for the same reason (theme-correctness and a
                                 seamless join with the button regardless of theme). -->
                            <Border x:Name="ActionsDropRoot"
                                    CornerRadius="20"
                                    Padding="10,16,10,10"
                                    MinWidth="240"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    Background="{DynamicResource HeaderBackgroundBrush}"
                                    ClipToBounds="True"
                                    BoxShadow="0 26 80 -10 #40000000, 0 8 24 -6 #30000000">
                                <Grid>

                                    <!-- BorderEnergyTrace overlay removed — its
                                         negative margin drew trace lines above
                                         the flyout's top edge, which looked like
                                         a squared-off top-left corner. -->
                                <StackPanel Spacing="4">

                                    <TextBlock Text="Add Credential"
                                               FontSize="{StaticResource Type.Body.Size}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="12,8,12,12"/>
                                    <Button Command="{Binding AddLoginCredentialCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add Login or Password"
                                            Padding="12,8">
                                        <TextBlock Text="→ Login / Password" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>
                                    <Button Command="{Binding AddCreditCardCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add Credit Card"
                                            Padding="12,8">
                                        <TextBlock Text="→ Credit Card" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>
                                    <Button Command="{Binding AddBankAccountCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add Bank Account"
                                            Padding="12,8">
                                        <TextBlock Text="→ Bank Account" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>
                                    <Button Command="{Binding AddIdentityCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add Identity or Document"
                                            Padding="12,8">
                                        <TextBlock Text="→ Identity / Document" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>
                                    <Button Command="{Binding AddSecureNoteCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add Secure Note"
                                            Padding="12,8">
                                        <TextBlock Text="→ Secure Note" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>
                                    <Button Command="{Binding AddWiFiPasswordCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add WiFi Network"
                                            Padding="12,8">
                                        <TextBlock Text="→ WiFi Network" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>
                                    <Button Command="{Binding AddApiKeyCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add API Key"
                                            Padding="12,8">
                                        <TextBlock Text="→ API Key" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>
                                    <Button Command="{Binding AddContactCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add Contact or Personal Info"
                                            Padding="12,8">
                                        <TextBlock Text="→ Contact / Personal Info" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>
                                    <Button Command="{Binding AddPinCodeCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add PIN Code"
                                            Padding="12,8">
                                        <TextBlock Text="→ PIN Code" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>
                                    <Button Command="{Binding AddBlankEntryCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Add blank entry built from sections"
                                            ToolTip.Tip="Start from nothing and build the entry out of whichever sections you want"
                                            Padding="12,8">
                                        <TextBlock Text="→ Blank / Custom Entry" FontSize="{StaticResource Type.Small.Size}"/>
                                    </Button>

                                    <Separator Margin="0,8" Background="{DynamicResource ControlBorderBrush}"/>

                                    <TextBlock Text="ACTIONS"
                                               FontSize="{StaticResource Type.Tiny.Size}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="8,4,8,4"/>
                                    <Button x:Name="PasswordGeneratorButton"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Open Password Generator"
                                            Padding="12,10">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Path Data="{StaticResource Icon.Key}"
                                                  Width="22"
                                                  Height="22"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent"/>
                                            <TextBlock Text="Password Generator" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ToggleSecurityDashboardCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Open Security Dashboard"
                                            Padding="12,10">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Path Data="{StaticResource Icon.Shield}"
                                                  Width="22"
                                                  Height="22"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent"/>
                                            <TextBlock Text="Security Dashboard" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LockCommand}"
                                            Classes="liquid-glass"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            AutomationProperties.Name="Lock Vault"
                                            Padding="12,10">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Path Data="{StaticResource Icon.Lock}"
                                                  Width="22"
                                                  Height="22"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent"/>
                                            <TextBlock Text="Lock Vault" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                </Grid>
                            </Border>

                            <Border VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Width="48"
                                    Height="14"
                                    Margin="0,-10,-1,0"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource HeaderBackgroundBrush}"/>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>

                    <Grid Width="22" Height="22">
                        <Viewbox Width="22" Height="22"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icon.Plus}"
                                      Stroke="{DynamicResource HeaderSvgIconColor}"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>

                <Button x:Name="SettingsButton"
                        Classes="liquid-glass icon"
                        Width="44"
                        Height="44"
                        MinWidth="44"
                        MinHeight="44"
                        Padding="0"
                        CornerRadius="{StaticResource Radius.Lg}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="Vault settings"
                        AutomationProperties.Name="Vault settings">
                    <Grid Width="22" Height="22">
                        <Viewbox Width="22" Height="22"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icon.Settings}"
                                      Stroke="{DynamicResource HeaderSvgIconColor}"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>

