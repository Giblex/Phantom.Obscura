<?xml version="1.0" encoding="utf-8"?>
<views:ThemeAwareWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="https://github.com/avaloniaui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:PhantomVault.UI.Views"
    mc:Ignorable="d"
    x:Class="PhantomVault.UI.Views.SecurityDashboardWindow"
    Title="Security Dashboard - Full Analysis"
    Width="1000"
    Height="800"
    MinWidth="1000"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource WindowBackgroundBrush}"
    Classes="animated-window">

    <Grid RowDefinitions="Auto,Auto,*" Margin="0" Background="{DynamicResource WindowBackgroundBrush}">

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Grid Grid.Column="0" Width="72" Height="72" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="36"
                                Background="{Binding SecurityScoreColor}" Opacity="0.16"/>
                        <Border Width="72" Height="72" CornerRadius="36"
                                BorderThickness="4" BorderBrush="{Binding SecurityScoreColor}" Opacity="0.9"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                            <TextBlock Text="{Binding SecurityScore}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{Binding SecurityScoreColor}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="/100" FontSize="9"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Security Dashboard"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}">
                            <Run Text="{Binding SecurityScoreLabel}" FontWeight="SemiBold"/>
                            <Run Text=" • "/>
                            <Run Text="{Binding TotalCount}"/>
                            <Run Text=" passwords • Live updating"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Command="{Binding RefreshSecurityDashboard}"
                            IsEnabled="{Binding !IsRefreshingDashboard}"
                            Classes="liquid-glass"
                            ToolTip.Tip="Refresh all metrics"
                            VerticalAlignment="Center"
                            Padding="14,12">
                        <Panel>
                            <Path Data="{StaticResource Icon.Refresh}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  Fill="Transparent"
                                  IsVisible="{Binding !IsRefreshingDashboard}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRefreshingDashboard}">
                                <TextBlock Text="⏳" FontSize="18"/>
                                <TextBlock Text="Refreshing…" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Panel>
                    </Button>
                </Grid>

                <Border Background="{DynamicResource ControlBackgroundBrush}"
                        CornerRadius="8"
                        Padding="6,0">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}"
                              Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="8,0,6,0"
                              Stroke="{DynamicResource SecondaryTextBrush}"
                              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                              Fill="Transparent"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TestPassword}"
                                 Watermark="Test a password's strength…"
                                 Padding="2,9"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Spacing="8" IsVisible="{Binding TestPassword.Length}">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="Strength:" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <ProgressBar Grid.Column="1" Margin="8,0" Value="{Binding TestPasswordScore}" Maximum="100" Height="6" Classes="strength-bar"/>
                            <TextBlock Grid.Column="2" Text="{Binding TestPasswordScore}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>
                        <TextBlock Text="{Binding TestPasswordStrengthLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding TestPasswordStrengthColor}"/>

                        <StackPanel Spacing="4" IsVisible="{Binding HasSuggestedPassword}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="{StaticResource Icon.Lightbulb}"
                                      Width="13" Height="13" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                      Fill="Transparent"/>
                                <Border Background="{DynamicResource ControlBackgroundBrush}" Padding="10,5" CornerRadius="4" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding SuggestedPassword}" FontFamily="Courier New" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Border>
                                <Button Content="Copy" Command="{Binding CopySuggestedPasswordCommand}" Classes="liquid-glass" Padding="10,5" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                                    <Run Text="Similarity: "/>
                                    <Run Text="{Binding SimilarityPercentage}"/>
                                    <Run Text="%"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid ColumnDefinitions="*,*,*,*,*,*,*">

                <Border Grid.Column="0" Margin="6,0" MinHeight="46" Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Total" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="6,0" MinHeight="46" Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" IsVisible="{Binding CanUseFullSecurityDashboard}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding WeakCredentials.Count}" FontSize="18" FontWeight="Bold" Foreground="#FFA726"/>
                        <TextBlock Text="Weak" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="6,0" MinHeight="46" Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" IsVisible="{Binding CanUseFullSecurityDashboard}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ReusedPasswordCount}" FontSize="18" FontWeight="Bold" Foreground="#EF5350"/>
                        <TextBlock Text="Reused" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Margin="6,0" MinHeight="46" Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" IsVisible="{Binding CanUseFullSecurityDashboard}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding BreachedPasswordCount}" FontSize="18" FontWeight="Bold" Foreground="#E53935"/>
                        <TextBlock Text="Breached" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Margin="6,0" MinHeight="46" Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" IsVisible="{Binding CanUseFullSecurityDashboard}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ExpiringCredentialCount}" FontSize="18" FontWeight="Bold" Foreground="#AB47BC"/>
                        <TextBlock Text="Expiring" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="5" Margin="6,0" MinHeight="46" Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" IsVisible="{Binding CanUseFullSecurityDashboard}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TwoFactorEnabledCount}" FontSize="18" FontWeight="Bold" Foreground="#29B6F6"/>
                        <TextBlock Text="2FA" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Margin="6,0" MinHeight="46" Padding="12,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ToolTip.Tip="Average password entropy (bits) across the vault" IsVisible="{Binding CanUseFullSecurityDashboard}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AverageEntropyDisplay}" FontSize="18" FontWeight="Bold" Foreground="#66BB6A"/>
                        <TextBlock Text="Avg bits" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding CanUseFullSecurityDashboard}">

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="24,16" Margin="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Filter by Security Score" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleButton Classes="liquid-glass" Padding="12,8" Content="⚪ Show All" ToolTip.Tip="Show all passwords" IsChecked="{Binding ShowAllFilter}" Command="{Binding FilterShowAllCommand}"/>
                        <ToggleButton Classes="liquid-glass" Padding="12,8" Content="🔴 Critical (0-40)" ToolTip.Tip="Security score 0-40" IsChecked="{Binding ShowCriticalFilter}" Command="{Binding FilterCriticalCommand}"/>
                        <ToggleButton Classes="liquid-glass" Padding="12,8" Content="🟠 Low (41-60)" ToolTip.Tip="Security score 41-60" IsChecked="{Binding ShowLowFilter}" Command="{Binding FilterLowCommand}"/>
                        <ToggleButton Classes="liquid-glass" Padding="12,8" Content="🟡 Medium (61-80)" ToolTip.Tip="Security score 61-80" IsChecked="{Binding ShowMediumFilter}" Command="{Binding FilterMediumCommand}"/>
                        <ToggleButton Classes="liquid-glass" Padding="12,8" Content="🟢 Good (81-100)" ToolTip.Tip="Security score 81-100" IsChecked="{Binding ShowGoodFilter}" Command="{Binding FilterGoodCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24,16" RowDefinitions="Auto,Auto">

                    <ItemsControl Grid.Row="0" ItemsSource="{Binding FilteredCredentialsForDashboard}" Margin="0" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type views:SecurityDashboardWindow}}, Path=DataContext.OpenEditPasswordCommand}" CommandParameter="{Binding Credential}" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                    <Border CornerRadius="6" Padding="0" Margin="0,0,0,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Stretch" MinHeight="76">
                                        <Grid ColumnDefinitions="6,*,80,Auto,70,100">

                                            <Border Grid.Column="0" CornerRadius="5,0,0,5" Background="{Binding CategoryColor}"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="12,10">

                                                <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center">
                                                    <Image Source="{Binding IconBitmap}" Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CredentialTitle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    <TextBlock Text="{Binding CredentialUsername}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="Security Score">
                                                <Border CornerRadius="4" Padding="8,6" Background="{Binding SecurityScoreColor}">
                                                    <TextBlock Text="{Binding SecurityScore}" FontWeight="Bold" Foreground="White" TextAlignment="Center" FontSize="12"/>
                                                </Border>
                                            </StackPanel>

                                            <ItemsControl Grid.Column="3" ItemsSource="{Binding StatusIndicators}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="3" Padding="4,2" ToolTip.Tip="{Binding Tooltip}" Background="{Binding Color}">
                                                            <TextBlock Text="{Binding Label}" FontSize="9" Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Grid.Column="4" Text="{Binding IsTwoFactorEnabled}" Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="5" Text="{Binding LastModifiedFormatted}" Margin="12,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="1" IsVisible="{Binding !FilteredCredentialsForDashboard.Count}" Text="No passwords to display" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" Margin="0,32"/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                IsVisible="{Binding !CanUseFullSecurityDashboard}"
                Background="{DynamicResource SurfaceBrush}"
                Padding="32"
                VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="420">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Path Data="{StaticResource Icon.Lock}"
                          Width="16" Height="16" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource PrimaryTextBrush}"
                          StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                          Fill="Transparent"/>
                    <TextBlock Text="Full dashboard is a Premium feature"
                               FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
                <TextBlock Text="Your Phantom Score and total credential count are always free. Upgrade to Premium to see per-password breakdowns, reuse and breach analysis, expiry tracking, 2FA coverage, and entropy averages."
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <Button Content="Upgrade to Premium"
                        Command="{Binding ShowSubscriptionSettingsCommand}"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="#FFFFFFFF"
                        Padding="16,8"/>
            </StackPanel>
        </Border>
    </Grid>
</views:ThemeAwareWindow>

