<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhantomVault.UI.ViewModels.Settings"
             xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls"
             x:Class="PhantomVault.UI.Views.Settings.PasswordSecurityView"
             x:DataType="vm:PasswordSecurityViewModel"
             x:CompileBindings="False">

    <!-- Same design as the password generator and dialogs (Styles/DialogStyles.axaml): an icon
         header, content in section tiles with small upper-case labels, SVG icons instead of
         emoji, and the standard dialog buttons. -->
    <UserControl.Styles>
        <!-- One issue row (a flagged entry) inside an issue tile. -->
        <Style Selector="Border.issue-row">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- Metric tile: icon, big number, label. -->
        <Style Selector="TextBlock.metric-value">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="TextBlock.metric-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="4" Margin="0,0,0,60">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,14,*" Margin="0,0,0,12">
            <Border Grid.Column="0" Classes="dialog-icon">
                <dcontrols:SvgIcon IconName="Assets/SVG/Current/Security.svg"
                                   Width="22" Height="22"
                                   IconColor="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Security" Classes="dialog-caption"/>
                <TextBlock Text="Password Security" Classes="dialog-title"/>
                <TextBlock Text="Strength analysis, reused and ageing passwords, and what to fix first."
                           Classes="dialog-message" FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- Quick actions -->
        <Border Classes="section-tile fade-in stagger-1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="QUICK ACTIONS" Classes="tile-label"/>
                    <TextBlock Text="Analyse the vault and act on what it finds."
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="liquid-glass dialog-button" Margin="0,0,8,0"
                            Command="{Binding ExportReportCommand}"
                            IsEnabled="{Binding HasReport}"
                            ToolTip.Tip="Export the security report to a file">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <dcontrols:SvgIcon IconName="Assets/SVG/Current/Export.svg" Width="14" Height="14"
                                               IconColor="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Export report" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="liquid-glass dialog-button" Margin="0,0,8,0"
                            Command="{Binding ShowFlaggedPasswordsCommand}"
                            IsEnabled="{Binding HasFlaggedPasswords}"
                            ToolTip.Tip="Show every flagged password">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <dcontrols:SvgIcon IconName="Assets/SVG/Current/Warning.svg" Width="14" Height="14"
                                               IconColor="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="View flagged" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="liquid-glass dialog-button dialog-primary"
                            Command="{Binding AnalyzeCommand}"
                            ToolTip.Tip="Run a full security analysis">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <dcontrols:SvgIcon IconName="Assets/SVG/Current/Search.svg" Width="14" Height="14"
                                               IconColor="{DynamicResource ButtonForegroundBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Scan passwords" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Score + metrics + strength: only once a report exists. -->
        <StackPanel Spacing="4" IsVisible="{Binding HasReport}">
            <Border Classes="section-tile fade-in stagger-2">
                <Grid ColumnDefinitions="Auto,18,*,Auto">
                    <!-- Score in a ring of its own colour. -->
                    <Border Width="84" Height="84" CornerRadius="42"
                            BorderThickness="3"
                            BorderBrush="{Binding SecurityScoreColor}"
                            Background="{DynamicResource ControlBackgroundBrush}">
                        <TextBlock Text="{Binding SecurityScore}"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{Binding SecurityScoreColor}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="SECURITY SCORE" Classes="tile-label"/>
                        <TextBlock Text="{Binding SecurityScoreLabel}"
                                   FontSize="19" FontWeight="SemiBold"
                                   Foreground="{Binding SecurityScoreColor}"/>
                        <TextBlock Text="{Binding LastAnalyzedText}" Classes="field-hint"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center" MaxWidth="150">
                        <TextBlock Text="{Binding SecurityStatusIcon}" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SecurityStatusText}"
                                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,10,*,10,*,10,*">
                <Border Grid.Column="0" Classes="section-tile">
                    <StackPanel Spacing="4">
                        <dcontrols:SvgIcon IconName="Assets/SVG/Current/Password.svg" Width="18" Height="18"
                                           IconColor="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Report.TotalCredentials}" Classes="metric-value"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Total passwords" Classes="metric-label"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="section-tile">
                    <StackPanel Spacing="4">
                        <dcontrols:SvgIcon IconName="Assets/SVG/Current/Warning.svg" Width="18" Height="18"
                                           IconColor="{DynamicResource ErrorBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Report.WeakCount}" Classes="metric-value"
                                   Foreground="{DynamicResource ErrorBrush}"/>
                        <TextBlock Text="Weak" Classes="metric-label"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="section-tile">
                    <StackPanel Spacing="4">
                        <dcontrols:SvgIcon IconName="Assets/SVG/Current/Link.svg" Width="18" Height="18"
                                           IconColor="{DynamicResource WarningBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Report.ReusedCount}" Classes="metric-value"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="Reused" Classes="metric-label"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Classes="section-tile">
                    <StackPanel Spacing="4">
                        <dcontrols:SvgIcon IconName="Assets/SVG/Current/Refresh.svg" Width="18" Height="18"
                                           IconColor="{DynamicResource WarningBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Report.OldCount}" Classes="metric-value"
                                   Foreground="{DynamicResource WarningBrush}"/>
                        <TextBlock Text="Not changed in a year" Classes="metric-label" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="section-tile">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="AVERAGE STRENGTH" Classes="tile-label" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AverageEntropyText}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{Binding AverageEntropyColor}"/>
                    </Grid>
                    <Border Background="{DynamicResource ControlBackgroundBrush}" Height="6" CornerRadius="3">
                        <Border Background="{Binding AverageEntropyColor}"
                                Width="{Binding AverageEntropyBarWidth}"
                                HorizontalAlignment="Left"
                                CornerRadius="3"/>
                    </Border>
                    <TextBlock Text="{Binding AverageEntropyDescription}" Classes="field-hint"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Issues: one tile per group. -->
        <StackPanel Spacing="4" IsVisible="{Binding HasIssues}">
            <Border Classes="section-tile fade-in stagger-3" IsVisible="{Binding HasWeakPasswords}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,12,*,Auto">
                        <Border Classes="dialog-icon" Width="36" Height="36" CornerRadius="18">
                            <dcontrols:SvgIcon IconName="Assets/SVG/Current/Warning.svg" Width="16" Height="16"
                                               IconColor="{DynamicResource ErrorBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WeakPasswordsHeader}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ErrorBrush}"/>
                            <TextBlock Text="Low entropy: easy to guess or crack." Classes="field-hint"/>
                        </StackPanel>
                        <Button Grid.Column="3" Classes="liquid-glass dialog-button"
                                Command="{Binding ViewWeakPasswordsCommand}" Content="View all"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WeakPasswordsSample}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="issue-row">
                                    <TextBlock Text="{Binding}" FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="section-tile" IsVisible="{Binding HasReusedPasswords}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,12,*,Auto">
                        <Border Classes="dialog-icon" Width="36" Height="36" CornerRadius="18">
                            <dcontrols:SvgIcon IconName="Assets/SVG/Current/Link.svg" Width="16" Height="16"
                                               IconColor="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReusedPasswordsHeader}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="One leak exposes every account that shares it." Classes="field-hint"/>
                        </StackPanel>
                        <Button Grid.Column="3" Classes="liquid-glass dialog-button"
                                Command="{Binding ViewReusedPasswordsCommand}" Content="View all"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ReusedPasswordsSample}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="issue-row">
                                    <TextBlock Text="{Binding}" FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="section-tile" IsVisible="{Binding HasOldPasswords}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,12,*,Auto">
                        <Border Classes="dialog-icon" Width="36" Height="36" CornerRadius="18">
                            <dcontrols:SvgIcon IconName="Assets/SVG/Current/Refresh.svg" Width="16" Height="16"
                                               IconColor="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OldPasswordsHeader}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="Not changed in over a year." Classes="field-hint"/>
                        </StackPanel>
                        <Button Grid.Column="3" Classes="liquid-glass dialog-button"
                                Command="{Binding ViewOldPasswordsCommand}" Content="View all"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding OldPasswordsSample}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="issue-row">
                                    <TextBlock Text="{Binding}" FontSize="14"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Settings -->
        <Border Classes="section-tile fade-in stagger-4">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <dcontrols:SvgIcon IconName="Assets/SVG/Current/Settings gear.svg" Width="14" Height="14"
                                       IconColor="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="ANALYSIS SETTINGS" Classes="tile-label" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox Content="Analyse automatically when the vault unlocks"
                          IsChecked="{Binding AutoAnalyzeOnUnlock}" FontSize="14"/>
                <CheckBox Content="Show password strength in the entry editor"
                          IsChecked="{Binding ShowPasswordStrengthInEditor}" FontSize="14"/>
                <CheckBox Content="Flag passwords shorter than 12 characters"
                          IsChecked="{Binding FlagShortPasswords}" FontSize="14"/>

                <StackPanel Classes="field-group">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Minimum entropy" Classes="field-label"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding EntropyThreshold, StringFormat='{}{0:F0} bits'}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                    <Slider Value="{Binding EntropyThreshold}" Minimum="20" Maximum="80"
                            TickFrequency="10" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="Lower values flag more passwords as weak." Classes="field-hint"/>
                </StackPanel>

                <StackPanel Classes="field-group">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Password age limit" Classes="field-label"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AgeThresholdDays, StringFormat='{}{0:F0} days'}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                    <Slider Value="{Binding AgeThresholdDays}" Minimum="90" Maximum="730"
                            TickFrequency="30" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="Passwords older than this are flagged." Classes="field-hint"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tips -->
        <Border Classes="section-tile fade-in stagger-5">
            <Grid ColumnDefinitions="Auto,12,*">
                <dcontrols:SvgIcon IconName="Assets/SVG/Current/Info.svg" Width="18" Height="18"
                                   IconColor="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="GOOD PRACTICE" Classes="tile-label"/>
                    <TextBlock Classes="field-hint" FontSize="13" Text="• At least 12–16 characters."/>
                    <TextBlock Classes="field-hint" FontSize="13" Text="• Mix upper and lower case, numbers and symbols."/>
                    <TextBlock Classes="field-hint" FontSize="13" Text="• Never reuse a password across accounts."/>
                    <TextBlock Classes="field-hint" FontSize="13" Text="• Change sensitive passwords every 3–6 months."/>
                    <TextBlock Classes="field-hint" FontSize="13" Text="• Leave out names, birthdays and other personal details."/>
                    <TextBlock Classes="field-hint" FontSize="13" Text="• Use the password generator for new passwords."/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
