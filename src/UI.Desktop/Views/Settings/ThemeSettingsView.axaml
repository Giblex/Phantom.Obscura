<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhantomVault.UI.ViewModels.Settings"
             xmlns:converters="using:PhantomVault.UI.Converters"
             x:Class="PhantomVault.UI.Views.Settings.ThemeSettingsView"
             x:DataType="vm:ThemeSettingsViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Resources/Converters/ConverterResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:ColouredBlurBrushConverter x:Key="ColouredBlurBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="20" Margin="0,0,0,60">
        <TextBlock Text="Theme Settings"
                   FontSize="{StaticResource Type.H3.Size}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <Border Classes="fade-in stagger-1" HorizontalAlignment="Stretch"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <StackPanel Spacing="15">
                <TextBlock Text="Theme Studio"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Switch colour palette — every palette here is free. Pick one and press Save to apply it."
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"/>

                <ItemsControl ItemsSource="{Binding ThemeSwatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeSwatch">
                            <Button Command="{Binding DataContext.ApplyThemeByIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Id}"
                                    Margin="0,0,10,10"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip.ShowDelay="300">
                                <!-- Rich hover preview — a miniature of the "Preview" panel
                                     further down this page (Header bar / icon sidebar / sample
                                     heading + body + Accent+Glass buttons), just built from
                                     this swatch's own three colours instead of the live
                                     DynamicResource theme (which reflects the currently-applied
                                     theme, not the one being hovered). Avalonia's ToolTip
                                     already shows on hover and hides on pointer-leave. -->
                                <ToolTip.Tip>
                                    <Border Width="260" CornerRadius="10" ClipToBounds="True"
                                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                            Background="{Binding Color1}">
                                        <Grid RowDefinitions="30,*">
                                            <Border Grid.Row="0"
                                                    BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                                                <TextBlock Text="Header"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0"
                                                           Foreground="{Binding PreviewForeground}"/>
                                            </Border>
                                            <Grid Grid.Row="1" ColumnDefinitions="46,*">
                                                <Border Grid.Column="0" Opacity="0.85"
                                                        BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0">
                                                    <StackPanel Margin="8,10" Spacing="5">
                                                        <Border Width="16" Height="16" CornerRadius="4" Background="{Binding Color2}"/>
                                                        <Border Height="4" CornerRadius="2" Background="{Binding PreviewMutedForeground}" Opacity="0.5"/>
                                                        <Border Height="4" CornerRadius="2" Background="{Binding PreviewMutedForeground}" Opacity="0.35"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,10" Spacing="6">
                                                    <TextBlock Text="Sample heading"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               Foreground="{Binding PreviewForeground}"/>
                                                    <TextBlock Text="The quick brown fox jumps."
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding PreviewMutedForeground}"/>
                                                    <!-- Real buttons in this app are liquid-glass (translucent
                                                         border + faint tinted fill + diagonal sheen), never a
                                                         flat colour pill — even for the "accent" one, which only
                                                         gets an accent-tinted border, not an accent fill. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                        <Border Padding="8,4" CornerRadius="5" BorderThickness="1"
                                                                BorderBrush="{Binding Color2}" ClipToBounds="True">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                    <GradientStop Color="#26FFFFFF" Offset="0"/>
                                                                    <GradientStop Color="#08FFFFFF" Offset="0.55"/>
                                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <TextBlock Text="Accent" FontSize="9" FontWeight="SemiBold" Foreground="{Binding PreviewForeground}"/>
                                                        </Border>
                                                        <Border Padding="8,4" CornerRadius="5" BorderThickness="1"
                                                                BorderBrush="{Binding PreviewMutedForeground}" ClipToBounds="True">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                    <GradientStop Color="#1AFFFFFF" Offset="0"/>
                                                                    <GradientStop Color="#06FFFFFF" Offset="0.55"/>
                                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <TextBlock Text="Glass" FontSize="9" Foreground="{Binding PreviewForeground}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </ToolTip.Tip>
                                <Border Width="120"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{Binding ActiveBorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Padding="12"
                                        Opacity="{Binding CardOpacity}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Color1}" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Color2}" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                                            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding Color3}" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="{StaticResource Type.Small.Size}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="🔒 Pro only"
                                                   IsVisible="{Binding IsLocked}"
                                                   FontSize="{StaticResource Type.Tiny.Size}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource ControlBorderBrush}" Height="1" Opacity="0.5" Margin="0,4"/>

                <TextBlock Text="More themes"
                           FontSize="{StaticResource Type.Small.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Additional palettes, system themes, and any custom themes you create."
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <ComboBox
                    ItemsSource="{Binding RuntimeThemeNames}"
                    SelectedIndex="{Binding SelectedRuntimeThemeIndex, Mode=TwoWay}"
                    Width="250"
                    HorizontalAlignment="Left"/>

                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Coloured category blur"
                                   FontSize="{StaticResource Type.Body.Size}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Tint category tiles with their own colour. When off, tiles use a neutral translucent glass."
                                   FontSize="{StaticResource Type.Small.Size}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0"
                                  IsChecked="{Binding UseColouredCategoryBlur, Mode=TwoWay}"/>
                </Grid>

                <!-- Static side-by-side example of a category tile with and without the
                     coloured blur, independent of the toggle above and of Save — this is
                     the "preview" the toggle no longer needs to live-apply for. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,2,0,0">
                    <Border Grid.Column="0" CornerRadius="10"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Padding="10,8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="With colour"
                                       FontSize="{StaticResource Type.Tiny.Size}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <Border CornerRadius="10" Padding="8,6">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource ColouredBlurBrushConverter}">
                                        <Binding Path="AccentColorHex"/>
                                        <Binding Path="PreviewBlurOn"/>
                                    </MultiBinding>
                                </Border.Background>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                            Background="{Binding AccentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Category"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Type.Small.Size}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="10"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Padding="10,8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Without colour"
                                       FontSize="{StaticResource Type.Tiny.Size}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <Border CornerRadius="10" Padding="8,6">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource ColouredBlurBrushConverter}">
                                        <Binding Path="AccentColorHex"/>
                                        <Binding Path="PreviewBlurOff"/>
                                    </MultiBinding>
                                </Border.Background>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="4" CornerRadius="2"
                                            Background="{Binding AccentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="Category"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Type.Small.Size}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0"
                            IsVisible="{Binding CanUseCustomThemes}">
                    <Button Content="Create Custom Theme"
                            Command="{Binding CreateCustomThemeCommand}"
                            Background="#2B4A7A"
                            Foreground="#FFFFFFFF"
                            BorderBrush="{DynamicResource Brush.Glass.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            Padding="12,6"/>
                    <Button Content="Delete Custom Theme"
                            Command="{Binding DeleteCustomThemeCommand}"
                            IsVisible="{Binding IsCustomThemeSelected}"
                            Foreground="{DynamicResource ErrorBrush}"
                            Padding="12,6"/>
                </StackPanel>

                <Border IsVisible="{Binding IsCustomThemesLocked}"
                        Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Md}"
                        Padding="14"
                        Margin="0,5,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="🔒 Custom themes are a Premium feature"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Free plan includes the Dark and Light themes. Upgrade to create and save your own."
                                       FontSize="{StaticResource Type.Small.Size}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Upgrade"
                                Command="{Binding UpgradeCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="#FFFFFFFF"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Padding="12,6"/>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsCustomEditorOpen}"
                        Background="{DynamicResource ContentBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Md}"
                        Padding="16"
                        Margin="0,8,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Custom Theme Editor" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Pick your base colors. The full theme is generated automatically."
                                   FontSize="{StaticResource Type.Small.Size}" Foreground="{DynamicResource MutedTextBrush}"/>

                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme Name" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomThemeName, Mode=TwoWay}" Width="200" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Primary BG" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="4" Background="{Binding CustomPrimaryBgPreview}"/>
                                <TextBox Text="{Binding CustomPrimaryBg, Mode=TwoWay}" Width="100"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Secondary BG" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="4" Background="{Binding CustomSecondaryBgPreview}"/>
                                <TextBox Text="{Binding CustomSecondaryBg, Mode=TwoWay}" Width="100"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Surface BG" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="4" Background="{Binding CustomSurfaceBgPreview}"/>
                                <TextBox Text="{Binding CustomSurfaceBg, Mode=TwoWay}" Width="100"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Accent" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="4" Background="{Binding CustomAccentPreview}"/>
                                <TextBox Text="{Binding CustomAccent, Mode=TwoWay}" Width="100"/>
                            </StackPanel>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Accent Hover" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="4" Background="{Binding CustomAccentHoverPreview}"/>
                                <TextBox Text="{Binding CustomAccentHover, Mode=TwoWay}" Width="100"/>
                            </StackPanel>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Text Primary" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="4" Background="{Binding CustomTextPrimaryPreview}"/>
                                <TextBox Text="{Binding CustomTextPrimary, Mode=TwoWay}" Width="100"/>
                            </StackPanel>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Text Muted" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="4" Background="{Binding CustomTextMutedPreview}"/>
                                <TextBox Text="{Binding CustomTextMuted, Mode=TwoWay}" Width="100"/>
                            </StackPanel>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Border" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Border Width="24" Height="24" CornerRadius="4" Background="{Binding CustomBorderPreview}"/>
                                <TextBox Text="{Binding CustomBorder, Mode=TwoWay}" Width="100"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Button Content="Save &amp; Apply"
                                    Command="{Binding SaveCustomThemeCommand}"
                                    Classes="dull-blue" Padding="14,6"/>
                            <Button Content="Cancel"
                                    Command="{Binding CancelCustomThemeCommand}"
                                    Classes="liquid-glass"
                                    Padding="14,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ControlBorderBrush}" Height="1" Opacity="0.5" Margin="0,4"/>

                <StackPanel Spacing="8">
                    <TextBlock Text="Display scale:"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ComboBox Width="150"
                              HorizontalAlignment="Left"
                              SelectedIndex="{Binding SelectedDisplayScale}">
                        <ComboBoxItem Content="80%"/>
                        <ComboBoxItem Content="90%"/>
                        <ComboBoxItem Content="100% (Default)"/>
                        <ComboBoxItem Content="110%"/>
                        <ComboBoxItem Content="125%"/>
                        <ComboBoxItem Content="150%"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Font:"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FontFamilyOptions}"
                              SelectedItem="{Binding AppFontFamily, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Font size:"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FontSizeOptions}"
                              SelectedIndex="{Binding SelectedFontSizeIndex, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Accent colour:"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ComboBox Width="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AccentColorOptions}"
                              SelectedItem="{Binding AccentColorHex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="20" Height="20" CornerRadius="4"
                                            Background="{Binding}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <CheckBox Content="Use flat buttons (disable liquid-glass chrome)"
                          IsChecked="{Binding UseFlatButtons, Mode=TwoWay}"
                          ToolTip.Tip="Replace liquid-glass button styling with a solid accent-colored flat button across the app."/>

                <CheckBox Content="Use flat button borders (keep glass body, flatten border)"
                          IsChecked="{Binding UseFlatButtonBorders, Mode=TwoWay}"
                          ToolTip.Tip="Replaces the liquid-glass gradient border with a plain 1px border. Hover accents the border. Independent of Use flat buttons — only the border changes, not the body fill."/>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-2" HorizontalAlignment="Stretch"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <StackPanel Spacing="12">
                <TextBlock Text="Preview"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Live preview of theme, accent, font and button styling. Changes apply across the app on save."
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"/>

                <Border Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True"
                        Height="260">
                    <Grid RowDefinitions="38,*">

                        <Border Grid.Row="0"
                                Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Header"
                                       FontFamily="{Binding AppFontFamily}"
                                       FontSize="{Binding AppFontSize}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="14,0"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>

                        <Grid Grid.Row="1" ColumnDefinitions="72,*">

                            <Border Grid.Column="0"
                                    Background="{DynamicResource CategoryPanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <StackPanel Margin="10,12" Spacing="7">
                                    <Border Width="24" Height="24" CornerRadius="5"
                                            Background="{Binding AccentColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                    <Border Height="6" CornerRadius="3"
                                            Background="{DynamicResource MutedTextBrush}" Opacity="0.4"/>
                                    <Border Height="6" CornerRadius="3"
                                            Background="{DynamicResource MutedTextBrush}" Opacity="0.25"/>
                                    <Border Height="6" CornerRadius="3"
                                            Background="{DynamicResource MutedTextBrush}" Opacity="0.25"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,12" Spacing="10">
                                <TextBlock Text="Sample heading"
                                           FontFamily="{Binding AppFontFamily}"
                                           FontSize="{Binding AppFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="The quick brown fox jumps over the lazy dog."
                                           FontFamily="{Binding AppFontFamily}"
                                           FontSize="{Binding AppFontSize}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                                <!-- Real buttons in this app are liquid-glass (translucent
                                     border + faint tinted fill + sheen), never a flat colour
                                     fill — the "accent" example only gets an accent-tinted
                                     border, matching how the app actually renders buttons. -->
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Border Padding="14,7" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{Binding AccentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#26FFFFFF" Offset="0"/>
                                                <GradientStop Color="#08FFFFFF" Offset="0.55"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="Accent"
                                                   FontFamily="{Binding AppFontFamily}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                    <Button Content="Glass"
                                            Classes="liquid-glass"
                                            FontFamily="{Binding AppFontFamily}"
                                            FontSize="12"
                                            Padding="14,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-3" HorizontalAlignment="Stretch"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <StackPanel Spacing="15">
                <TextBlock Text="Motion &amp; Effects"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <CheckBox Content="Reduce animations"
                          IsChecked="{Binding ReduceAnimations}"
                          ToolTip.Tip="Minimize motion effects for accessibility"/>

                <CheckBox Content="Reduce transparency effects"
                          IsChecked="{Binding ReduceTransparency}"
                          ToolTip.Tip="Use solid colors instead of transparency"/>

                <CheckBox Content="Category rows show only the colour bar"
                          IsChecked="{Binding ShowCategoryColorBarOnly}"
                          ToolTip.Tip="Hide the full row tint and keep only the slim category colour bar on the left."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

