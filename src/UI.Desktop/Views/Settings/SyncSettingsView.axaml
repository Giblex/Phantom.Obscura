<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhantomVault.UI.ViewModels.Settings"
             x:Class="PhantomVault.UI.Views.Settings.SyncSettingsView"
             x:DataType="vm:SyncSettingsViewModel">
    <StackPanel Spacing="20" Margin="0,0,0,60">
        <TextBlock Text="Sync &amp; Integration"
                   FontSize="{StaticResource Type.H3.Size}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <Border Classes="fade-in stagger-1" HorizontalAlignment="Stretch"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <StackPanel Spacing="15">
                <TextBlock Text="Connected Phantom Apps"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Border Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="40" Height="40" CornerRadius="8"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                Padding="6" Margin="0,0,14,0">
                            <TextBlock Text="🔐" FontSize="{StaticResource Type.Icon.Size}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Phantom Attestor (TOTP Authenticator)"
                                       FontWeight="SemiBold" FontSize="{StaticResource Type.Label.Size}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Shares theme and, when enabled below, TOTP codes, passkey metadata, and PhantomKey bridge documents"
                                       FontSize="{StaticResource Type.Tiny.Size}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="12"
                                Background="{DynamicResource SuccessBackgroundBrush}"
                                Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="Connected" FontSize="{StaticResource Type.Tiny.Size}"
                                       Foreground="{DynamicResource SuccessTextBrush}"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-2" HorizontalAlignment="Stretch"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <StackPanel Spacing="15">
                <TextBlock Text="Sync Preferences"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <CheckBox Content="Enable cross-app sync"
                          IsChecked="{Binding SyncEnabled}"
                          ToolTip.Tip="Automatically sync settings between Phantom apps"/>

                <CheckBox Content="Sync theme selection"
                          IsChecked="{Binding SyncTheme}"
                          IsEnabled="{Binding SyncEnabled}"
                          ToolTip.Tip="Share the selected color theme across all Phantom apps"/>

                <CheckBox Content="Sync TOTP codes with Phantom Attestor"
                          IsChecked="{Binding SyncTotp}"
                          IsEnabled="{Binding SyncEnabled}"
                          ToolTip.Tip="Share two-factor (TOTP) secrets with Phantom Attestor through the per-vault sync file on your USB device. This is the only channel that moves secret material — turn it off to keep TOTP seeds inside the vault only."/>
                <TextBlock Text="⚠ Moves TOTP secrets onto the USB sync file so Attestor can read them. Disable to keep seeds vault-only."
                           FontSize="{StaticResource Type.Tiny.Size}"
                           TextWrapping="Wrap"
                           Margin="28,-6,0,0"
                           Foreground="{DynamicResource WarningBrush}"/>

                <CheckBox Content="Share passkey metadata with Phantom Attestor"
                          IsChecked="{Binding SyncPasskeys}"
                          IsEnabled="{Binding SyncEnabled}"
                          ToolTip.Tip="Share non-secret passkey identity (label, relying party, credential id, public key) for cross-app awareness. Private keys stay device-bound and are never exported."/>
                <TextBlock Text="Public identity only — private keys never leave this device."
                           FontSize="{StaticResource Type.Tiny.Size}"
                           TextWrapping="Wrap"
                           Margin="28,-6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <CheckBox Content="Share PhantomKey bridge documents with Phantom Attestor"
                          IsChecked="{Binding SyncPhantomKey}"
                          IsEnabled="{Binding SyncEnabled}"
                          ToolTip.Tip="Share the PhantomKey continuity and policy bridge documents (non-secret) so Attestor can participate as a consumer. Honours the bridge policy and never exports raw key material."/>
                <TextBlock Text="Bridge continuity/policy documents only — no raw key material."
                           FontSize="{StaticResource Type.Tiny.Size}"
                           TextWrapping="Wrap"
                           Margin="28,-6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-3" HorizontalAlignment="Stretch"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">
            <StackPanel Spacing="10">
                <TextBlock Text="Sync Details"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sync file" FontSize="{StaticResource Type.Small.Size}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="%AppData%/PhantomVault/phantom-sync.json" FontSize="{StaticResource Type.Small.Size}"
                               Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Synced items" FontSize="{StaticResource Type.Small.Size}" Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Theme + enabled channels" FontSize="{StaticResource Type.Small.Size}" Margin="0,6,0,0"
                               Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sync direction" FontSize="{StaticResource Type.Small.Size}" Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Bidirectional" FontSize="{StaticResource Type.Small.Size}" Margin="0,6,0,0"
                               Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

