<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhantomVault.UI.Views.Settings.SecuritySettingsView">
    <StackPanel Spacing="{StaticResource Space.Xl}"
                Margin="0,0,0,60">
        <TextBlock Text="Security Settings"
                   FontSize="{StaticResource Type.H3.Size}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>

        <Border Classes="fade-in stagger-1"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Offline mode"
                               FontSize="{StaticResource Type.Body.Size}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="Block all network access. Revokes active grants and refuses new connection requests until turned off."
                               FontSize="{StaticResource Type.Small.Size}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0"
                              IsChecked="{Binding PrivacyModeEnabled, Mode=TwoWay}"
                              ToolTip.Tip="Master offline switch — mirrors the switch at the top of Settings"/>
            </Grid>
        </Border>

        <Border Classes="fade-in stagger-1"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="15">
                <TextBlock Text="Authentication"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <CheckBox Content="Require hardware-token presence check"
                          IsChecked="{Binding RequireHardwareToken, Mode=TwoWay}"
                          ToolTip.Tip="Require the supported hardware-token presence check during unlock on compatible Windows builds"/>

                <StackPanel Spacing="{StaticResource Space.Sm}">
                    <TextBlock Text="Idle timeout (minutes):"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBox Width="100"
                             HorizontalAlignment="Left"
                             Text="{Binding IdleTimeoutMinutes, Mode=TwoWay}"
                             ToolTip.Tip="Lock vault after this many minutes of inactivity"/>
                </StackPanel>

                <Border Background="{DynamicResource SettingsPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="PIN Lock"
                                   FontSize="{StaticResource Type.Label.Size}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock Text="Enable a quick lockscreen PIN for re-authentication without exiting the app."
                                   FontSize="{StaticResource Type.Small.Size}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"/>

                        <CheckBox Content="Enable PIN lock"
                                  IsChecked="{Binding EnablePinLock, Mode=TwoWay}"
                                  IsEnabled="{Binding HasPinConfigured}"
                                  ToolTip.Tip="Set a PIN first — there is nothing to enable until then."/>

                        <CheckBox Content="Use PIN lock for auto-lock (do not dismount)"
                                  IsChecked="{Binding UsePinLockForAutoLock, Mode=TwoWay}"
                                  IsEnabled="{Binding HasPinConfigured}"
                                  IsVisible="{Binding EnablePinLock}"
                                  ToolTip.Tip="If enabled, auto-lock shows the lockscreen without dismounting the vault."/>

                        <TextBlock Text="No PIN is set — auto-lock will not ask for one."
                                   FontSize="{StaticResource Type.Small.Size}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasPinConfigured}"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Set / Change PIN"
                                    Command="{Binding SetOrChangePinCommand}"
                                    Classes="liquid-glass"
                                    Width="170"/>

                            <Button Content="Disable PIN"
                                    Command="{Binding ClearPinCommand}"
                                    Classes="liquid-glass"
                                    Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-2"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Encrypted virtual drive"
                               FontSize="{StaticResource Type.Body.Size}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="6"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsFreeTier}">
                        <TextBlock Text="PREMIUM"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="Mount the vault's encrypted container as a Windows drive. Files are decrypted on the fly — nothing is written to disk in the clear — and the drive disappears when the vault locks. Read-only is safest; writable repacks your changes back into the container when you unmount."
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"/>

                <Border Background="{DynamicResource AccentBrush}"
                        CornerRadius="10"
                        Padding="12,8"
                        IsVisible="{Binding IsDriveMounted}">
                    <TextBlock FontSize="{StaticResource Type.Small.Size}"
                               Foreground="White"
                               TextWrapping="Wrap">
                        <Run Text="Mounted at"/>
                        <Run Text="{Binding MountedDriveLetter}" FontWeight="Bold"/>
                    </TextBlock>
                </Border>

                <TextBlock Text="WinFsp is not installed on this computer. Install it from winfsp.dev to enable mounting."
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !IsMountSupported}"/>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Mount (read-only)"
                            Command="{Binding MountDriveReadOnlyCommand}"
                            Classes="liquid-glass"
                            IsEnabled="{Binding !IsDriveMounted}"
                            Width="160"/>
                    <Button Content="Mount (writable)"
                            Command="{Binding MountDriveWritableCommand}"
                            Classes="liquid-glass"
                            IsEnabled="{Binding !IsDriveMounted}"
                            Width="160"/>
                    <Button Content="Unmount"
                            Command="{Binding UnmountDriveCommand}"
                            Classes="liquid-glass"
                            IsEnabled="{Binding IsDriveMounted}"
                            Width="120"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-2"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="15">
                <TextBlock Text="Clipboard Security"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <CheckBox Content="Clear clipboard after copying passwords"
                          IsChecked="{Binding ClearClipboardAfterCopy, Mode=TwoWay}"
                          ToolTip.Tip="Automatically clear copied secrets after the selected delay"/>

                <StackPanel Spacing="{StaticResource Space.Sm}">
                    <TextBlock Text="Clipboard clear delay:"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ComboBox Width="180"
                              HorizontalAlignment="Left"
                              SelectedIndex="{Binding ClipboardClearTimeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="30 seconds"/>
                        <ComboBoxItem Content="1 minute"/>
                        <ComboBoxItem Content="2 minutes"/>
                        <ComboBoxItem Content="5 minutes"/>
                        <ComboBoxItem Content="Never"/>
                    </ComboBox>
                </StackPanel>

                <CheckBox Content="Auto-copy TOTP code with password"
                          IsChecked="{Binding AutoCopyTotpWithPassword, Mode=TwoWay}"
                          ToolTip.Tip="When copying passwords, automatically include the current TOTP code in the clipboard"/>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-3"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="15">
                <TextBlock Text="Screenshot Protection"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <CheckBox Content="Enable screenshot protection"
                          IsChecked="{Binding EnableScreenshotProtection, Mode=TwoWay}"
                          ToolTip.Tip="When enabled, the vault window appears black in screenshots and screen recordings"/>

                <TextBlock Text="This security feature prevents credential exposure through screenshots, screen recordings, and screen sharing. When enabled, the vault window will be hidden from screen capture tools."
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-4"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="15">
                <TextBlock Text="Decoy Vault Protection"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="When enabled, PhantomVault will show fake credentials to attackers during security incidents, protecting your real data"
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"/>

                <CheckBox Content="Enable decoy vault activation"
                          IsChecked="{Binding EnableDecoyVault, Mode=TwoWay}"
                          ToolTip.Tip="Automatically switch to fake credentials when threats are detected"/>

                <StackPanel Spacing="{StaticResource Space.Sm}"
                            IsEnabled="{Binding EnableDecoyVault}">
                    <TextBlock Text="Number of fake credentials to generate:"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Width="100"
                                 HorizontalAlignment="Left"
                                 Text="{Binding DecoyCredentialCount, Mode=TwoWay}"
                                 ToolTip.Tip="Between 15-30 credentials recommended for realism"/>
                        <TextBlock Text="(15-30 recommended)"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <CheckBox Content="Enable read-only mode when decoy is active"
                          IsChecked="{Binding DecoyReadOnlyMode, Mode=TwoWay}"
                          IsEnabled="{Binding EnableDecoyVault}"
                          ToolTip.Tip="Prevents attackers from modifying fake credentials"/>

                <CheckBox Content="Log decoy vault activations"
                          IsChecked="{Binding DecoyLogActivations, Mode=TwoWay}"
                          IsEnabled="{Binding EnableDecoyVault}"
                          ToolTip.Tip="Record security events for forensic analysis"/>

                <Border Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource Brush.Accent}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Md}"
                        Padding="12"
                        Margin="0,5,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="How Decoy Vault Works"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="{StaticResource Type.Small.Size}"
                                   Foreground="{DynamicResource MutedTextBrush}">
                            When a security threat is detected (debugger, memory scanning, multiple failed authentications),
                            the vault automatically switches to showing realistic fake credentials. Attackers believe they succeeded,
                            while your real data remains protected. All activations are logged for security auditing.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-5"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="15">
                <TextBlock Text="Master Password"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <Button Content="Set / Change Master Password"
                        Width="240"
                        HorizontalAlignment="Left"
                        Classes="liquid-glass"
                        Command="{Binding ChangeMasterPasswordCommand}"
                        ToolTip.Tip="Set a master password if you don't have one yet, or change your existing one. Password is optional — keyfile is mandatory."/>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-5"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="15">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Data="{StaticResource Icon.Key}" Width="20" Height="20" Stretch="Uniform"
                          Stroke="#FFFFFFFF" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                          Fill="Transparent" VerticalAlignment="Center"/>
                    <TextBlock Text="Keyfile"
                               FontSize="{StaticResource Type.Body.Size}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Your keyfile is mandatory — it is required (together with your password, if set) to unlock the vault. Keep a backup somewhere safe and separate from the vault."
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"/>

                <Border Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Md}"
                        Padding="12,10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Current keyfile"
                                   FontSize="{StaticResource Type.Tiny.Size}"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding CurrentKeyfileDisplay}"
                                   FontSize="{StaticResource Type.Small.Size}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <WrapPanel Orientation="Horizontal">
                    <Button Content="Backup Keyfile"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Classes="liquid-glass"
                            Command="{Binding BackupKeyfileCommand}"
                            ToolTip.Tip="Save a copy of your current keyfile to a safe location"/>
                    <Button Content="Regenerate Keyfile"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Classes="liquid-glass"
                            Command="{Binding RegenerateKeyfileCommand}"
                            ToolTip.Tip="Generate a brand-new keyfile and re-encrypt the vault (password unchanged)"/>
                    <Button Content="Change to Existing Keyfile…"
                            Margin="0,0,10,10"
                            Padding="14,8"
                            Classes="liquid-glass"
                            Command="{Binding ChangeKeyfileCommand}"
                            ToolTip.Tip="Re-encrypt the vault using a keyfile you select"/>
                </WrapPanel>

                <TextBlock Text="⚠ Regenerating or changing the keyfile re-encrypts your vault. Make a backup of the new keyfile immediately afterwards."
                           FontSize="{StaticResource Type.Tiny.Size}"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-5"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock Text="Fast Unlock"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Reduces the Argon2id parameters used to derive the manifest decryption key from 256 MiB / 6 iterations down to 64 MiB / 3 iterations. Unlock is noticeably faster; offline brute-force resistance is weaker. The mandatory USB keyfile still applies."
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"/>

                <CheckBox Content="Use Fast Unlock for this vault"
                          IsChecked="{Binding UseFastUnlock, Mode=TwoWay}"
                          ToolTip.Tip="Persists your preference. Apply changes to the vault using the button below."/>

                <Border Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Md}"
                        Padding="12,10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Current manifest tier"
                                   FontSize="{StaticResource Type.Tiny.Size}"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding CurrentManifestKdfDisplay}"
                                   FontSize="{StaticResource Type.Small.Size}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Button Content="Apply to this vault now"
                        Padding="14,8"
                        Classes="liquid-glass"
                        IsEnabled="{Binding FastUnlockNeedsReKey}"
                        Command="{Binding ApplyFastUnlockReKeyCommand}"
                        ToolTip.Tip="Re-encrypt the manifest under the selected tier. Only the manifest is touched — your credentials and vault database are not re-encrypted."/>

                <TextBlock Text="The vault database itself is always encrypted at the higher Standard tier — this toggle only changes manifest decryption, so applying it never re-encrypts your credentials."
                           FontSize="{StaticResource Type.Tiny.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Classes="fade-in stagger-6"
                Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20"
                HorizontalAlignment="Stretch">
            <StackPanel Spacing="15">
                <TextBlock Text="Multi-Factor Authentication"
                           FontSize="{StaticResource Type.Body.Size}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>

                <TextBlock Text="Review the security factors that are currently available for this vault and this device"
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">

                    <Button Grid.Row="0" Grid.Column="0"
                            Click="OpenTotpSettings_Click"
                            Classes="liquid-glass"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,6,12"
                            Height="50"
                            ToolTip.Tip="Set up time-based one-time password (Google Authenticator, Authy, etc.)">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource Icon.QrCode}" Width="22" Height="22" Stretch="Uniform"
                                  Stroke="#FFFFFFFF" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="TOTP Setup" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="0" Grid.Column="1"
                            Click="OpenPasskeySettings_Click"
                            Classes="liquid-glass"
                            HorizontalAlignment="Stretch"
                            Margin="6,0,0,12"
                            Height="50"
                            ToolTip.Tip="Configure the Windows Hello-backed device authenticator for this vault">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource Icon.Key}" Width="22" Height="22" Stretch="Uniform"
                                  Stroke="#FFFFFFFF" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Device Authenticator" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="0"
                            Click="OpenWindowsHelloSettings_Click"
                            Classes="liquid-glass"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,6,0"
                            Height="50"
                            ToolTip.Tip="Review Windows Hello availability for face, fingerprint, or PIN-backed unlock">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource Icon.Eye}" Width="22" Height="22" Stretch="Uniform"
                                  Stroke="#FFFFFFFF" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Windows Hello" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="1" Grid.Column="1"
                            Click="OpenBackupCodes_Click"
                            Classes="liquid-glass"
                            HorizontalAlignment="Stretch"
                            Margin="6,0,0,0"
                            Height="50"
                            ToolTip.Tip="Generate emergency backup codes for account recovery">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="{StaticResource Icon.Clipboard}" Width="22" Height="22" Stretch="Uniform"
                                  Stroke="#FFFFFFFF" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Backup Codes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

