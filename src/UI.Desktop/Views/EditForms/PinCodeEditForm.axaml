<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PhantomVault.UI.Views.Controls"
             xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls"
             x:Class="PhantomVault.UI.Views.EditForms.PinCodeEditForm">

    <Border x:Name="PinCodePanelBorder" Background="Transparent" IsVisible="{Binding IsPinCodeEntry}">
        <StackPanel x:Name="PinCodePanel" Spacing="12">

            <TextBlock Text="PIN Code" Classes="form-section-title"/>

            <dcontrols:FieldRow Spacing="12">
                <StackPanel Classes="field-group">
                    <TextBlock Text="Label" Classes="field-label"/>
                    <TextBox Text="{Binding PinLabel}" Classes="form-field" Watermark="Bank PIN"/>
                </StackPanel>
                <StackPanel Classes="field-group">
                    <TextBlock Text="Category" Classes="field-label"/>
                    <TextBox Text="{Binding PinCategory}" Classes="form-field" Watermark="Banking"/>
                </StackPanel>
            </dcontrols:FieldRow>

            <StackPanel Classes="field-group">
                <TextBlock Text="PIN" Classes="field-label"/>
                <controls:PinDigitBoxes Pin="{Binding PinValue, Mode=TwoWay}"
                                        PinLength="{Binding PinLength, Mode=TwoWay}"
                                        ShowLengthSelector="True"/>
            </StackPanel>

            <StackPanel Classes="field-group">
                <TextBlock Text="Issuer" Classes="field-label"/>
                <TextBox Text="{Binding PinIssuer}" Classes="form-field" Watermark="Chase Bank"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
