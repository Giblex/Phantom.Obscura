<?xml version="1.0" encoding="utf-8"?>
<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhantomVault.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PhantomVault.UI.Views"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="PhantomVault.UI.Views.KeyboardShortcutsWindow"
        Title="Keyboard Shortcuts"
        Width="900" Height="700"
        MinWidth="750" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Classes="animated-window">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="30,20">
            <StackPanel Spacing="8">
                <TextBlock Text="⌨️ Keyboard Shortcuts"
                           FontSize="{StaticResource Type.H2.Size}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="View and customize keyboard shortcuts for quick access"
                           FontSize="{StaticResource Type.Label.Size}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Padding="30,20">
                <StackPanel Spacing="20">

                    <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="General Actions"
                                       FontSize="{StaticResource Type.H4.Size}"
                                       FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="*,Auto,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,10,0,0">

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Lock Vault" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="0"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}">
                                    <TextBlock Text="Ctrl+L" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Search Credentials" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Ctrl+F" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="2" Text="New Credential" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="2"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Ctrl+N" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="3" Text="Open Settings" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="3" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="3"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Ctrl+," FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="4" Text="Refresh Vault" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="4" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="4"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="F5" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Credential Actions"
                                       FontSize="{StaticResource Type.H4.Size}"
                                       FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="*,Auto,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,10,0,0">

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Copy Username" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="0"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}">
                                    <TextBlock Text="Ctrl+C" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Copy Password" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Ctrl+Shift+C" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Edit Selected Entry" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="2"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Ctrl+E" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="3" Text="Delete Selected Entry" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="3" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="3"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Delete" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="4" Text="Toggle Favorite" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="4" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="4"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Ctrl+D" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Navigation"
                                       FontSize="{StaticResource Type.H4.Size}"
                                       FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="*,Auto,120" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,10,0,0">

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Next Entry" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="0"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}">
                                    <TextBlock Text="↓ / Tab" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Previous Entry" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="↑ / Shift+Tab" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Jump to Search Box" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="2"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="/" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="3" Text="Close Window/Dialog" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="3" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="3"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Esc" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="20"
                            Background="{DynamicResource CardBackgroundBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="View Options"
                                       FontSize="{StaticResource Type.H4.Size}"
                                       FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="*,Auto,120" RowDefinitions="Auto,Auto,Auto" Margin="0,10,0,0">

                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Toggle List/Grid View" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="0"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}">
                                    <TextBlock Text="Ctrl+G" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="1" Text="Show Favorites Only" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="1"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Ctrl+Shift+F" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="0" Grid.Row="2" Text="Toggle Dark/Light Theme" FontSize="{StaticResource Type.Label.Size}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="2" Text="→" FontSize="{StaticResource Type.Label.Size}" Margin="10,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Grid.Row="2"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        Padding="8,4"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="Ctrl+T" FontSize="{StaticResource Type.Small.Size}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource InfoBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="15"
                            Background="{DynamicResource InfoBackgroundBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="💡 Tip" FontSize="{StaticResource Type.Body.Size}" FontWeight="SemiBold"/>
                            <TextBlock Text="Keyboard shortcuts can be customized in a future update. These are the default shortcuts for quick access to common features."
                                       FontSize="{StaticResource Type.Small.Size}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="30,15">
            <Button Content="Close"
                    Width="120"
                    Height="36"
                    HorizontalAlignment="Center"
                    Click="Close_Click"/>
        </Border>
    </Grid>
</views:ThemeAwareWindow>

