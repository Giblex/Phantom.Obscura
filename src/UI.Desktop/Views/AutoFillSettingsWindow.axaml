<?xml version="1.0" encoding="utf-8"?>
<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:PhantomVault.UI.Views"
    x:Class="PhantomVault.UI.Views.AutoFillSettingsWindow"
        Title="Auto‑Fill Settings" Width="400" Height="300"
        Classes="animated-window">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Padding="15,15,15,40">
        <StackPanel Spacing="10">
            <CheckBox Content="Enable auto‑fill" IsChecked="{Binding EnableAutoFill, Mode=TwoWay}" />
            <StackPanel Orientation="Vertical" Margin="0,5,0,0">
                <CheckBox Content="Automatically fill username" IsChecked="{Binding InjectUsername, Mode=TwoWay}" />
                <CheckBox Content="Automatically fill password" IsChecked="{Binding InjectPassword, Mode=TwoWay}" />
            </StackPanel>
            <CheckBox Content="Start auto‑fill in the tray when a vault is opened"
                      IsChecked="{Binding StartInTrayOnVaultOpen, Mode=TwoWay}"
                      Margin="0,5,0,0" />

            <TextBlock Text="When the vault's USB is inserted, require:" Margin="0,8,0,0" />
            <ComboBox ItemsSource="{Binding UsbStartupFactorOptions}"
                      SelectedItem="{Binding UsbStartupFactor, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="Automatic uses the strongest factor the vault actually has. A vault with no PIN, passphrase or Windows Hello opens on its keyfile alone. This choice can never require less than the vault is protected by."
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       FontSize="11"
                       Margin="0,2,0,0" />

            <TextBlock Text="Domain whitelist (comma separated):" Margin="0,5,0,0" />
            <TextBox Text="{Binding DomainWhitelist, Mode=TwoWay}" Height="60" AcceptsReturn="True" />
            <Button Content="Save" Command="{Binding SaveCommand}" Width="80" HorizontalAlignment="Left" />
        </StackPanel>
    </Border>
    </ScrollViewer>
</views:ThemeAwareWindow>

