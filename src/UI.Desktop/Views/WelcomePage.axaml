<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhantomVault.UI.ViewModels"
        xmlns:views="clr-namespace:PhantomVault.UI.Views"
        xmlns:models="using:PhantomVault.UI.Models"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PhantomVault.UI.Views.WelcomePage"
        x:DataType="vm:WelcomePageViewModel"
        Title="Welcome to Phantom Obscura"
        Width="800" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Icon="avares://PhantomVault.UI/Assets/Visuals/Giblex Icons/Parent Icon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Classes="animated-window">

    <views:ThemeAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Assets/Themes/PreVaultTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </views:ThemeAwareWindow.Resources>

    <views:ThemeAwareWindow.Styles>
        <Style Selector="Border.usb-pulse-ring">
            <Setter Property="Opacity" Value="0.28"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:1.8"/>
                </Transitions>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:2.8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.42"/>
                        <Setter Property="Width" Value="42"/>
                        <Setter Property="Height" Value="42"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Width" Value="86"/>
                        <Setter Property="Height" Value="86"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.usb-pulse-ring.delayed">
            <Style.Animations>
                <Animation Duration="0:0:2.8" Delay="0:0:1.4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.26"/>
                        <Setter Property="Width" Value="42"/>
                        <Setter Property="Height" Value="42"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="Width" Value="86"/>
                        <Setter Property="Height" Value="86"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.vault-choice">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.trace-segment">
            <Setter Property="Background" Value="#6A88BC"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- Entrance animation for a vault slot when it transitions from
             empty → filled. Simple opacity fade — runs whenever the filled
             Button becomes visible. -->
        <Style Selector="Button.slot-fill">
            <Style.Animations>
                <Animation Duration="0:0:0.5" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </views:ThemeAwareWindow.Styles>

    <Design.DataContext>
        <vm:WelcomePageViewModel/>
    </Design.DataContext>

        <Grid RowDefinitions="Auto,*,Auto"
            Margin="0"
            Background="{DynamicResource WindowBackgroundBrush}">

        <!-- Sporadic teal gradient wash: smaller, dimmer, more scattered blobs
             so the navy stays dominant with occasional teal accents peeking through.
             IsHitTestVisible=False so it never interferes with input. -->
        <Panel Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="260" Height="260" Margin="-60,-40,0,0">
                <Border.Background>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#2A2DD4BF" Offset="0"/>
                        <GradientStop Color="#002DD4BF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="200" Height="200" Margin="0,120,80,0">
                <Border.Background>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#2214B8A6" Offset="0"/>
                        <GradientStop Color="#0014B8A6" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                    Width="220" Height="220" Margin="40,60,0,0">
                <Border.Background>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#1E0D9488" Offset="0"/>
                        <GradientStop Color="#000D9488" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="240" Height="240" Margin="0,0,-40,-60">
                <Border.Background>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#2806B6D4" Offset="0"/>
                        <GradientStop Color="#0006B6D4" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Width="180" Height="180" Margin="120,0,0,80">
                <Border.Background>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#22115E59" Offset="0"/>
                        <GradientStop Color="#00115E59" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="160" Height="160" Margin="220,220,0,0">
                <Border.Background>
                    <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Color="#1A5EEAD4" Offset="0"/>
                        <GradientStop Color="#005EEAD4" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- Dot-grid overlay matching giblex.com body::after —
                 8×8 tile, 1px white dot, ~4% opacity. -->
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Background>
                    <ImageBrush Source="avares://PhantomVault.UI/Assets/dot_pattern.png"
                                TileMode="Tile"
                                Stretch="None"
                                SourceRect="0,0,8,8"
                                DestinationRect="0,0,8,8"/>
                </Border.Background>
            </Border>
        </Panel>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="14,6">
            <TextBlock Text="{Binding WelcomeMessage}"
                       FontSize="{StaticResource Type.Body.Size}"
                       Foreground="{DynamicResource HeaderTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="1"
                      Background="Transparent"
                      Padding="20,20,20,28"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Top" MinHeight="300" Margin="0,4,0,112">

                <Border Classes="liquid-glass-tile"
                        CornerRadius="16"
                        ClipToBounds="True"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="760" MaxWidth="760" MinHeight="280" MaxHeight="380" Padding="20,18">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.6"/>
                        </Transitions>
                    </Border.Transitions>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <!-- Logo — no tile backdrop, drop shadow gives it depth on its own. -->
                            <Image Source="avares://PhantomVault.UI/Assets/ok.png"
                                   Stretch="Uniform" Height="240"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="24" OffsetX="0" OffsetY="8"
                                                      Color="#000000" Opacity="0.85"/>
                                </Image.Effect>
                            </Image>
                            <TextBlock Text="Phantom Obscura"
                                       FontSize="40" FontFamily="{DynamicResource TitleFontFamily}" FontWeight="Normal"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                </Border>

                <TextBlock Text="{Binding AppVersion}"
                           FontSize="{StaticResource Type.Tiny.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

                <!-- Status pill — clean acrylic build, same recipe as logo tile / slot window. -->
                <Border x:Name="DetectionStatusCard"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Margin="0,10,0,0"
                        MinWidth="260" Height="56"
                        CornerRadius="28"
                        Padding="24,0"
                        BorderBrush="{DynamicResource Brush.Glass.Border}"
                        BorderThickness="1"
                        BoxShadow="inset 0 1 0 0 #40FFFFFF, 0 6 20 0 #40000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#55D9E9EB" Offset="0"/>
                            <GradientStop Color="#55214247" Offset="0.35"/>
                            <GradientStop Color="#55214247" Offset="0.65"/>
                            <GradientStop Color="#55193A42" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="72" Height="4"
                                     Foreground="{DynamicResource AccentBrush}"
                                     IsVisible="{Binding IsDeviceDetectionActive}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="{StaticResource Type.Label.Size}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="Normal"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <Border x:Name="DetectedVaultCard"
                        BorderBrush="{DynamicResource Brush.Glass.Border}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="18,16"
                        MaxWidth="760"
                        Width="760"
                        IsVisible="{Binding IsLandingVisible}"
                        BoxShadow="0 8 24 0 #40000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#551B2846" Offset="0"/>
                            <GradientStop Color="#55214247" Offset="0.5"/>
                            <GradientStop Color="#55193A42" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <!-- Vault picker — single acrylic "window" containing three
                             stacked slot rows (not three separate bubbles). Each row is
                             either a "vault loaded" row (Button) or an empty placeholder,
                             with a hairline divider between rows. -->
                        <StackPanel x:Name="VaultListAnchor"
                                    Spacing="8"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Vault slots (up to 3)"
                                       FontSize="{StaticResource Type.Label.Size}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <Border Background="#33091724"
                                    BorderBrush="{DynamicResource Brush.Glass.Border}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="0"
                                    Width="600"
                                    HorizontalAlignment="Center">
                                <StackPanel Spacing="0">
                                    <!-- Slot 1 -->
                                    <Grid Height="56">
                                        <Border Padding="16,10"
                                                Background="#22B0C4D8"
                                                BoxShadow="inset 0 2 6 0 #60000000, inset 0 -1 0 0 #30FFFFFF"
                                                IsVisible="{Binding !Slot1HasVault}">
                                            <Grid ColumnDefinitions="52,1,14,*" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="Slot 1"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{StaticResource Type.Tiny.Size}"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Glass.Border}" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" Text="Empty — insert a USB to load"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{StaticResource Type.Body.Size}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Button Classes="vault-choice slot-fill"
                                                Click="DetectedVaultChoice_Click"
                                                Tag="{Binding Slot1}"
                                                IsVisible="{Binding Slot1HasVault}"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch">
                                            <Border Padding="16,10"
                                                    Background="#55050C18"
                                                    BoxShadow="inset 0 2 6 0 #80000000, inset 0 -1 0 0 #40FFFFFF">
                                                <Grid ColumnDefinitions="52,1,14,*" VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0" Text="Slot 1"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="{StaticResource Type.Tiny.Size}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Glass.Border}" Margin="0,2"/>
                                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Slot1.DisplayName}"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontSize="{StaticResource Type.Body.Size}"/>
                                                        <TextBlock Text="{Binding Slot1.VaultPath}"
                                                                   FontSize="{StaticResource Type.Tiny.Size}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </Grid>
                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource Brush.Glass.Border}" Margin="12,0"/>
                                    <!-- Slot 2 -->
                                    <Grid Height="56">
                                        <Border Padding="16,10"
                                                Background="#22B0C4D8"
                                                BoxShadow="inset 0 2 6 0 #60000000, inset 0 -1 0 0 #30FFFFFF"
                                                IsVisible="{Binding !Slot2HasVault}">
                                            <Grid ColumnDefinitions="52,1,14,*" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="Slot 2"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{StaticResource Type.Tiny.Size}"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Glass.Border}" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" Text="Empty — insert a USB to load"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{StaticResource Type.Body.Size}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Button Classes="vault-choice slot-fill"
                                                Click="DetectedVaultChoice_Click"
                                                Tag="{Binding Slot2}"
                                                IsVisible="{Binding Slot2HasVault}"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch">
                                            <Border Padding="16,10"
                                                    Background="#55050C18"
                                                    BoxShadow="inset 0 2 6 0 #80000000, inset 0 -1 0 0 #40FFFFFF">
                                                <Grid ColumnDefinitions="52,1,14,*" VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0" Text="Slot 2"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="{StaticResource Type.Tiny.Size}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Glass.Border}" Margin="0,2"/>
                                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Slot2.DisplayName}"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontSize="{StaticResource Type.Body.Size}"/>
                                                        <TextBlock Text="{Binding Slot2.VaultPath}"
                                                                   FontSize="{StaticResource Type.Tiny.Size}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </Grid>
                                    <!-- Divider -->
                                    <Border Height="1" Background="{DynamicResource Brush.Glass.Border}" Margin="12,0"/>
                                    <!-- Slot 3 -->
                                    <Grid Height="56">
                                        <Border Padding="16,10"
                                                Background="#22B0C4D8"
                                                BoxShadow="inset 0 2 6 0 #60000000, inset 0 -1 0 0 #30FFFFFF"
                                                IsVisible="{Binding !Slot3HasVault}">
                                            <Grid ColumnDefinitions="52,1,14,*" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="Slot 3"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{StaticResource Type.Tiny.Size}"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Glass.Border}" Margin="0,2"/>
                                                <TextBlock Grid.Column="3" Text="Empty — insert a USB to load"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{StaticResource Type.Body.Size}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Button Classes="vault-choice slot-fill"
                                                Click="DetectedVaultChoice_Click"
                                                Tag="{Binding Slot3}"
                                                IsVisible="{Binding Slot3HasVault}"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch">
                                            <Border Padding="16,10"
                                                    Background="#55050C18"
                                                    BoxShadow="inset 0 2 6 0 #80000000, inset 0 -1 0 0 #40FFFFFF">
                                                <Grid ColumnDefinitions="52,1,14,*" VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0" Text="Slot 3"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="{StaticResource Type.Tiny.Size}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Width="1" Background="{DynamicResource Brush.Glass.Border}" Margin="0,2"/>
                                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Slot3.DisplayName}"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontSize="{StaticResource Type.Body.Size}"/>
                                                        <TextBlock Text="{Binding Slot3.VaultPath}"
                                                                   FontSize="{StaticResource Type.Tiny.Size}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dev Bypass — sits at the far left, below the vault-slot list. -->
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding IsDeveloperBypassVisible}"
                            Margin="12,4,0,10">
                    <Button Command="{Binding DeveloperBypassCommand}"
                            Classes="liquid-glass"
                            CornerRadius="10"
                            Height="34"
                            Width="140"
                            FontSize="{StaticResource Type.Label.Size}"
                            FontFamily="{DynamicResource MainFontFamily}"
                            ToolTip.Tip="Bypass normal unlock flow (debug only)">
                        <TextBlock Text="Dev Bypass" Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <Canvas x:Name="DetectionTraceCanvas"
                        Height="140"
                        Width="760"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center"
                        IsVisible="False">
                    <Border x:Name="DetectionTraceLine"
                            Background="#6A88BC"
                            Width="3"
                            Height="0"
                            CornerRadius="2"
                            HorizontalAlignment="Center"/>
                    <Border x:Name="TraceTopEdge"
                            Classes="trace-segment"
                            Width="0"
                            Height="3"
                            CornerRadius="2"/>
                    <Border x:Name="TraceLeftEdge"
                            Classes="trace-segment"
                            Width="3"
                            Height="0"
                            CornerRadius="2"/>
                    <Border x:Name="TraceBottomEdge"
                            Classes="trace-segment"
                            Width="0"
                            Height="3"
                            CornerRadius="2"/>
                    <Border x:Name="TraceRightEdge"
                            Classes="trace-segment"
                            Width="3"
                            Height="0"
                            CornerRadius="2"/>
                </Canvas>

                <Border x:Name="SetupChoiceCard"
                        BorderBrush="{DynamicResource Brush.Glass.Border}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="24,22"
                        MaxWidth="760"
                        Width="760"
                        IsVisible="{Binding IsSetupChoiceVisible}"
                        BoxShadow="0 8 24 0 #40000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#551B2846" Offset="0"/>
                            <GradientStop Color="#55214247" Offset="0.5"/>
                            <GradientStop Color="#55193A42" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Choose Your Setup Path"
                                       FontSize="{StaticResource Type.H3.Size}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Pick the simple path if you want Obscura to make the hard decisions for you, or open the advanced path if you want full control over every lock and latch."
                                       FontSize="{StaticResource Type.Small.Size}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Grid.Column="0"
                                    BorderBrush="{DynamicResource Brush.Glass.Border}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18,16"
                                    BoxShadow="0 6 20 0 #40000000, inset 0 1 0 0 #40FFFFFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#551B2846" Offset="0"/>
                                        <GradientStop Color="#55214247" Offset="0.5"/>
                                        <GradientStop Color="#55193A42" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Default Setup"
                                               FontSize="{StaticResource Type.H4.Size}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Fast, safe, no decisions."
                                               FontSize="{StaticResource Type.Small.Size}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="• Pick a vault name and how you sign in"
                                                   FontSize="{StaticResource Type.Small.Size}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Strong defaults picked for you"
                                                   FontSize="{StaticResource Type.Small.Size}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Bound to your USB, cleans up after itself"
                                                   FontSize="{StaticResource Type.Small.Size}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Ready in under a minute"
                                                   FontSize="{StaticResource Type.Small.Size}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Command="{Binding ShowDefaultSetupCommand}"
                                            Classes="liquid-glass"
                                            Height="42"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="Use Default Setup"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    BorderBrush="{DynamicResource Brush.Glass.Border}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18,16"
                                    BoxShadow="0 6 20 0 #40000000, inset 0 1 0 0 #40FFFFFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#551B2846" Offset="0"/>
                                        <GradientStop Color="#55214247" Offset="0.5"/>
                                        <GradientStop Color="#55193A42" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Advanced Setup"
                                               FontSize="{StaticResource Type.H4.Size}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Full control, every setting yours."
                                               FontSize="{StaticResource Type.Small.Size}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="• Choose your security tier"
                                                   FontSize="{StaticResource Type.Small.Size}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Control keyfile and USB binding"
                                                   FontSize="{StaticResource Type.Small.Size}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Pick storage layout and container size"
                                                   FontSize="{StaticResource Type.Small.Size}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="• Full wizard, step by step"
                                                   FontSize="{StaticResource Type.Small.Size}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Command="{Binding ShowAdvancedSetupCommand}"
                                            Classes="liquid-glass"
                                            Height="42"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="Use Advanced Setup"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom fade — content dissolves into window background -->
        <Border Grid.Row="1"
                VerticalAlignment="Bottom"
                Height="80"
                IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#000B1422" Offset="0"/>
                    <GradientStop Color="#FF0B1422" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>


        <!-- Top-of-bottom-banner separator: full-width hairline above the buttons. -->
        <Border Grid.Row="2"
                Height="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource Brush.Glass.Border}"/>

        <Border x:Name="ActionFooterCard"
                Grid.Row="2"
                Background="Transparent"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="760"
                CornerRadius="0"
                Margin="18,10,18,10"
                BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding GetStartedCommand}" Classes="liquid-glass" CornerRadius="10" Height="40" Width="140" FontSize="{StaticResource Type.Body.Size}" FontWeight="Normal" FontFamily="{DynamicResource MainFontFamily}" IsVisible="{Binding IsLandingVisible}">
                    <TextBlock Text="Get Started" Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Button Command="{Binding OpenExistingVaultCommand}" Classes="liquid-glass" CornerRadius="10" Height="40" Width="140" FontSize="{StaticResource Type.Body.Size}" FontFamily="{DynamicResource MainFontFamily}" IsVisible="{Binding IsLandingVisible}" IsEnabled="{Binding HasSelectedVault}">
                    <TextBlock Text="{Binding OpenVaultButtonText}" Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <Button Click="About_Click" Classes="liquid-glass" CornerRadius="10" Height="40" Width="140" FontFamily="{DynamicResource MainFontFamily}" FontSize="{StaticResource Type.Body.Size}" ToolTip.Tip="About this app" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="{Binding IsLandingVisible}">
                    <TextBlock Text="About" Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Click="Import_Click" Classes="liquid-glass" CornerRadius="10" Height="40" Width="140" FontFamily="{DynamicResource MainFontFamily}" FontSize="{StaticResource Type.Body.Size}" ToolTip.Tip="Import data" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="{Binding IsLandingVisible}">
                    <TextBlock Text="Import" Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Click="Recover_Click" Classes="liquid-glass" CornerRadius="10" Height="40" Width="140" FontFamily="{DynamicResource MainFontFamily}" FontSize="{StaticResource Type.Body.Size}" ToolTip.Tip="Recover your keyfile from a recovery file and code" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsVisible="{Binding IsLandingVisible}">
                    <TextBlock Text="Recover" Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding BackToWelcomeCommand}" Classes="liquid-glass" CornerRadius="10" Height="40" Width="140" FontFamily="{DynamicResource MainFontFamily}" FontSize="{StaticResource Type.Body.Size}" IsVisible="{Binding IsSetupChoiceVisible}">
                    <TextBlock Text="Back" Foreground="{DynamicResource ButtonTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</views:ThemeAwareWindow>

