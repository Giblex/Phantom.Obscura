<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PhantomVault.UI.Converters"
             xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls"
             x:Class="PhantomVault.UI.Views.Details.ContactDetailView">

    <!-- Every value is a CopyableField: click to copy, never editable (editing is via Edit). -->
    <StackPanel Spacing="12"
                IsVisible="{Binding SelectedCredential.IsContactEntry}">
        <TextBlock Text="Contact Details"
                   FontSize="{StaticResource Type.Body.Size}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <dcontrols:FieldRow Spacing="12">
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasContactName}">
                <TextBlock Text="Full Name" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.ContactFullName}" CopyLabel="Full name"/>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasContactPhone}">
                <TextBlock Text="Phone" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.ContactPhone}" CopyLabel="Phone"/>
            </StackPanel>
        </dcontrols:FieldRow>

        <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasContactEmail}">
            <TextBlock Text="Email" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
            <dcontrols:CopyableField Value="{Binding SelectedCredential.ContactEmail}" CopyLabel="Email"/>
        </StackPanel>

        <dcontrols:FieldRow Spacing="12">
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasContactCompany}">
                <TextBlock Text="Company" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.ContactCompany}" CopyLabel="Company"/>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasContactJobTitle}">
                <TextBlock Text="Job Title" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.ContactJobTitle}" CopyLabel="Job title"/>
            </StackPanel>
        </dcontrols:FieldRow>

        <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasContactAddress}">
            <TextBlock Text="Address" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
            <dcontrols:CopyableField Value="{Binding SelectedCredential.ContactAddress}" CopyLabel="Address" IsMultiline="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
