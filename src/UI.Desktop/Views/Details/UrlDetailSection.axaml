<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PhantomVault.UI.Converters"
             xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls"
             x:Class="PhantomVault.UI.Views.Details.UrlDetailSection">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Resources/Converters/ConverterResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasUrl}">
        <TextBlock Text="Website"
                   FontSize="{StaticResource Type.Label.Size}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedTextBrush}"/>
        <Grid ColumnDefinitions="*,Auto">
            <dcontrols:CopyableField Grid.Column="0"
                                     Value="{Binding SelectedCredential.Url}"
                                     CopyLabel="Website">
                <dcontrols:CopyableField.Effect>
                    <Binding Path="PrivacyModeEnabled" Converter="{StaticResource PrivacyBlurEffectConverter}"/>
                </dcontrols:CopyableField.Effect>
            </dcontrols:CopyableField>
            <Button AutomationProperties.Name="Open in browser" Grid.Column="1"
                    Command="{Binding OpenUrlCommand}"
                    CommandParameter="{Binding SelectedCredential}"
                    Classes="liquid-glass"
                    Width="30"
                    Height="30"
                    MinWidth="0"
                    MinHeight="0"
                    CornerRadius="6"
                    Padding="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Open in browser">
                <TextBlock Text="🌐" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
