<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PhantomVault.UI.Converters"
             xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls"
             x:Class="PhantomVault.UI.Views.Details.NotesDetailSection">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Resources/Converters/ConverterResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasNotes}">
        <TextBlock Text="Notes"
                   FontSize="{StaticResource Type.Label.Size}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedTextBrush}"/>
        <dcontrols:CopyableField Value="{Binding SelectedCredential.Notes}"
                                 CopyLabel="Notes"
                                 IsMultiline="True"
                                 MinHeight="70">
            <dcontrols:CopyableField.Effect>
                <Binding Path="PrivacyModeEnabled" Converter="{StaticResource PrivacyBlurEffectConverter}"/>
            </dcontrols:CopyableField.Effect>
        </dcontrols:CopyableField>
    </StackPanel>
</UserControl>
