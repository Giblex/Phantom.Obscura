<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PhantomVault.UI.Converters"
             xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls"
             x:Class="PhantomVault.UI.Views.Details.ApiKeyDetailView">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Resources/Converters/ConverterResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Spacing="12"
                IsVisible="{Binding SelectedCredential.IsApiKeyEntry}">
        <TextBlock Text="API Access"
                   FontSize="{StaticResource Type.Body.Size}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <dcontrols:FieldRow Spacing="12">
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasApiKeyType}">
                <TextBlock Text="Key Type" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.ApiKeyType}" CopyLabel="Key type"/>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasApiEnvironment}">
                <TextBlock Text="Environment" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.ApiEnvironment}" CopyLabel="Environment"/>
            </StackPanel>
        </dcontrols:FieldRow>

        <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasApiKeyValue}">
            <TextBlock Text="API Key" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
            <dcontrols:CopyableField Value="{Binding SelectedCredential.ApiKeyValue}"
                                     MaskedValue="{Binding SelectedCredential.MaskedApiKeyValue}"
                                     IsSecret="True"
                                     CopyLabel="API key">
                <dcontrols:CopyableField.Effect>
                    <Binding Path="PrivacyModeEnabled" Converter="{StaticResource PrivacyBlurEffectConverter}"/>
                </dcontrols:CopyableField.Effect>
            </dcontrols:CopyableField>
        </StackPanel>

        <dcontrols:FieldRow Spacing="12">
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasApiEndpoint}">
                <TextBlock Text="Endpoint" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.ApiEndpoint}" CopyLabel="Endpoint"/>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasApiDocumentation}">
                <TextBlock Text="Documentation" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.ApiDocumentationUrl}" CopyLabel="Documentation URL"/>
            </StackPanel>
        </dcontrols:FieldRow>
    </StackPanel>
</UserControl>
