<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PhantomVault.UI.Converters"
             xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls"
             x:Class="PhantomVault.UI.Views.Details.CreditCardDetailView">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Resources/Converters/ConverterResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Click any value to copy it. Numbers show as digit boxes: masked ones (number, CVC,
         PIN) show bullets until the eye reveals them, and always copy the real value. -->
    <StackPanel Spacing="12"
                IsVisible="{Binding SelectedCredential.IsCreditCardEntry}">
        <TextBlock Text="Card Details"
                   FontSize="{StaticResource Type.Body.Size}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <dcontrols:FieldRow Spacing="12">
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasCardholderName}">
                <TextBlock Text="Cardholder" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.CardholderName}" CopyLabel="Cardholder"/>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasCardType}">
                <TextBlock Text="Card Type" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.CardType}" CopyLabel="Card type"/>
            </StackPanel>
        </dcontrols:FieldRow>

        <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasCardNumber}">
            <TextBlock Text="Card Number" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
            <dcontrols:CopyableField Value="{Binding SelectedCredential.CardNumber}"
                                     MaskedValue="{Binding SelectedCredential.MaskedCardNumber}"
                                     IsSecret="True"
                                     DigitBoxes="True"
                                     CopyLabel="Card number">
                <dcontrols:CopyableField.Effect>
                    <Binding Path="PrivacyModeEnabled" Converter="{StaticResource PrivacyBlurEffectConverter}"/>
                </dcontrols:CopyableField.Effect>
            </dcontrols:CopyableField>
        </StackPanel>

        <!-- Expiry, CVC and PIN share a line; each sizes to its boxes and wraps if narrow. -->
        <WrapPanel Orientation="Horizontal">
            <StackPanel Spacing="6" Margin="0,0,24,8" IsVisible="{Binding SelectedCredential.HasCardExpiry}">
                <TextBlock Text="Expiry" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.CardExpiryText}"
                                         DigitBoxes="True"
                                         CopyLabel="Expiry"/>
            </StackPanel>
            <StackPanel Spacing="6" Margin="0,0,24,8" IsVisible="{Binding SelectedCredential.HasCardCVV}">
                <TextBlock Text="Security Code" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.CardCVV}"
                                         IsSecret="True"
                                         DigitBoxes="True"
                                         CopyLabel="Security code">
                    <dcontrols:CopyableField.Effect>
                        <Binding Path="PrivacyModeEnabled" Converter="{StaticResource PrivacyBlurEffectConverter}"/>
                    </dcontrols:CopyableField.Effect>
                </dcontrols:CopyableField>
            </StackPanel>
            <StackPanel Spacing="6" Margin="0,0,0,8" IsVisible="{Binding SelectedCredential.HasCardPIN}">
                <TextBlock Text="PIN" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
                <dcontrols:CopyableField Value="{Binding SelectedCredential.CardPIN}"
                                         IsSecret="True"
                                         DigitBoxes="True"
                                         CopyLabel="Card PIN">
                    <dcontrols:CopyableField.Effect>
                        <Binding Path="PrivacyModeEnabled" Converter="{StaticResource PrivacyBlurEffectConverter}"/>
                    </dcontrols:CopyableField.Effect>
                </dcontrols:CopyableField>
            </StackPanel>
        </WrapPanel>

        <StackPanel Spacing="6" IsVisible="{Binding SelectedCredential.HasCardBillingAddress}">
            <TextBlock Text="Billing Address" FontSize="{StaticResource Type.Label.Size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
            <dcontrols:CopyableField Value="{Binding SelectedCredential.CardBillingAddress}" CopyLabel="Billing address" IsMultiline="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
