<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhantomVault.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:PhantomVault.UI.Views"
    xmlns:dcontrols="clr-namespace:PhantomVault.UI.Desktop.Controls"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="720"
        x:Class="PhantomVault.UI.Views.PasswordGeneratorWindow"
        x:DataType="vm:PasswordGeneratorViewModel"
        Title="Password Generator"
        Width="640" Height="720"
        MinWidth="520" MinHeight="560"
        MaxWidth="900" MaxHeight="960"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Classes="animated-window">

    <Design.DataContext>
        <vm:PasswordGeneratorViewModel/>
    </Design.DataContext>

    <!-- Dialog layout shared with the rest of the app (Styles/DialogStyles.axaml): header with
         an icon circle, content in section tiles, actions in a footer. -->
    <Border Classes="dialog-card">
    <Grid RowDefinitions="Auto,*,Auto">
        <InputElement.KeyBindings>
            <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}"/>
        </InputElement.KeyBindings>

        <Border Grid.Row="0" Classes="dialog-header">
            <Grid ColumnDefinitions="Auto,14,*">
                <Border Grid.Column="0" Classes="dialog-icon">
                    <dcontrols:SvgIcon IconName="Assets/SVG/Current/Password.svg"
                                       Width="22" Height="22"
                                       IconColor="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Tools" Classes="dialog-caption"/>
                    <TextBlock Text="Password Generator" Classes="dialog-title"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Horizontal scrolling disabled so the content is measured at the visible width, and
             the inset is a margin on the content rather than ScrollViewer.Padding: the padding
             shifted content that was already full width, so it ran off the right edge. -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4" Margin="24,4,24,16">

                <!-- The password, with copy and regenerate right beside it. -->
                <Border Classes="section-tile">
                    <StackPanel Spacing="12">
                        <TextBlock Text="GENERATED PASSWORD" Classes="tile-label"/>
                        <Grid ColumnDefinitions="*,8,Auto,6,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding GeneratedPassword}"
                                     IsReadOnly="True"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="{StaticResource Type.H4.Size}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     Background="{DynamicResource ControlBackgroundBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     Padding="12,8"
                                     MinHeight="44"
                                     VerticalContentAlignment="Center"
                                     TextWrapping="Wrap"/>
                            <Button Grid.Column="2"
                                    Classes="liquid-glass tile-icon-button"
                                    Command="{Binding CopyToClipboardCommand}"
                                    AutomationProperties.Name="Copy password"
                                    ToolTip.Tip="Copy">
                                <dcontrols:SvgIcon IconName="Assets/SVG/Current/Copy Hollow.svg"
                                                   Width="15" Height="15"
                                                   IconColor="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Grid.Column="4"
                                    Classes="liquid-glass tile-icon-button"
                                    Command="{Binding GenerateCommand}"
                                    AutomationProperties.Name="Generate a new password"
                                    ToolTip.Tip="Generate again">
                                <dcontrols:SvgIcon IconName="Assets/SVG/Current/Generate dice.svg"
                                                   Width="15" Height="15"
                                                   IconColor="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <ProgressBar Grid.Column="0"
                                         Value="{Binding PasswordStrength}"
                                         Maximum="100"
                                         Height="6"
                                         CornerRadius="3"
                                         Background="Transparent"
                                         Foreground="{Binding PasswordStrengthColor}"
                                         VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PasswordStrengthText}"
                                       FontSize="{StaticResource Type.Tiny.Size}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding PasswordStrengthColor}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Length and character sets. -->
                <Border Classes="section-tile">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="LENGTH" Classes="tile-label" VerticalAlignment="Center"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,3"
                                    MinWidth="44">
                                <TextBlock Text="{Binding PasswordLength}"
                                           FontSize="{StaticResource Type.Label.Size}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Slider Value="{Binding PasswordLength}"
                                Minimum="8"
                                Maximum="64"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Margin="0,-6,0,0"/>

                        <TextBlock Text="CHARACTERS" Classes="tile-label"/>
                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,8,Auto">
                            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IncludeUppercase}" Content="Uppercase  A–Z"
                                      FontSize="{StaticResource Type.Small.Size}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding IncludeLowercase}" Content="Lowercase  a–z"
                                      FontSize="{StaticResource Type.Small.Size}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding IncludeNumbers}" Content="Numbers  0–9"
                                      FontSize="{StaticResource Type.Small.Size}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding IncludeSymbols}" Content="Symbols  !@#$%^&amp;*"
                                      FontSize="{StaticResource Type.Small.Size}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>

                        <!-- Same fold as the entry card's "More details". -->
                        <StackPanel Spacing="10">
                            <ToggleButton x:Name="AdvancedToggle"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0,6"
                                          Cursor="Hand"
                                          AutomationProperties.Name="Advanced options">
                                <ToggleButton.Styles>
                                    <Style Selector="ToggleButton /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                    <Style Selector="ToggleButton TextBlock.more-chevron">
                                        <Setter Property="RenderTransform" Value="rotate(0deg)"/>
                                    </Style>
                                    <Style Selector="ToggleButton:checked TextBlock.more-chevron">
                                        <Setter Property="RenderTransform" Value="rotate(180deg)"/>
                                    </Style>
                                    <Style Selector="ToggleButton:pointerover TextBlock.more-label">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    </Style>
                                </ToggleButton.Styles>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Classes="more-label"
                                               Text="Advanced"
                                               FontSize="{StaticResource Type.Label.Size}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="1" Margin="12,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource ControlBorderBrush}"/>
                                    <TextBlock Grid.Column="2"
                                               Classes="more-chevron"
                                               Text="▾"
                                               FontSize="14"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               RenderTransformOrigin="50%,50%">
                                        <TextBlock.Transitions>
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </TextBlock.Transitions>
                                    </TextBlock>
                                </Grid>
                            </ToggleButton>
                            <StackPanel Spacing="8" IsVisible="{Binding #AdvancedToggle.IsChecked}">
                                <CheckBox IsChecked="{Binding AvoidAmbiguous}"
                                          Content="Avoid ambiguous characters (0, O, l, 1…)"
                                          FontSize="{StaticResource Type.Small.Size}"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <CheckBox IsChecked="{Binding EasyToRead}"
                                          Content="Easy to read (no look-alike characters)"
                                          FontSize="{StaticResource Type.Small.Size}"
                                          Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- One-click presets. -->
                <Border Classes="section-tile">
                    <StackPanel Spacing="12">
                        <TextBlock Text="PRESETS" Classes="tile-label"/>
                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <Button Grid.Column="0" Classes="liquid-glass dialog-button" HorizontalAlignment="Stretch"
                                    Command="{Binding ApplyWeakPresetCommand}" Content="Simple · 8"/>
                            <Button Grid.Column="2" Classes="liquid-glass dialog-button" HorizontalAlignment="Stretch"
                                    Command="{Binding ApplyStrongPresetCommand}" Content="Strong · 16"/>
                            <Button Grid.Column="4" Classes="liquid-glass dialog-button" HorizontalAlignment="Stretch"
                                    Command="{Binding ApplyMaxPresetCommand}" Content="Maximum · 64"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="{StaticResource Type.Small.Size}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="liquid-glass dialog-button"
                        Command="{Binding CloseCommand}" Content="_Close"/>
                <Button Grid.Column="3" Classes="liquid-glass dialog-button"
                        Command="{Binding GenerateCommand}" Content="_Generate"/>
                <Button Grid.Column="5" Classes="liquid-glass dialog-button dialog-primary"
                        Command="{Binding AddCommand}" Content="_Add to vault"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</views:ThemeAwareWindow>
