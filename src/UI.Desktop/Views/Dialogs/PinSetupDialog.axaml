<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhantomVault.UI.ViewModels.Dialogs"
        xmlns:views="clr-namespace:PhantomVault.UI.Views"
        xmlns:controls="clr-namespace:PhantomVault.UI.Views.Controls"
        x:Class="PhantomVault.UI.Views.Dialogs.PinSetupDialog"
        x:DataType="vm:PinSetupDialogViewModel"
        Title="Set up PIN lock"
        Width="520"
        Height="470"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="20">
        <Border Background="{DynamicResource SettingsPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                BoxShadow="0 14 36 0 #42000000">
            <Grid Margin="24" RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,22">
                    <Border Width="44" Height="44" CornerRadius="14"
                            Background="#12FFFFFF" BorderBrush="#34FFFFFF" BorderThickness="1">
                        <TextBlock Text="••••" FontSize="12" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Set up PIN lock" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Choose 6–8 digits for quick re-authentication."
                                   FontSize="13" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PIN" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <controls:PinDigitBoxes Pin="{Binding Pin, Mode=TwoWay}"
                                                PinLength="8" MaximumLength="8"
                                                ShowHeader="False" ShowLengthSelector="False"
                                                IsSecret="True"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Confirm PIN" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <controls:PinDigitBoxes Pin="{Binding ConfirmPin, Mode=TwoWay}"
                                                PinLength="8" MaximumLength="8"
                                                ShowHeader="False" ShowLengthSelector="False"
                                                IsSecret="True"/>
                    </StackPanel>
                    <Border Background="#16DC3545" BorderBrush="#50DC3545" BorderThickness="1"
                            CornerRadius="9" Padding="10,8"
                            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                                   Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,20,0,0">
                    <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}"
                            Classes="liquid-glass" Width="104" Height="40"/>
                    <Button Grid.Column="2" Content="Set PIN" Command="{Binding SetPinCommand}"
                            Classes="liquid-glass primary" Width="120" Height="40" IsDefault="True"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</views:ThemeAwareWindow>
