<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhantomVault.UI.ViewModels.Dialogs"
        xmlns:views="clr-namespace:PhantomVault.UI.Views"
        x:Class="PhantomVault.UI.Views.Dialogs.RecoveryPinDialog"
        x:DataType="vm:RecoveryPinDialogViewModel"
        Title="Recovery PIN"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Recovery PIN"
                       FontSize="{StaticResource Type.Icon.Size}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="This single-use recovery PIN can unlock your vault if your USB keyfile and password are unavailable. It is shown only once. Store it somewhere safe and offline."
                       FontSize="{StaticResource Type.Label.Size}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="16">

            <Border Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18,14">
                <StackPanel Spacing="8">
                    <TextBlock Text="Your recovery PIN"
                               FontSize="{StaticResource Type.Small.Size}"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <SelectableTextBlock Text="{Binding DisplayPin}"
                                         FontFamily="Consolas, Cascadia Mono, Menlo, monospace"
                                         FontSize="{StaticResource Type.H4.Size}"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox Content="Show PIN"
                          IsChecked="{Binding IsRevealed}"
                          Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Content="Copy to clipboard"
                        Classes="dull-blue"
                        Command="{Binding CopyCommand}"/>
                <TextBlock Text="{Binding CopyStatus}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="{StaticResource Type.Small.Size}"/>
            </StackPanel>

            <CheckBox Content="I have safely stored this recovery PIN."
                      IsChecked="{Binding HasAcknowledged}"
                      Foreground="{DynamicResource PrimaryTextBrush}"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="{StaticResource Type.Small.Size}"
                       Foreground="{DynamicResource ErrorTextBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,20,0,0">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="100"
                    Height="38"/>
            <Button Content="Close"
                    Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding HasAcknowledged}"
                    Width="120"
                    Height="38"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</views:ThemeAwareWindow>
