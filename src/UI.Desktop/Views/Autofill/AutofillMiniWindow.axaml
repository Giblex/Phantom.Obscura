<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhantomVault.UI.ViewModels.Autofill"
        xmlns:converters="clr-namespace:PhantomVault.UI.Converters"
        xmlns:views="clr-namespace:PhantomVault.UI.Views"
        mc:Ignorable="d" d:DesignWidth="348" d:DesignHeight="428"
        x:Class="PhantomVault.UI.Views.Autofill.AutofillMiniWindow"
        x:DataType="vm:AutofillMiniWindowViewModel"
        Title="PhantomVault Autofill"
        Width="348" Height="428"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Window.Styles>
        <StyleInclude Source="avares://PhantomVault.UI/Views/Autofill/AutofillStyles.axaml"/>

        <!-- Tabs as a quiet segmented control. -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Af.TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource Af.Text}"/>
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource Af.Accent}"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
    </Window.Styles>

    <Border x:Name="Shell" Classes="af-shell" RenderTransformOrigin="50%,0%">
        <Border Classes="af-clip">
            <DockPanel>
                <Border DockPanel.Dock="Top" Classes="af-accent-line"/>

                <!-- Header (drag handle) -->
                <Grid x:Name="DragHeader" DockPanel.Dock="Top" ColumnDefinitions="Auto,12,*,Auto" Margin="14,12,10,10" Background="Transparent">
                    <Border Grid.Column="0" Classes="af-logo">
                        <Image Source="avares://PhantomVault.UI/Assets/ok.png"
                               Width="16" Height="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="PHANTOM OBSCURA" Classes="af-label"/>
                        <TextBlock Text="{Binding CurrentDomain}" Classes="af-title"/>
                    </StackPanel>
                    <Button AutomationProperties.Name="Close" Grid.Column="3"
                            Classes="af-btn ghost"
                            Width="30" Height="30" Padding="0"
                            VerticalAlignment="Top"
                            Command="{Binding CloseWindowCommand}">
                        <Path Data="M4 4L12 12M12 4L4 12"
                              Stroke="{DynamicResource Af.TextSoft}"
                              StrokeThickness="1.6"
                              StrokeLineCap="Round"
                              Width="12" Height="12"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Border DockPanel.Dock="Bottom" Classes="af-footer" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Classes="af-kbd"><TextBlock Text="↵" Classes="af-kbd"/></Border>
                            <TextBlock Text="select" Classes="af-kbd"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border Classes="af-kbd"><TextBlock Text="esc" Classes="af-kbd"/></Border>
                            <TextBlock Text="close" Classes="af-kbd"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TabControl SelectedIndex="{Binding SelectedTab}" Margin="8,0,8,0">
                    <TabItem Header="Suggestions">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="6,8,6,6">
                                <TextBox Text="{Binding SearchFilter}"
                                         Classes="af-field"
                                         Watermark="Search credentials..."/>
                            </Border>

                            <ListBox ItemsSource="{Binding FilteredSuggestions}"
                                     SelectedItem="{Binding SelectedSuggestion}"
                                     IsVisible="{Binding HasSuggestions}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,10,*,Auto" Cursor="Hand">
                                            <Border Grid.Column="0"
                                                    Width="8" Height="8"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding MatchType, Converter={x:Static converters:MatchTypeColorConverter.Instance}}"/>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="{Binding Credential.Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Af.Text}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Credential.Username}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Af.TextSoft}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Credential.Url}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource Af.TextMuted}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="3" Classes="af-pill" VerticalAlignment="Center" Padding="7,2">
                                                <TextBlock Text="{Binding MatchScore}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Af.TextSoft}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel IsVisible="{Binding !HasSuggestions}"
                                        Spacing="6"
                                        Margin="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="No credentials found for this site"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource Af.TextSoft}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                                <TextBlock Text="Open your vault to add one"
                                           FontSize="11"
                                           Foreground="{DynamicResource Af.TextMuted}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Capture">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="#1A5FC4C0"
                                    BorderBrush="#555FC4C0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="6,10,6,6"
                                    IsVisible="{Binding HasNewPasswordCapture}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="New password detected"
                                                   FontWeight="SemiBold"
                                                   FontSize="13.5"
                                                   Foreground="{DynamicResource Af.Text}"/>
                                        <TextBlock Text="{Binding CaptureMessage}" Classes="af-body"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                        <Button Content="Ignore"
                                                Command="{Binding IgnoreCaptureCommand}"
                                                Classes="af-btn ghost"/>
                                        <Button Content="Save"
                                                Command="{Binding SaveCapturedPasswordCommand}"
                                                Classes="af-btn primary"
                                                IsVisible="{Binding PendingCapture, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <Button Content="Update"
                                                Command="{Binding UpdatePasswordCommand}"
                                                Classes="af-btn primary"
                                                IsVisible="{Binding PendingChange, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel IsVisible="{Binding !HasNewPasswordCapture}"
                                        Spacing="6"
                                        Margin="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="No new passwords detected"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource Af.TextSoft}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Phantom Obscura captures passwords when you register or log in to websites"
                                           FontSize="11"
                                           Foreground="{DynamicResource Af.TextMuted}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="250"/>
                            </StackPanel>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Border>
</views:ThemeAwareWindow>
