<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
        xmlns:views="clr-namespace:PhantomVault.UI.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PhantomVault.UI.Views.Autofill.AutofillSavePrompt"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="376"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="Save password prompt">

    <views:ThemeAwareWindow.Styles>
        <StyleInclude Source="avares://PhantomVault.UI/Views/Autofill/AutofillStyles.axaml"/>
    </views:ThemeAwareWindow.Styles>

    <!-- Rises into the bottom-right corner with a soft spring (AutofillMotion.EnterAsync). -->
    <Border x:Name="Shell" Classes="af-shell" RenderTransformOrigin="50%,100%">
        <Border Classes="af-clip">
            <StackPanel>
                <Border Classes="af-accent-line"/>

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,12,*" Margin="16,14,16,12">
                    <Border Grid.Column="0" Classes="af-logo">
                        <Image Source="avares://PhantomVault.UI/Assets/ok.png"
                               Width="16" Height="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="PHANTOM OBSCURA" Classes="af-label"/>
                        <TextBlock x:Name="TitleText" Classes="af-title" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <Border Classes="af-divider"/>

                <!-- Details -->
                <StackPanel Margin="16,14,16,14" Spacing="12">

                    <!-- Site, shown as a chip so it reads as "where this is from". -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="SITE" Classes="af-label"/>
                        <Border Classes="af-pill" HorizontalAlignment="Left" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Af.Accent}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DomainText"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Af.Text}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="280"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="USERNAME" Classes="af-label"/>
                        <TextBox x:Name="UsernameBox"
                                 Classes="af-field"
                                 AutomationProperties.Name="Username to save"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="PASSWORD" Classes="af-label"/>
                        <Grid ColumnDefinitions="*,6,Auto,6,Auto">
                            <TextBox x:Name="PasswordBox"
                                     Grid.Column="0"
                                     Classes="af-field"
                                     PasswordChar="●"
                                     AutomationProperties.Name="Password to save"/>
                            <Button x:Name="RevealButton"
                                    Grid.Column="2"
                                    Classes="af-btn"
                                    Width="34"
                                    Padding="0"
                                    ToolTip.Tip="Show or hide the password"
                                    AutomationProperties.Name="Toggle password visibility">
                                <Path Data="M12 5C7 5 2.7 8.1 1 12c1.7 3.9 6 7 11 7s9.3-3.1 11-7c-1.7-3.9-6-7-11-7zm0 11.5A4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 0 1 0 9zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"
                                      Fill="{DynamicResource Af.TextSoft}"
                                      Width="15" Height="15"
                                      Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="GenerateButton"
                                    Grid.Column="4"
                                    Classes="af-btn"
                                    Content="Generate"
                                    ToolTip.Tip="Replace with a strong generated password"
                                    AutomationProperties.Name="Generate a strong password"/>
                        </Grid>
                        <TextBlock x:Name="HintText"
                                   FontSize="11"
                                   Foreground="{DynamicResource Af.TextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <Border Classes="af-footer" Padding="12,11">
                    <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
                        <Button x:Name="NeverButton"
                                Grid.Column="0"
                                Classes="af-btn ghost"
                                Content="Never for this site"
                                AutomationProperties.Name="Never save for this site"/>
                        <Button x:Name="DismissButton"
                                Grid.Column="2"
                                Classes="af-btn"
                                Content="Not now"
                                AutomationProperties.Name="Dismiss without saving"/>
                        <Button x:Name="SaveButton"
                                Grid.Column="4"
                                Classes="af-btn primary"
                                MinWidth="84"
                                Content="Save"
                                AutomationProperties.Name="Save this credential"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Border>
</views:ThemeAwareWindow>
