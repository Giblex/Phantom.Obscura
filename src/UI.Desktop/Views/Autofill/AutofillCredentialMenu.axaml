<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
        xmlns:views="clr-namespace:PhantomVault.UI.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PhantomVault.UI.Views.Autofill.AutofillCredentialMenu"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="356"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="AutoFill credential suggestions">

    <views:ThemeAwareWindow.Styles>
        <StyleInclude Source="avares://PhantomVault.UI/Views/Autofill/AutofillStyles.axaml"/>
    </views:ThemeAwareWindow.Styles>

    <!-- Shell springs in (AutofillMotion.EnterAsync); rows fade up after it. -->
    <Border x:Name="Shell" Classes="af-shell" RenderTransformOrigin="50%,0%">
        <Border Classes="af-clip">
            <StackPanel>
                <Border Classes="af-accent-line"/>

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,12,*,Auto" Margin="16,14,16,12">
                    <Border Grid.Column="0" Classes="af-logo">
                        <Image Source="avares://PhantomVault.UI/Assets/ok.png"
                               Width="16" Height="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="PHANTOM OBSCURA" Classes="af-label"/>
                        <TextBlock x:Name="DomainHeader" Classes="af-title"/>
                    </StackPanel>

                    <Border Grid.Column="3" Classes="af-pill" VerticalAlignment="Center">
                        <TextBlock x:Name="CountBadge"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Af.TextSoft}"/>
                    </Border>
                </Grid>

                <Border Classes="af-divider"/>

                <!-- Rows (built in code-behind) -->
                <StackPanel x:Name="RowsPanel" Margin="0,6,0,6"/>

                <!-- Footer: keyboard affordances + copy confirmation -->
                <Border Classes="af-footer" Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="af-kbd"><TextBlock Text="↵" Classes="af-kbd"/></Border>
                                <TextBlock Text="fill" Classes="af-kbd"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="af-kbd"><TextBlock Text="U P T" Classes="af-kbd"/></Border>
                                <TextBlock Text="copy" Classes="af-kbd"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="af-kbd"><TextBlock Text="esc" Classes="af-kbd"/></Border>
                                <TextBlock Text="close" Classes="af-kbd"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Copy confirmation. Copy actions leave the menu open, so this is the
                             only feedback that anything happened. -->
                        <Border x:Name="ToastPill" Grid.Column="1" Classes="af-toast" VerticalAlignment="Center">
                            <TextBlock x:Name="Toast"
                                       Text=""
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Af.Accent}"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Border>

</views:ThemeAwareWindow>
