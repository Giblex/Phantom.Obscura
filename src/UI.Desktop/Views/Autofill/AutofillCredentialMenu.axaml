<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
        xmlns:views="clr-namespace:PhantomVault.UI.Views"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PhantomVault.UI.Views.Autofill.AutofillCredentialMenu"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="344"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="AutoFill credential suggestions">

    <views:ThemeAwareWindow.Resources>
        <!-- One edge colour for every border in this window. Rank-graded and
             gradient borders made each row look like a different component. -->
        <SolidColorBrush x:Key="EdgeBrush" Color="#2C3B52"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3E8C86"/>
    </views:ThemeAwareWindow.Resources>

    <views:ThemeAwareWindow.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="Foreground" Value="#7A8FA8"/>
        </Style>
        <Style Selector="TextBlock.kbd">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8AA0B8"/>
        </Style>
    </views:ThemeAwareWindow.Styles>

    <!-- BoxShadow colours are parsed at runtime, not by the XAML compiler, so a
         malformed literal builds clean and then throws on construction. Every
         colour here must be exactly 8 hex digits (#AARRGGBB). -->
    <Border x:Name="Shell"
            CornerRadius="16"
            Background="#F8121C2E"
            BorderThickness="1"
            BorderBrush="{StaticResource EdgeBrush}"
            BoxShadow="0 20 48 -12 #A0000000"
            ClipToBounds="True"
            Margin="10"
            RenderTransformOrigin="0%,0%">

        <Border.Transitions>
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform"
                                               Duration="0:0:0.22"
                                               Easing="CubicEaseOut"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
            </Transitions>
        </Border.Transitions>

        <StackPanel>

            <!-- ── Header ─────────────────────────────────────────────────── -->
            <Border Padding="14,12"
                    Background="#14FFFFFF"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="0,0,0,1">

                <Grid ColumnDefinitions="Auto,10,*,Auto">
                    <Border Grid.Column="0"
                            Width="26" Height="26"
                            CornerRadius="13"
                            BorderThickness="1.5"
                            BorderBrush="{StaticResource EdgeBrush}"
                            Background="#FF16233A">
                        <Image Source="avares://PhantomVault.UI/Assets/ok.png"
                               Width="14" Height="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="PHANTOM OBSCURA" Classes="label"/>
                        <TextBlock x:Name="DomainHeader"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="#E8F0F6"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="3"
                            VerticalAlignment="Center"
                            CornerRadius="9"
                            Padding="8,3"
                            Background="#1EFFFFFF">
                        <TextBlock x:Name="CountBadge"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#93A7BC"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Rows (built in code-behind) ────────────────────────────── -->
            <StackPanel x:Name="RowsPanel" Margin="0,4,0,4"/>

            <!-- ── Footer: keyboard affordances + copy confirmation ───────── -->
            <Border Padding="14,9"
                    Background="#12000000"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border CornerRadius="4" Padding="5,1" Background="#22FFFFFF">
                                <TextBlock Text="↵" Classes="kbd"/>
                            </Border>
                            <TextBlock Text="fill" Classes="kbd" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border CornerRadius="4" Padding="5,1" Background="#22FFFFFF">
                                <TextBlock Text="U P T" Classes="kbd"/>
                            </Border>
                            <TextBlock Text="copy" Classes="kbd" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Border CornerRadius="4" Padding="5,1" Background="#22FFFFFF">
                                <TextBlock Text="esc" Classes="kbd"/>
                            </Border>
                            <TextBlock Text="close" Classes="kbd" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Copy confirmation. Copy actions leave the menu open, so this
                         is the only feedback that anything happened. -->
                    <TextBlock x:Name="Toast"
                               Grid.Column="1"
                               Text=""
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="#8FB4AE"
                               VerticalAlignment="Center"
                               Opacity="0">
                        <TextBlock.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                            </Transitions>
                        </TextBlock.Transitions>
                    </TextBlock>
                </Grid>
            </Border>

        </StackPanel>
    </Border>

</views:ThemeAwareWindow>
