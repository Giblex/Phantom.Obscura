<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhantomVault.UI.ViewModels.PhantomKey"
        xmlns:shared="clr-namespace:Phantom.UI.Shared.PhantomKey;assembly=Phantom.UI.Shared"
        x:Class="PhantomVault.UI.Views.PhantomKey.PhantomKeyUnlockDialog"
        x:DataType="vm:PhantomKeyUnlockDialogViewModel"
        Title="Unlock with Phantom Key"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        CanResize="False">
    <Grid Margin="24" RowDefinitions="*,Auto">
        <shared:PhantomKeyUnlockControl Grid.Row="0"
            Drives="{Binding Drives}"
            SelectedDrive="{Binding SelectedDrive, Mode=TwoWay}"
            Pin="{Binding Pin, Mode=TwoWay}"
            Status="{Binding Status}"
            IsBusy="{Binding IsBusy}"
            RescanCommand="{Binding RescanCommand}"
            UnlockCommand="{Binding UnlockCommand}" />
        <Button Grid.Row="1" Content="Close" Click="OnCloseClicked"
                HorizontalAlignment="Right" Padding="20,8" Margin="0,16,0,0"
                Background="#334155" Foreground="#E2E8F0" BorderThickness="0"
                CornerRadius="6" />
    </Grid>
</Window>
