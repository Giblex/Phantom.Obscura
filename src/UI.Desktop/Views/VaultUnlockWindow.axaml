<?xml version="1.0" encoding="utf-8"?>
<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhantomVault.UI.ViewModels"
        xmlns:views="clr-namespace:PhantomVault.UI.Views"
        xmlns:conv="clr-namespace:PhantomVault.UI.Converters"
        x:Class="PhantomVault.UI.Views.VaultUnlockWindow"
        x:DataType="vm:VaultUnlockViewModel"
        Title="Unlocking Vault"
        Width="320"
        Height="320"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Vault Unlock Progress Window"
        AutomationProperties.HelpText="This window shows the progress of unlocking your secure vault"
        Classes="animated-window">

    <views:ThemeAwareWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Assets/Themes/PreVaultTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="UnlockAccentBrush" Color="#5D7DA7"/>
            <SolidColorBrush x:Key="UnlockTrackBrush" Color="#13202D"/>
            <SolidColorBrush x:Key="UnlockOrbBrush" Color="#173247"/>
            <conv:PercentToRingDashConverter x:Key="PercentToRingDashConverter"/>
        </ResourceDictionary>
    </views:ThemeAwareWindow.Resources>

    <views:ThemeAwareWindow.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="Ellipse.unlock-ring">
            <Setter Property="Opacity" Value="0.95"/>
        </Style>
    </views:ThemeAwareWindow.Styles>

    <!-- Circular shell. The window itself is transparent and undecorated; this Border
         is the entire visible dialog, sized a little beyond the 196px progress ring so
         the ring stays the subject rather than floating in a large panel.
         The title, subtitle, progress bar and footer that used to sit around it are
         gone: the ring already encodes progress, and the status line carries the rest. -->
    <Border x:Name="Shell"
            Width="320" Height="320"
            CornerRadius="160"
            ClipToBounds="True"
            BorderThickness="1"
            BorderBrush="#3A5A7A">
        <Border.Background>
            <RadialGradientBrush Center="50%,38%" GradientOrigin="50%,38%" RadiusX="72%" RadiusY="72%">
                <GradientStop Offset="0"   Color="#FF16273A"/>
                <GradientStop Offset="1"   Color="#FF0C1622"/>
            </RadialGradientBrush>
        </Border.Background>

        <!-- Grid, not a StackPanel. In a stack the ring's position depends on the
             height of the status text below it, so a message wrapping to a second
             line shifted the ring and logo. Here the ring is centred in the circle
             and the status is anchored to the bottom, so the logo never moves no
             matter what the status says. -->
        <Grid>

            <Grid Width="196" Height="196"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Ellipse Classes="unlock-ring"
                         Width="196" Height="196"
                         StrokeThickness="7"
                         StrokeLineCap="Round"
                         StrokeDashArray="{Binding ProgressPercent, Converter={StaticResource PercentToRingDashConverter}, ConverterParameter='196|7'}"
                         RenderTransformOrigin="50%,50%">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0" Color="#5D7DA7"/>
                            <GradientStop Offset="0.5" Color="#8FB5DF"/>
                            <GradientStop Offset="1" Color="#173247"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                </Ellipse>

                <!-- Logo sits inside the loading ring — no circular tile behind it. -->
                <Image Source="avares://PhantomVault.UI/Assets/ok.png"
                       Width="104" Height="104"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>

            <!-- Anchored to the bottom of the circle and constrained to the chord
                 width at that height, so wrapped text cannot spill past the curve
                 or push the ring around. -->
            <TextBlock Text="{Binding Status}"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,26"
                       FontSize="11.5"
                       MaxWidth="200"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Unlock Status"
                       AutomationProperties.LiveSetting="Assertive"/>
        </Grid>
    </Border>
</views:ThemeAwareWindow>
