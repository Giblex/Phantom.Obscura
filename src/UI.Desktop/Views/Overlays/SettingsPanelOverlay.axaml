<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:PhantomVault.UI.Converters"
             x:Class="PhantomVault.UI.Views.Overlays.SettingsPanelOverlay">

    <UserControl.Resources>

        <conv:StringEqualsConverter x:Key="SettingsTabEqualsConverter"/>
        <conv:SettingsTabSearchConverter x:Key="SettingsTabSearchConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="Button.settings-tab.active TextBlock.tab-label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style Selector="Border#SettingsSlideHost Border.fade-in">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border#SettingsSlideHost Border.fade-in TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button.settings-tab.active Border.tab-accent">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Save button — always painted in the live accent colour so theme changes are
             reflected immediately (the dirty-vs-clean distinction is conveyed by the orange
             unsaved-changes ellipse next to it instead of the button colour). -->
        <Style Selector="Button.settings-save-primary /template/ Border#BaseBorder">
            <Setter Property="Background" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.settings-save-primary /template/ ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="Button.settings-save-primary /template/ Border#Sheen">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- Hover/pressed: nudge opacity instead of recolouring, so accent stays consistent. -->
        <Style Selector="Button.settings-save-primary:pointerover /template/ Border#BaseBorder">
            <Setter Property="Background" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <Style Selector="Button.settings-save-primary:pressed /template/ Border#BaseBorder">
            <Setter Property="Background" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <!-- Dirty: slight elevation via opacity bump so the "you have changes" state still reads. -->
        <Style Selector="Button.settings-save-primary.dirty /template/ Border#BaseBorder">
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="14" Opacity="0.35" OffsetX="0" OffsetY="2"/>
            </Setter>
        </Style>

        <Style Selector="Border#SettingsSlideHost Button.liquid-glass">
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass /template/ Border#BaseBorder">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#552B4A7A" Offset="0"/>
                    <GradientStop Color="#1F2B4A7A" Offset="0.35"/>
                    <GradientStop Color="#00000000" Offset="0.7"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Border}"/>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass:pointerover /template/ Border#BaseBorder">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#803A5E94" Offset="0"/>
                    <GradientStop Color="#383A5E94" Offset="0.4"/>
                    <GradientStop Color="#00000000" Offset="0.8"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass:pressed /template/ Border#BaseBorder">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#A0213D66" Offset="0"/>
                    <GradientStop Color="#48213D66" Offset="0.4"/>
                    <GradientStop Color="#00000000" Offset="0.85"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass /template/ Border#Sheen">
            <Setter Property="Opacity" Value="0.15"/>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass:pointerover /template/ Border#Sheen">
            <Setter Property="Opacity" Value="0.25"/>
        </Style>

        <Style Selector="Border.save-toast">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.85) translateY(10px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.save-toast.toast-shown">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1) translateY(0px)"/>
        </Style>

        <Style Selector="Border#SettingsSlideHost Border.fade-in">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>

            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.32" OffsetX="0" OffsetY="5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource OverlayBackgroundBrush}"
            IsVisible="{Binding IsSettingsPanelVisible}"
            IsHitTestVisible="{Binding IsSettingsPanelVisible}">

        <Grid ClipToBounds="True">

            <Border Background="Transparent" PointerPressed="OnBackgroundClicked" />

            <Border x:Name="SettingsSlideHost"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="920"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="20,0,0,20"
                    ClipToBounds="True"
                    BoxShadow="-40 0 140 -10 #E0000000, -18 0 48 -8 #B0000000, -6 0 18 -4 #80000000"
                    RenderTransformOrigin="1,0.5">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="IsSettingsPanelVisible"/>
                    </MultiBinding>
                </Border.IsVisible>
                <Border.RenderTransform>
                    <TranslateTransform X="0" />
                </Border.RenderTransform>
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="RenderTransform">
                            <TranslateTransform X="920" />
                        </Setter>
                    </Style>
                    <Style Selector="Border[IsVisible=true]">
                        <Setter Property="RenderTransform">
                            <TranslateTransform X="0" />
                        </Setter>
                    </Style>
                </Border.Styles>
                <Border.Transitions>
                    <Transitions>

                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:1.7" Easing="QuinticEaseOut"/>
                    </Transitions>
                </Border.Transitions>

                <Grid RowDefinitions="Auto,Auto,*">

                    <Border Grid.Row="0"
                            Classes="header-surface"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            Padding="25,20"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1"
                            ZIndex="2"
                            BoxShadow="0 6 18 -4 #80000000, 0 2 6 -2 #60000000">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Settings"
                                           FontSize="{StaticResource Type.Icon.Size}"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Configure your vault preferences and appearance"
                                           FontSize="{StaticResource Type.Label.Size}"
                                           Classes="header-muted"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Command="{Binding CloseSettingsPanelCommand}"
                                    Classes="copy-btn"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource Type.H4.Size}"
                                    ToolTip.Tip="Close settings"/>
                        </Grid>
                    </Border>

                    <!-- Master "Go Offline" switch: surfaces PrivacyShield.PrivacyModeEnabled
                         (wired to the internet gateway) prominently above every settings tab.
                         When ON the app refuses all network consent and revokes active grants. -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CategoryPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="25,14"
                            ZIndex="1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0"
                                    Width="34" Height="34"
                                    CornerRadius="17"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="🛡"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Offline mode"
                                           FontWeight="SemiBold"
                                           FontSize="{StaticResource Type.Body.Size}"/>
                                <TextBlock Text="Block all network access. Revokes active grants and refuses new connection requests until turned off."
                                           FontSize="{StaticResource Type.Label.Size}"
                                           Classes="header-muted"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding PrivacyModeEnabled, Mode=TwoWay}"
                                          ToolTip.Tip="Master offline switch"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="220,*" VerticalAlignment="Stretch">

                        <Border Grid.Column="0"
                                VerticalAlignment="Stretch"
                                ClipToBounds="True"
                                Background="{DynamicResource CategoryPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="0,0,1,0">
                          <Grid RowDefinitions="Auto,*">
                            <TextBox Grid.Row="0"
                                     Margin="15,18,15,8"
                                     Watermark="Search settings…"
                                     Text="{Binding SettingsSearchQuery, Mode=TwoWay}"
                                     VerticalAlignment="Top"/>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Stretch"
                                          MinHeight="0">
                                <ScrollViewer.OpacityMask>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0.00" Color="#80FFFFFF"/>
                                        <GradientStop Offset="0.04" Color="#FFFFFFFF"/>
                                        <GradientStop Offset="0.82" Color="#FFFFFFFF"/>
                                        <GradientStop Offset="1.00" Color="#80FFFFFF"/>
                                    </LinearGradientBrush>
                                </ScrollViewer.OpacityMask>
                            <StackPanel Spacing="6" Margin="15,20,15,90">
                                <Button Command="{Binding ShowGeneralSettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='general basics startup dashboard language clipboard'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=general}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="General"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowSecuritySettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='security auto-lock pin password unlock biometric windows hello passkey usb'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=security}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Security"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowThemeSettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='theme appearance dark light accent color font skin animation transparency'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=theme}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Theme"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowImportExportSettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='import export csv json migrate transfer data'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=importexport}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Import / Export"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowAutoFillSettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='auto-fill autofill browser extension domains origins fill'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=autofill}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Auto-Fill"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowBackupSettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='recovery backup restore schedule encryption dpapi snapshot'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=backup}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Recovery &amp; Backup"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowAccessibilitySettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='accessibility screen reader high contrast tooltip animation motion keyboard shortcuts'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=accessibility}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Accessibility"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowAdvancedSettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='advanced developer diagnostics logging experimental debug'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=advanced}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Advanced"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowRubbishBinSettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='rubbish bin trash recycle delete purge secure'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=rubbishbin}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Secured Rubbish Bin"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowRecentIssuesCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='recent issues errors warnings activity diagnostics log problems'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=recentissues}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Recent Issues"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding OpenSecurityDashboardWindowCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='password health weak reused breach strength score dashboard'}"
                                        Classes="liquid-glass settings-tab"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Password Health"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowSyncSettingsCommand}"
                                        IsVisible="{Binding SettingsSearchQuery, Converter={StaticResource SettingsTabSearchConverter}, ConverterParameter='sync integration extension cross-app totp issuers bridge'}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=sync}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Sync &amp; Integration"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="1"
                                    VerticalAlignment="Bottom"
                                    Height="90"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource CategoryPanelBackgroundBrush}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Offset="0.00" Color="#40FFFFFF"/>
                                        <GradientStop Offset="0.45" Color="#DFFFFFFF"/>
                                        <GradientStop Offset="1.00" Color="#FFFFFFFF"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                          </Grid>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="*,Auto">

                            <ScrollViewer Grid.Row="0"
                                         VerticalScrollBarVisibility="Visible"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalAlignment="Stretch"
                                         MinHeight="0"
                                         Padding="0,20,0,30">
                                <ContentControl Content="{Binding SelectedSettingsContent}"
                                              HorizontalAlignment="Center"
                                              HorizontalContentAlignment="Stretch"
                                              Width="640"
                                              Margin="0,0,0,40"/>
                            </ScrollViewer>

                            <Border Grid.Row="0"
                                    Classes="save-toast"
                                    Classes.toast-shown="{Binding IsSettingsSaveNotificationVisible}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,44,24"
                                    Padding="14,10"
                                    CornerRadius="{DynamicResource Radius.Lg}"
                                    BorderBrush="{DynamicResource QuickFilterGlassActiveBorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource QuickFilterGlassActiveBrush}"
                                    IsHitTestVisible="False"
                                    RenderTransformOrigin="0.5,1"
                                    BoxShadow="{DynamicResource SlideOutPanelShadow}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <!-- Use AccentBrush so the save confirmation tracks the
                                         user's chosen accent colour instead of a fixed green. -->
                                    <Border Width="18" Height="18"
                                            CornerRadius="9"
                                            Background="{DynamicResource UserAccentBrush}">
                                        <TextBlock Text="✓"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource Type.Micro.Size}"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFFFF"/>
                                    </Border>
                                    <TextBlock Text="{Binding SettingsSaveNotification}"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Type.Small.Size}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="22,12,22,14">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource WarningBrush}"
                                             IsVisible="{Binding HasUnsavedSettings}"/>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Type.Small.Size}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="You have unsaved changes"
                                               IsVisible="{Binding HasUnsavedSettings}"/>
                                    <Button Grid.Column="2"
                                            Content="Discard"
                                            Classes="liquid-glass"
                                            Command="{Binding DiscardSettingsCommand}"
                                            Padding="14,6"/>

                                    <Button Grid.Column="3"
                                            Content="Save"
                                            Classes="liquid-glass settings-save-primary"
                                            Classes.dirty="{Binding HasUnsavedSettings}"
                                            Command="{Binding SaveSettingsCommand}"
                                            Padding="22,6"
                                            FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>

</UserControl>

