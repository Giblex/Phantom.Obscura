<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:PhantomVault.UI.Converters"
             x:Class="PhantomVault.UI.Views.Overlays.SettingsPanelOverlay">

    <UserControl.Resources>

        <conv:StringEqualsConverter x:Key="SettingsTabEqualsConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="Button.settings-tab.active TextBlock.tab-label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="Button.settings-tab.active Border.tab-accent">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <Style Selector="Button.settings-save-primary.dirty /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style Selector="Border#SettingsSlideHost Button.liquid-glass">
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass /template/ Border#BaseBorder">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#552B4A7A" Offset="0"/>
                    <GradientStop Color="#1F2B4A7A" Offset="0.35"/>
                    <GradientStop Color="#00000000" Offset="0.7"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Border}"/>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass:pointerover /template/ Border#BaseBorder">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#803A5E94" Offset="0"/>
                    <GradientStop Color="#383A5E94" Offset="0.4"/>
                    <GradientStop Color="#00000000" Offset="0.8"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass:pressed /template/ Border#BaseBorder">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#A0213D66" Offset="0"/>
                    <GradientStop Color="#48213D66" Offset="0.4"/>
                    <GradientStop Color="#00000000" Offset="0.85"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass /template/ Border#Sheen">
            <Setter Property="Opacity" Value="0.15"/>
        </Style>
        <Style Selector="Border#SettingsSlideHost Button.liquid-glass:pointerover /template/ Border#Sheen">
            <Setter Property="Opacity" Value="0.25"/>
        </Style>

        <Style Selector="Border.save-toast">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.85) translateY(10px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.save-toast.toast-shown">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1) translateY(0px)"/>
        </Style>

        <Style Selector="Border#SettingsSlideHost Border.fade-in">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>

            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.32" OffsetX="0" OffsetY="5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource OverlayBackgroundBrush}"
            IsVisible="{Binding IsSettingsPanelVisible}"
            IsHitTestVisible="{Binding IsSettingsPanelVisible}">

        <Grid ClipToBounds="True">

            <Border Background="Transparent" PointerPressed="OnBackgroundClicked" />

            <Border x:Name="SettingsSlideHost"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="920"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="20,0,0,20"
                    ClipToBounds="True"
                    BoxShadow="-40 0 140 -10 #E0000000, -18 0 48 -8 #B0000000, -6 0 18 -4 #80000000"
                    RenderTransformOrigin="1,0.5">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="IsSettingsPanelVisible"/>
                    </MultiBinding>
                </Border.IsVisible>
                <Border.RenderTransform>
                    <TranslateTransform X="0" />
                </Border.RenderTransform>
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="RenderTransform">
                            <TranslateTransform X="920" />
                        </Setter>
                    </Style>
                    <Style Selector="Border[IsVisible=true]">
                        <Setter Property="RenderTransform">
                            <TranslateTransform X="0" />
                        </Setter>
                    </Style>
                </Border.Styles>
                <Border.Transitions>
                    <Transitions>

                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:1.7" Easing="QuinticEaseOut"/>
                    </Transitions>
                </Border.Transitions>

                <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0"
                            Classes="header-surface"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            Padding="25,20"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1"
                            ZIndex="2"
                            BoxShadow="0 6 18 -4 #80000000, 0 2 6 -2 #60000000">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Settings"
                                           FontSize="{StaticResource Type.Icon.Size}"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Configure your vault preferences and appearance"
                                           FontSize="{StaticResource Type.Label.Size}"
                                           Classes="header-muted"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Command="{Binding CloseSettingsPanelCommand}"
                                    Classes="copy-btn"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource Type.H4.Size}"
                                    ToolTip.Tip="Close settings"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="220,*" VerticalAlignment="Stretch">

                        <Border Grid.Column="0"
                                VerticalAlignment="Stretch"
                                ClipToBounds="True"
                                Background="{DynamicResource CategoryPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="0,0,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalAlignment="Stretch"
                                          MinHeight="0">
                            <StackPanel Spacing="6" Margin="15,20">
                                <Button Command="{Binding ShowGeneralSettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=general}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="General"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowSecuritySettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=security}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Security"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowThemeSettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=theme}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Theme"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowImportExportSettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=importexport}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Import / Export"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowAutoFillSettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=autofill}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Auto-Fill"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowBackupSettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=backup}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Backup"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowAccessibilitySettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=accessibility}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Accessibility"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowAdvancedSettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=advanced}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Advanced"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowRubbishBinSettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=rubbishbin}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Secured Rubbish Bin"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding OpenSecurityDashboardWindowCommand}"
                                        Classes="liquid-glass settings-tab"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Password Health"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>

                                <Button Command="{Binding ShowSyncSettingsCommand}"
                                        Classes="liquid-glass settings-tab"
                                        Classes.active="{Binding SelectedSettingsTab, Converter={StaticResource SettingsTabEqualsConverter}, ConverterParameter=sync}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Height="40"
                                        Padding="0">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" Classes="tab-accent"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="2"
                                                Margin="2,6"
                                                IsVisible="False"/>
                                        <TextBlock Grid.Column="1" Classes="tab-label"
                                                   Text="Sync &amp; Integration"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="*,Auto">

                            <ScrollViewer Grid.Row="0"
                                         VerticalScrollBarVisibility="Visible"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalAlignment="Stretch"
                                         MinHeight="0"
                                         Padding="28,20,4,30">
                                <ContentControl Content="{Binding SelectedSettingsContent}"
                                              HorizontalAlignment="Stretch"
                                              Margin="0,0,32,40"/>
                            </ScrollViewer>

                            <Border Grid.Row="0"
                                    Classes="save-toast"
                                    Classes.toast-shown="{Binding IsSettingsSaveNotificationVisible}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,44,24"
                                    Padding="14,10"
                                    CornerRadius="{DynamicResource Radius.Lg}"
                                    BorderBrush="{DynamicResource QuickFilterGlassActiveBorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource QuickFilterGlassActiveBrush}"
                                    IsHitTestVisible="False"
                                    RenderTransformOrigin="0.5,1"
                                    BoxShadow="{DynamicResource SlideOutPanelShadow}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="18" Height="18"
                                            CornerRadius="9"
                                            Background="{DynamicResource SuccessBrush}">
                                        <TextBlock Text="✓"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource Type.Micro.Size}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding SettingsSaveNotification}"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Type.Small.Size}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="22,12,22,14">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource WarningBrush}"
                                             IsVisible="{Binding HasUnsavedSettings}"/>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Type.Small.Size}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="You have unsaved changes"
                                               IsVisible="{Binding HasUnsavedSettings}"/>
                                    <Button Grid.Column="2"
                                            Content="Discard"
                                            Classes="liquid-glass"
                                            Command="{Binding DiscardSettingsCommand}"
                                            Padding="14,6"/>

                                    <Button Grid.Column="3"
                                            Content="Save"
                                            Classes="liquid-glass settings-save-primary"
                                            Classes.dirty="{Binding HasUnsavedSettings}"
                                            Command="{Binding SaveSettingsCommand}"
                                            Padding="22,6"
                                            FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>

</UserControl>

