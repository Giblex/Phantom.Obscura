<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhantomVault.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="380"
        x:Class="PhantomVault.UI.Views.SecurityCheckScreen"
        x:DataType="vm:SecurityCheckScreenViewModel"
        Title="Security Check"
        Width="480" Height="380"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="avares://PhantomVault.UI/Assets/Visuals/Giblex Icons/Parent Icon.ico"
        FontFamily="{DynamicResource DefaultFontFamily}"
        FontSize="{DynamicResource DefaultFontSize}"
        Classes="animated-window">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Assets/Themes/PreVaultTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Design.DataContext>
        <vm:SecurityCheckScreenViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Sunken loading bar: dark trough color + subtle 1px top/bottom
             rim in the template gives the recessed look. -->
        <Style Selector="ProgressBar.sec-bar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#88050C18"/>
            <Setter Property="BorderBrush" Value="#40000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Dot-grid overlay (matches welcome + wizard). -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border.Background>
                <ImageBrush Source="avares://PhantomVault.UI/Assets/dot_pattern.png"
                            TileMode="Tile"
                            Stretch="None"
                            SourceRect="0,0,8,8"
                            DestinationRect="0,0,8,8"/>
            </Border.Background>
        </Border>

        <!-- Compact header -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="24,20,24,12"
                    VerticalAlignment="Center">
            <Image Source="avares://PhantomVault.UI/Assets/Visuals/Giblex Icons/Icon Transparent background.png"
                   Width="32" Height="32" Stretch="Uniform"/>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Vault Security Check"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#E8EEF4"/>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="#6B8CA8"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- Stacked loading bars -->
        <StackPanel Grid.Row="1"
                    Margin="24,4,24,4"
                    Spacing="10">

            <!-- Overall -->
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Overall"
                               FontSize="11"
                               Foreground="#8BACC4"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding PercentComplete, StringFormat='{}{0}%'}"
                               FontSize="11"
                               Foreground="{Binding OverallProgressBrush}"/>
                </Grid>
                <ProgressBar Value="{Binding PercentComplete}"
                             Minimum="0" Maximum="100"
                             Classes="sec-bar"
                             Foreground="{Binding OverallProgressBrush}"/>
            </StackPanel>

            <!-- Manifest -->
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Manifest integrity"
                               FontSize="11"
                               Foreground="#8BACC4"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ManifestGlyph}"
                               FontSize="11"
                               Foreground="{Binding ManifestGlyphBrush}"/>
                </Grid>
                <ProgressBar Value="{Binding ManifestProgress}"
                             Minimum="0" Maximum="100"
                             Classes="sec-bar"
                             IsIndeterminate="{Binding ManifestIsActive}"
                             Foreground="{Binding ManifestProgressBrush}"/>
            </StackPanel>

            <!-- USB health -->
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="USB health"
                               FontSize="11"
                               Foreground="#8BACC4"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding UsbHealthGlyph}"
                               FontSize="11"
                               Foreground="{Binding UsbHealthGlyphBrush}"/>
                </Grid>
                <ProgressBar Value="{Binding UsbHealthProgress}"
                             Minimum="0" Maximum="100"
                             Classes="sec-bar"
                             IsIndeterminate="{Binding UsbHealthIsActive}"
                             Foreground="{Binding UsbHealthProgressBrush}"/>
            </StackPanel>

            <!-- Hardware token -->
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Hardware token"
                               FontSize="11"
                               Foreground="#8BACC4"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding HardwareGlyph}"
                               FontSize="11"
                               Foreground="{Binding HardwareGlyphBrush}"/>
                </Grid>
                <ProgressBar Value="{Binding HardwareProgress}"
                             Minimum="0" Maximum="100"
                             Classes="sec-bar"
                             IsIndeterminate="{Binding HardwareIsActive}"
                             Foreground="{Binding HardwareProgressBrush}"/>
            </StackPanel>

            <!-- Biometric -->
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Biometric"
                               FontSize="11"
                               Foreground="#8BACC4"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding BiometricGlyph}"
                               FontSize="11"
                               Foreground="{Binding BiometricGlyphBrush}"/>
                </Grid>
                <ProgressBar Value="{Binding BiometricProgress}"
                             Minimum="0" Maximum="100"
                             Classes="sec-bar"
                             IsIndeterminate="{Binding BiometricIsActive}"
                             Foreground="{Binding BiometricProgressBrush}"/>
            </StackPanel>

            <!-- Anti-tamper -->
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Anti-tamper"
                               FontSize="11"
                               Foreground="#8BACC4"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding AntiTamperGlyph}"
                               FontSize="11"
                               Foreground="{Binding AntiTamperGlyphBrush}"/>
                </Grid>
                <ProgressBar Value="{Binding AntiTamperProgress}"
                             Minimum="0" Maximum="100"
                             Classes="sec-bar"
                             IsIndeterminate="{Binding AntiTamperIsActive}"
                             Foreground="{Binding AntiTamperProgressBrush}"/>
            </StackPanel>

            <!-- Errors / warnings inline — only shown when present -->
            <TextBlock Text="{Binding ErrorsText}"
                       FontSize="11"
                       Foreground="#C17A7A"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasErrors}"
                       Margin="0,4,0,0"/>

            <TextBlock Text="{Binding WarningsText}"
                       FontSize="11"
                       Foreground="#B8A06A"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasWarnings}"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#40071018"
                Padding="20,8"
                BorderBrush="{DynamicResource Brush.Glass.Border}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <!-- Go Back: shown only when checks finished and failed -->
                <Button Command="{Binding CancelCommand}"
                        Width="90" Height="36"
                        Classes="liquid-glass"
                        IsVisible="{Binding ChecksComplete}">
                    <TextBlock Text="Go Back"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
                <!-- Retry: shown while running or on failure -->
                <Button Command="{Binding RetryCommand}"
                        Width="90" Height="36"
                        Classes="liquid-glass"
                        IsVisible="{Binding !ChecksSuccessful}">
                    <TextBlock Text="Retry"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
                <!-- Continue: shown only on success -->
                <Button Command="{Binding ContinueCommand}"
                        Width="110" Height="36"
                        Classes="liquid-glass primary"
                        IsVisible="{Binding ChecksSuccessful}">
                    <TextBlock Text="Continue"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
