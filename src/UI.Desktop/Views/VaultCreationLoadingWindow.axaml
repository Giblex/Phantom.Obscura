<?xml version="1.0" encoding="utf-8"?>
<views:ThemeAwareWindow xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:views="clr-namespace:PhantomVault.UI.Views"
                        xmlns:controls="clr-namespace:PhantomVault.UI.Desktop.Controls"
                        x:Class="PhantomVault.UI.Views.VaultCreationLoadingWindow"
                        Title="Phantom Obscura — Creating Your Vault"
                        Width="720" Height="680"
                        MinWidth="720" MinHeight="680"
                        CanResize="False"
                        WindowStartupLocation="CenterScreen"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        Classes="animated-window"
                        SystemDecorations="Full">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Assets/Themes/PreVaultTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>

        <Style Selector="Border.pulse-ring">
            <Style.Animations>
                <Animation Duration="0:0:3.2" IterationCount="INFINITE" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.15"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.45"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.15"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.pulse-ring-delay">
            <Style.Animations>
                <Animation Duration="0:0:3.2" IterationCount="INFINITE" Easing="CubicEaseInOut" Delay="0:0:1.0">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.1"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.35"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.pulse-ring-delay2">
            <Style.Animations>
                <Animation Duration="0:0:3.2" IterationCount="INFINITE" Easing="CubicEaseInOut" Delay="0:0:2.0">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.05"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.25"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.05"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="TextBlock.fade-status">
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="INFINITE" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.5"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.progress-fill">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.6" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.check-appear">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="scale(0.5, 0.5)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" Easing="BackEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.check-appear.visible">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="scale(1, 1)"/>
        </Style>

        <Style Selector="Border.phase-step">
            <Setter Property="Opacity" Value="0.3"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.phase-step.active">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>
        <Style Selector="Border.phase-step.completed">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style Selector="Border.scan-line">
            <Setter Property="Opacity" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*">
        <Panel>

            <TextBlock x:Name="HexColumnLeft"
                       FontFamily="Consolas,Courier New,monospace"
                       FontSize="10"
                       Foreground="#0CFFFFFF"
                       LineHeight="14"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       Margin="24,20,0,20"
                       TextWrapping="Wrap"
                       Width="80"
                       ClipToBounds="True"
                       IsHitTestVisible="False"/>

            <TextBlock x:Name="HexColumnRight"
                       FontFamily="Consolas,Courier New,monospace"
                       FontSize="10"
                       Foreground="#0CFFFFFF"
                       LineHeight="14"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Stretch"
                       Margin="0,20,24,20"
                       TextWrapping="Wrap"
                       Width="80"
                       TextAlignment="Right"
                       ClipToBounds="True"
                       IsHitTestVisible="False"/>

            <Border x:Name="ScanLine"
                    Classes="scan-line"
                    Height="1"
                    VerticalAlignment="Top"
                    Margin="60,0"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#006BB3AE" Offset="0"/>
                        <GradientStop Color="#306BB3AE" Offset="0.3"/>
                        <GradientStop Color="#506BB3AE" Offset="0.5"/>
                        <GradientStop Color="#306BB3AE" Offset="0.7"/>
                        <GradientStop Color="#006BB3AE" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">

                <Panel Width="310" Height="310" HorizontalAlignment="Center">

                    <Border x:Name="PulseRing3"
                            Classes="pulse-ring-delay2"
                            Width="300" Height="300"
                            CornerRadius="150"
                            BorderBrush="#1A6BB3AE"
                            BorderThickness="1.5"
                            RenderTransformOrigin="0.5,0.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                        </Border.RenderTransform>
                    </Border>

                    <Border x:Name="PulseRing2"
                            Classes="pulse-ring-delay"
                            Width="260" Height="260"
                            CornerRadius="130"
                            BorderBrush="#2A6BB3AE"
                            BorderThickness="1.5"
                            RenderTransformOrigin="0.5,0.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                        </Border.RenderTransform>
                    </Border>

                    <Border x:Name="PulseRing1"
                            Classes="pulse-ring"
                            Width="216" Height="216"
                            CornerRadius="108"
                            BorderBrush="#406BB3AE"
                            BorderThickness="2"
                            RenderTransformOrigin="0.5,0.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                        </Border.RenderTransform>
                    </Border>

                    <Canvas x:Name="SegmentedRing"
                            Width="280" Height="280"
                            RenderTransformOrigin="0.5,0.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Canvas.RenderTransform>

                    </Canvas>

                    <Canvas x:Name="SegmentedRingInner"
                            Width="224" Height="224"
                            RenderTransformOrigin="0.5,0.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Canvas.RenderTransform>
                    </Canvas>

                    <Border x:Name="OrbitDot1"
                            Width="240" Height="240"
                            RenderTransformOrigin="0.5,0.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Border.RenderTransform>
                        <Ellipse Width="6" Height="6"
                                 Fill="#8FB5DF"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Center"/>
                    </Border>

                    <Border x:Name="OrbitDot2"
                            Width="272" Height="272"
                            RenderTransformOrigin="0.5,0.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Border.RenderTransform>
                        <Ellipse Width="4" Height="4"
                                 Fill="#6BB3AE"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Center"/>
                    </Border>

                    <Border x:Name="OrbitDot3"
                            Width="306" Height="306"
                            RenderTransformOrigin="0.5,0.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <RotateTransform Angle="180"/>
                        </Border.RenderTransform>
                        <Ellipse Width="3" Height="3"
                                 Fill="#508FB5DF"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Center"/>
                    </Border>

                    <Image Source="avares://PhantomVault.UI/Assets/Visuals/Giblex Icons/Icon Transparent background.png"
                           Width="236" Height="236"
                           Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Border x:Name="CompletionCheck"
                            Classes="check-appear"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Background="#2A4CAF50"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,0,-60,-60"
                            RenderTransformOrigin="0.5,0.5"
                            IsVisible="False">
                        <TextBlock Text="✓"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Panel>

                <TextBlock Text="Creating Your Vault"
                           x:Name="LoadingTitle"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="StatusText"
                           Text="Initializing secure environment..."
                           Classes="fade-status"
                           FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="StepDetailText"
                           Text=""
                           FontFamily="Consolas,Courier New,monospace"
                           FontSize="11"
                           Foreground="#6B8FB5DF"
                           HorizontalAlignment="Center"
                           Opacity="0.8"/>

                <Grid Width="400" HorizontalAlignment="Center" RowDefinitions="Auto,8,Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="ProgressLabel"
                                   Text="INITIALIZING"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="9"
                                   Foreground="#506BB3AE"
                                   FontWeight="Bold"
                                   LetterSpacing="2"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProgressPercent"
                                   Grid.Column="1"
                                   Text="0%"
                                   FontFamily="Consolas,Courier New,monospace"
                                   FontSize="9"
                                   Foreground="#506BB3AE"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="2" Height="3"
                            CornerRadius="1.5"
                            Background="#10FFFFFF"
                            HorizontalAlignment="Stretch">
                        <Border x:Name="ProgressFill"
                                Classes="progress-fill"
                                Width="0" Height="3"
                                CornerRadius="1.5"
                                HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Color="#6BB3AE" Offset="0"/>
                                    <GradientStop Color="#8FB5DF" Offset="0.6"/>
                                    <GradientStop Color="#A78BDF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                </Grid>

                <StackPanel x:Name="PhaseChecklist" Spacing="4" HorizontalAlignment="Center" Margin="0,4,0,0">

                </StackPanel>

                <TextBlock x:Name="HashReadout"
                           Text=""
                           FontFamily="Consolas,Courier New,monospace"
                           FontSize="9"
                           Foreground="#1AFFFFFF"
                           HorizontalAlignment="Center"
                           LetterSpacing="1"
                           Margin="0,4,0,0"/>

            </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>

</views:ThemeAwareWindow>

