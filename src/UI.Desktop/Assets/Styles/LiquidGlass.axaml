<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Giblex.Controls">

<!-- Every standard Button is glass by default. Specialised controls such as tiles and
     copy buttons replace this template later with their own purpose-built templates. -->
<Style Selector="Button">
  <Setter Property="CornerRadius" Value="10"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource LiquidGlassButtonForeground}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Background" Value="#04FFFFFF"/>
  <Setter Property="MinWidth" Value="0"/>
  <Setter Property="MinHeight" Value="0"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Transitions">
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
    </Transitions>
  </Setter>
  <Setter Property="Effect" Value="{DynamicResource LiquidGlassButtonEffect}"/>

  <Setter Property="Template">
    <ControlTemplate>
      <Panel>

        <Border Name="BaseBorder"
                CornerRadius="{TemplateBinding CornerRadius}"
                BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{DynamicResource Brush.Glass.Border}"
                Background="{DynamicResource Brush.Glass.BaseFill}"
                ClipToBounds="True">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
              <BrushTransition Property="Background" Duration="0:0:0.18"/>
              <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.18"/>
            </Transitions>
          </Border.Transitions>
        </Border>

        <Border Name="InnerShadow"
                CornerRadius="{TemplateBinding CornerRadius}"
                Opacity="0.3"
                Margin="0"
                IsHitTestVisible="False"
                ClipToBounds="True"
                Background="{DynamicResource Brush.Glass.InnerShadow}"/>

        <Border Name="Sheen"
                CornerRadius="{TemplateBinding CornerRadius}"
                Opacity="0.35"
                Margin="0"
                IsHitTestVisible="False"
                ClipToBounds="True"
                Background="{DynamicResource Brush.Glass.Sheen}">
          <Border.RenderTransform>
            <TransformGroup>
              <RotateTransform Angle="{Binding $parent[Button].(local:LiquidGlassScrollChrome.ScrollSheenAngle)}">
                <RotateTransform.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Angle" Duration="0:0:0.55" Easing="CubicEaseOut"/>
                  </Transitions>
                </RotateTransform.Transitions>
              </RotateTransform>
              <TranslateTransform X="{Binding $parent[Button].(local:LiquidGlassScrollChrome.ScrollSheenX)}"
                                  Y="{Binding $parent[Button].(local:LiquidGlassScrollChrome.ScrollSheenY)}">
                <TranslateTransform.Transitions>
                  <Transitions>
                    <DoubleTransition Property="X" Duration="0:0:0.55" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Y" Duration="0:0:0.55" Easing="CubicEaseOut"/>
                  </Transitions>
                </TranslateTransform.Transitions>
              </TranslateTransform>
            </TransformGroup>
          </Border.RenderTransform>
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
              <ThicknessTransition Property="Margin" Duration="0:0:0.25" Easing="SineEaseInOut"/>
            </Transitions>
          </Border.Transitions>
        </Border>

        <local:BorderEnergyTrace Name="BorderTrace"
                                 IsHitTestVisible="False"
                                 Progress="{Binding $parent[Button].(local:LiquidGlassScrollChrome.BorderTraceProgress)}"
                                 SecondaryProgress="{Binding $parent[Button].(local:LiquidGlassScrollChrome.SecondaryBorderTraceProgress)}"
                                 Direction="{Binding $parent[Button].(local:LiquidGlassScrollChrome.BorderTraceDirection)}"
                                 TraceOpacity="{Binding $parent[Button].(local:LiquidGlassScrollChrome.BorderRunnerOpacity)}"
                                 CornerRadius="{TemplateBinding CornerRadius}"
                                 TraceThickness="0.78"
                                 TraceColor="#B7CCD5DC"
                                 CounterTraceColor="#182434"
                                 CounterTraceOpacity="0.62"/>

        <Border Name="BottomShadow"
                CornerRadius="{TemplateBinding CornerRadius}"
                Opacity="0.65"
                Margin="0"
                IsHitTestVisible="False"
                ClipToBounds="True"
                Background="{DynamicResource Brush.Glass.BottomShadow}"/>

        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{x:Null}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          RecognizesAccessKey="True"/>

        <Border Name="DisabledMask"
                IsVisible="False"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="#66000000"/>
      </Panel>
    </ControlTemplate>
  </Setter>
</Style>

<Style Selector="Button /template/ Panel">
  <Setter Property="ClipToBounds" Value="True"/>
</Style>

<Style Selector="Button:pointerover">
  <Setter Property="CornerRadius" Value="10"/>
  <Setter Property="Effect" Value="{DynamicResource LiquidGlassButtonEffectHover}"/>
</Style>

<Style Selector="Button:pointerover /template/ Border#BaseBorder">
  <Setter Property="CornerRadius" Value="10"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.BorderHover}"/>
  <Setter Property="Background" Value="{DynamicResource Brush.Glass.BaseFillHover}"/>
</Style>

<Style Selector="Button:pointerover /template/ Border#Sheen">
  <Setter Property="Opacity" Value="0.8"/>
</Style>

<Style Selector="Button:pressed /template/ Border#BaseBorder">
  <Setter Property="CornerRadius" Value="10"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.BorderPressed}"/>
  <Setter Property="Background" Value="{DynamicResource Brush.Glass.BaseFillPressed}"/>
</Style>

<Style Selector="Button:pressed /template/ Border#Sheen">
  <Setter Property="Opacity" Value="0.4"/>
</Style>

<Style Selector="Button:pressed">
  <Setter Property="RenderTransform">
    <TranslateTransform Y="1"/>
  </Setter>
  <Setter Property="Effect" Value="{DynamicResource LiquidGlassButtonEffectPressed}"/>
</Style>

<Style Selector="Button:disabled">
  <Setter Property="Opacity" Value="0.5"/>
  <Setter Property="Cursor" Value="Arrow"/>
</Style>

<Style Selector="Button:disabled /template/ Border#DisabledMask">
  <Setter Property="IsVisible" Value="True"/>
</Style>

<Style Selector="Button:focus-visible">
  <Setter Property="Opacity" Value="1.0"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.BorderFocus}"/>
  <Setter Property="BorderThickness" Value="2"/>
  <Setter Property="CornerRadius" Value="10"/>
</Style>

<Style Selector="Button:focus-visible /template/ Border#BaseBorder">
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.BorderFocus}"/>
  <Setter Property="BorderThickness" Value="2"/>
  <Setter Property="CornerRadius" Value="10"/>
</Style>

<Style Selector="Button.primary /template/ Border#BaseBorder">
  <Setter Property="BorderBrush" Value="#60C8D5E0"/>
  <Setter Property="Background">
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#50C8D5E0" Offset="0"/>
      <GradientStop Color="#30C8D5E0" Offset="1"/>
    </LinearGradientBrush>
  </Setter>
</Style>

<Style Selector="Button.primary:pointerover /template/ Border#BaseBorder">
  <Setter Property="BorderBrush" Value="#70C8D5E0"/>
  <Setter Property="Background">
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#60C8D5E0" Offset="0"/>
      <GradientStop Color="#40C8D5E0" Offset="1"/>
    </LinearGradientBrush>
  </Setter>
</Style>

<Style Selector="Button.danger /template/ Border#BaseBorder">
  <Setter Property="BorderBrush" Value="#70DC3545"/>
  <Setter Property="Background">
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#60DC3545" Offset="0"/>
      <GradientStop Color="#40DC3545" Offset="1"/>
    </LinearGradientBrush>
  </Setter>
</Style>

<Style Selector="Button.danger:pointerover /template/ Border#BaseBorder">
  <Setter Property="BorderBrush" Value="#80DC3545"/>
  <Setter Property="Background">
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#70DC3545" Offset="0"/>
      <GradientStop Color="#50DC3545" Offset="1"/>
    </LinearGradientBrush>
  </Setter>
</Style>

<Style Selector="Button.compact">
  <Setter Property="CornerRadius" Value="8"/>
  <Setter Property="MinHeight" Value="32"/>
  <Setter Property="Padding" Value="12,6"/>
  <Setter Property="FontSize" Value="13"/>
</Style>

<Style Selector="Button.icon">
  <Setter Property="CornerRadius" Value="10"/>
  <Setter Property="MinHeight" Value="36"/>
  <Setter Property="MinWidth" Value="36"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
</Style>

<Style Selector="Button.sidebar">
  <Setter Property="CornerRadius" Value="16"/>
  <Setter Property="Padding" Value="14,10"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
</Style>

<Style Selector="Button.sidebar /template/ Border#BaseBorder">
  <Setter Property="Background">
    <RadialGradientBrush Center="35%,40%" RadiusX="80%" RadiusY="80%">
      <GradientStop Color="#06FFFFFF" Offset="0"/>
      <GradientStop Color="#04FFFFFF" Offset="0.5"/>
      <GradientStop Color="#02FFFFFF" Offset="0.8"/>
      <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
  </Setter>
  <Setter Property="BorderBrush" Value="#18FFFFFF"/>
</Style>

<Style Selector="Button.sidebar:pointerover /template/ Border#BaseBorder">
  <Setter Property="Background">
    <RadialGradientBrush Center="35%,40%" RadiusX="80%" RadiusY="80%">
      <GradientStop Color="#0CFFFFFF" Offset="0"/>
      <GradientStop Color="#08FFFFFF" Offset="0.5"/>
      <GradientStop Color="#04FFFFFF" Offset="0.8"/>
      <GradientStop Color="#02FFFFFF" Offset="1"/>
    </RadialGradientBrush>
  </Setter>
  <Setter Property="BorderBrush" Value="#28FFFFFF"/>
</Style>

<Style Selector="Button.sidebar:pressed /template/ Border#BaseBorder">
  <Setter Property="Background">
    <RadialGradientBrush Center="35%,40%" RadiusX="80%" RadiusY="80%">
      <GradientStop Color="#04FFFFFF" Offset="0"/>
      <GradientStop Color="#02FFFFFF" Offset="0.5"/>
      <GradientStop Color="#01FFFFFF" Offset="0.8"/>
      <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
  </Setter>
  <Setter Property="BorderBrush" Value="#10FFFFFF"/>
</Style>

<Style Selector="Button.tile-button">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="CornerRadius" Value="0"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="MinHeight" Value="0"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Template">
    <ControlTemplate>
      <ContentPresenter Name="PART_ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Margin="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        RecognizesAccessKey="True"/>
    </ControlTemplate>
  </Setter>
  <Setter Property="Transitions">
    <Transitions>
      <BrushTransition Property="Background" Duration="0:0:0.2"/>
    </Transitions>
  </Setter>
</Style>

<Style Selector="Button.tile-button:pointerover">
  <Setter Property="Background" Value="{DynamicResource TileHoverBrush}"/>
</Style>

<Style Selector="Button.tile-button:pressed">
  <Setter Property="Background" Value="{DynamicResource TilePressedBrush}"/>
</Style>

<Style Selector="Button.tile-button-grid">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="CornerRadius" Value="8"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="MinHeight" Value="0"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Template">
    <ControlTemplate>
      <ContentPresenter Name="PART_ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Margin="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        RecognizesAccessKey="True"/>
    </ControlTemplate>
  </Setter>
  <Setter Property="Transitions">
    <Transitions>
      <BrushTransition Property="Background" Duration="0:0:0.2"/>
    </Transitions>
  </Setter>
</Style>

<Style Selector="Button.tile-button-grid:pointerover">
  <Setter Property="Background" Value="{DynamicResource TileHoverBrush}"/>
</Style>

<Style Selector="Button.tile-button-grid:pressed">
  <Setter Property="Background" Value="{DynamicResource TilePressedBrush}"/>
</Style>

<Style Selector="Button.tile-button:focus-visible, Button.tile-button-grid:focus-visible">
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}"/>
  <Setter Property="BorderThickness" Value="2 0 0 0"/>
</Style>

<Style Selector="ToggleButton.liquid-glass">
  <Setter Property="CornerRadius" Value="10"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource LiquidGlassButtonForeground}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="MinHeight" Value="40"/>
  <Setter Property="Padding" Value="16,8"/>
  <Setter Property="Background" Value="#04FFFFFF"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>

  <Setter Property="Template">
    <ControlTemplate>
      <Panel ClipToBounds="True">
        <Border Name="BaseBorder"
                CornerRadius="{TemplateBinding CornerRadius}"
                BorderThickness="{TemplateBinding BorderThickness}"
                BorderBrush="{DynamicResource Brush.Glass.Border}"
                Background="{DynamicResource Brush.Glass.BaseFill}"
                ClipToBounds="True">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
              <BrushTransition Property="Background" Duration="0:0:0.18"/>
            </Transitions>
          </Border.Transitions>
        </Border>

        <Border Name="Sheen"
                CornerRadius="{TemplateBinding CornerRadius}"
                Opacity="0.45"
                Margin="0"
                IsHitTestVisible="False"
                ClipToBounds="True"
                Background="{DynamicResource Brush.Glass.Sheen}"/>

        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{x:Null}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          RecognizesAccessKey="True"/>
      </Panel>
    </ControlTemplate>
  </Setter>
</Style>

<Style Selector="ToggleButton.liquid-glass:pointerover /template/ Border#BaseBorder">
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.BorderHover}"/>
  <Setter Property="Background" Value="{DynamicResource Brush.Glass.BaseFillHover}"/>
</Style>

<Style Selector="ToggleButton.liquid-glass:pointerover /template/ Border#Sheen">
  <Setter Property="Opacity" Value="0.8"/>
</Style>

<Style Selector="ToggleButton.liquid-glass:checked /template/ Border#BaseBorder">
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.BorderHover}"/>
  <Setter Property="Background" Value="{DynamicResource Brush.Glass.BaseFillChecked}"/>
</Style>

<Style Selector="ToggleButton.liquid-glass:checked /template/ Border#Sheen">
  <Setter Property="Opacity" Value="0.9"/>
</Style>

<Style Selector="ToggleButton.liquid-glass:pressed /template/ Border#BaseBorder">
  <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.BorderPressed}"/>
  <Setter Property="Background" Value="{DynamicResource Brush.Glass.BaseFillPressed}"/>
</Style>

<Style Selector="ToggleButton.liquid-glass:pressed /template/ Border#Sheen">
  <Setter Property="Opacity" Value="0.3"/>
</Style>

<Style Selector="ToggleButton.liquid-glass:pressed">
  <Setter Property="RenderTransform">
    <TranslateTransform Y="1"/>
  </Setter>
</Style>

<Style Selector="ToggleButton.liquid-glass:disabled">
  <Setter Property="Opacity" Value="0.5"/>
  <Setter Property="Cursor" Value="Arrow"/>
</Style>

</Styles>

