    <Color x:Key="Color.Navy500">#FCE4D4</Color>
    <Color x:Key="Color.Navy400">#EEC9B5</Color>

    <Color x:Key="Color.TextPrimary">#4A241D</Color>
    <Color x:Key="Color.TextMuted">#8B6257</Color>
    <Color x:Key="Color.TextOnDark">#FFF9F0</Color>
    <Color x:Key="Color.TextOnLight">#4A241D</Color>

    <Color x:Key="Color.Accent">#EF5A3C</Color>
