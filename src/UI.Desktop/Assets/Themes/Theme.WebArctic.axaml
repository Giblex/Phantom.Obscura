<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Phantom Obscura website palette: Arctic -->

    <Color x:Key="Color.Navy900">#080E14</Color>
    <Color x:Key="Color.Navy800">#0B121A</Color>
    <Color x:Key="Color.Navy700">#0E1620</Color>
    <Color x:Key="Color.Navy600">#14202E</Color>
    <Color x:Key="Color.Navy500">#1C2B3A</Color>
    <Color x:Key="Color.Navy400">#243646</Color>

    <Color x:Key="Color.TextPrimary">#E9F2F5</Color>
    <Color x:Key="Color.TextMuted">#8DA8B4</Color>
    <Color x:Key="Color.TextOnDark">#E9F2F5</Color>
    <Color x:Key="Color.TextOnLight">#080E14</Color>

    <Color x:Key="Color.Accent">#88E0EE</Color>
    <Color x:Key="Color.AccentHover">#AEEAF4</Color>
    <Color x:Key="Color.AccentDim">#5F9CA6</Color>

    <Color x:Key="Color.Success">#A2E8C0</Color>
    <Color x:Key="Color.Warning">#E0B15A</Color>
    <Color x:Key="Color.Danger">#E0796A</Color>
    <Color x:Key="Color.Info">#60A5FA</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1620"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#05090E"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#05090E"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#14202E"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#14202E"/>
    <SolidColorBrush x:Key="SettingsPanelBackgroundBrush" Color="#14202E"/>
    <SolidColorBrush x:Key="SettingsPanelBorderBrush" Color="#243646"/>
    <SolidColorBrush x:Key="TileGlassBrush" Color="#14202E"/>
    <SolidColorBrush x:Key="TileGapBrush" Color="#0E1620"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#88E0EE"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#AEEAF4"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#5F9CA6"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.BorderSoft" Color="#243646"/>

    <Color x:Key="PrimaryTextColor">#E9F2F5</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E9F2F5"/>
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="#080E14"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#E9F2F5"/>
    <SolidColorBrush x:Key="HeaderMutedTextBrush" Color="#BACAD2"/>
    <SolidColorBrush x:Key="FooterTextBrush" Color="#E9F2F5"/>
    <SolidColorBrush x:Key="FooterMutedTextBrush" Color="#BACAD2"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#BACAD2"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8DA8B4"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#62757D"/>

    <SolidColorBrush x:Key="HeaderButtonBackgroundBrush" Color="#14202E"/>
    <SolidColorBrush x:Key="HeaderButtonHoverBrush" Color="#1C2B3A"/>
    <SolidColorBrush x:Key="HeaderButtonPressedBrush" Color="#0E1620"/>
    <SolidColorBrush x:Key="HeaderButtonForegroundBrush" Color="#E9F2F5"/>
    <SolidColorBrush x:Key="HeaderButtonBorderBrush">#5514202E</SolidColorBrush>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#060B10"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#0A1018"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#060B10"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#E9F2F5"/>
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#5088E0EE"/>
    <SolidColorBrush x:Key="TextCaretBrush" Color="#88E0EE"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#243646"/>
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B0080E14"/>
    <SolidColorBrush x:Key="ReadOnlyFieldBackgroundBrush" Color="#14202E"/>
    <SolidColorBrush x:Key="ReadOnlyFieldForegroundBrush" Color="#BACAD2"/>
    <SolidColorBrush x:Key="CategoryPanelBackgroundBrush" Color="#0E1620"/>
    <SolidColorBrush x:Key="HighContrastBorderBrush" Color="#00000000"/>

    <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#1C2B3A"/>
    <SolidColorBrush x:Key="TextBoxBackgroundHoverBrush" Color="#243646"/>
    <SolidColorBrush x:Key="TextBoxBackgroundFocusedBrush" Color="#243646"/>
    <SolidColorBrush x:Key="TextBoxBackgroundDisabledBrush" Color="#14202E"/>
    <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#243646"/>
    <SolidColorBrush x:Key="TextBoxBorderHoverBrush" Color="#88E0EE"/>
    <SolidColorBrush x:Key="TextBoxBorderFocusedBrush" Color="#88E0EE"/>
    <SolidColorBrush x:Key="TextBrush" Color="#020406"/>

    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#0A1118"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#243646"/>

    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonAccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonSecondaryForegroundBrush" Color="#E9F2F5"/>
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#62757D"/>

    <SolidColorBrush x:Key="ContentTextBrush" Color="#E9F2F5"/>
    <SolidColorBrush x:Key="ContentSecondaryTextBrush" Color="#BACAD2"/>
    <SolidColorBrush x:Key="ContentMutedTextBrush" Color="#8DA8B4"/>
    <SolidColorBrush x:Key="CardTextBrush" Color="#E9F2F5"/>
    <SolidColorBrush x:Key="CardSecondaryTextBrush" Color="#BACAD2"/>

    <SolidColorBrush x:Key="InputTextBrush" Color="#020406"/>
    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#62757D"/>
    <SolidColorBrush x:Key="LabelTextBrush" Color="#E9F2F5"/>

    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FDFEFE"/>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FDFEFE"/>
    <!-- Was #FDFEFE, near-white, paired with near-white InputForegroundBrush (#E9F2F5) —
         near-zero contrast. Matched to InputBackgroundBrush's dark surface instead. -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#101A22"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#101A22"/>
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#FDFEFE"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#020406"/>
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#020406"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#020406"/>
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#020406"/>

    <SolidColorBrush x:Key="ListItemTextBrush" Color="#E9F2F5"/>
    <SolidColorBrush x:Key="ListItemSecondaryTextBrush" Color="#8DA8B4"/>
    <SolidColorBrush x:Key="ListItemSelectedTextBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ButtonWhiteBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SeparatorBrush">#3088E0EE</SolidColorBrush>
    <SolidColorBrush x:Key="CardSeparatorBrush" Color="#00000000"/>

    <SolidColorBrush x:Key="QuickFilterGlassBrush">#00FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="QuickFilterGlassHoverBrush">#1888E0EE</SolidColorBrush>
    <SolidColorBrush x:Key="QuickFilterGlassActiveBrush">#3088E0EE</SolidColorBrush>
    <SolidColorBrush x:Key="QuickFilterGlassActiveHoverBrush">#4088E0EE</SolidColorBrush>
    <SolidColorBrush x:Key="QuickFilterGlassBorderBrush">#3088E0EE</SolidColorBrush>
    <SolidColorBrush x:Key="QuickFilterGlassActiveBorderBrush">#5088E0EE</SolidColorBrush>

    <SolidColorBrush x:Key="SuccessBrush" Color="#A2E8C0"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E0B15A"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E0796A"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#0E1721"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#0E1721"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#0E1721"/>
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#0E1721"/>

    <FontFamily x:Key="MainFontFamily">Segoe UI</FontFamily>

    <Color x:Key="GlobalShadowColor">#020406</Color>
    <Color x:Key="HeaderAccentColor">#14202E</Color>

    <DropShadowEffect x:Key="DarkSubtleDropShadow" Color="#020406" Opacity="0.4" BlurRadius="22"/>
    <DropShadowEffect x:Key="SubtleDropShadow" Color="#020406" Opacity="0.4" BlurRadius="22"/>
    <DropShadowEffect x:Key="DarkButtonShadow" Color="#020406" Opacity="0.4" BlurRadius="16"/>
    <DropShadowEffect x:Key="DarkButtonShadowHover" Color="#88E0EE" Opacity="0.12" BlurRadius="20"/>
    <DropShadowEffect x:Key="DarkButtonShadowPressed" Color="#020406" Opacity="0.2" BlurRadius="10"/>
    <DropShadowEffect x:Key="HoverMenuDropShadow" Color="#020406" Opacity="0.4" BlurRadius="14"/>
    <DropShadowEffect x:Key="TileActiveShadow" Color="#88E0EE" Opacity="0.1" BlurRadius="32"/>
    <DropShadowEffect x:Key="TileActiveShadowPressed" Color="#020406" Opacity="0.2" BlurRadius="16"/>
    <DropShadowEffect x:Key="FrontPageTileBaseShadow" Color="#020406" Opacity="0.4" BlurRadius="20"/>
    <DropShadowEffect x:Key="FooterGroundedShadow" Color="#020406" Opacity="0.4" BlurRadius="10"/>

    <BoxShadows x:Key="SlideOutPanelShadow">-20 0 40 -5 #80000000</BoxShadows>
    <BoxShadows x:Key="FlaggedPanelShadow">-16 0 32 -4 #80000000</BoxShadows>

    <LinearGradientBrush x:Key="TileOverlayBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1888E0EE" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- ==========================================================================
         Glass + dashboard layer derived from this theme's palette.

         These 56 keys were previously absent from every Theme.Web* dictionary, so
         they fell through to the app-level PhantomTheme overlay. Nothing visibly
         broke, but the glass surfaces, dashboard tiles and liquid-glass buttons
         kept the generic dark values regardless of the selected theme - so picking
         Ember or Arctic changed the palette everywhere except the surfaces that
         actually carry the brand.

         Every value below is derived from this theme's own Navy ramp and accent,
         so the glass layer now re-tints with the rest of the theme.
         ========================================================================== -->

    <!-- Glass tint ramp -->
    <Color x:Key="Glass.Tint.Deepest">#080E14</Color>
    <Color x:Key="Glass.Tint.Dark">#0B121A</Color>
    <Color x:Key="Glass.Tint.Mid">#0E1620</Color>
    <Color x:Key="Glass.Tint.Light">#14202E</Color>

    <!-- Sheen ramp (neutral white highlights over the tinted ground) -->
    <SolidColorBrush x:Key="Glass.Sheen.Bright" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Glass.Sheen.Mid" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Glass.Sheen.Soft" Color="#12FFFFFF"/>

    <!-- Glass body fills -->
    <LinearGradientBrush x:Key="Brush.Glass.BaseFill" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#6614202E" Offset="0"/>
        <GradientStop Color="#4D0E1620" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Glass.BaseFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#801C2B3A" Offset="0"/>
        <GradientStop Color="#6614202E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Glass.BaseFillPressed" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#990E1620" Offset="0"/>
        <GradientStop Color="#800B121A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Glass.BaseFillChecked" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#5988E0EE" Offset="0"/>
        <GradientStop Color="#3D88E0EE" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glass edges -->
    <SolidColorBrush x:Key="Brush.Glass.Border" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Glass.BorderHover" Color="#6688E0EE"/>
    <SolidColorBrush x:Key="Brush.Glass.BorderPressed" Color="#8C88E0EE"/>
    <SolidColorBrush x:Key="Brush.Glass.BorderFocus" Color="#B3AEEAF4"/>
    <SolidColorBrush x:Key="Brush.Glass.EdgeHighlightBorder" Color="#26FFFFFF"/>
    <Color x:Key="Brush.Glass.EdgeHighlight.Start">#38FFFFFF</Color>
    <Color x:Key="Brush.Glass.EdgeHighlight.Mid">#1AFFFFFF</Color>
    <Color x:Key="Brush.Glass.EdgeHighlight.End">#00FFFFFF</Color>

    <!-- Glass depth -->
    <SolidColorBrush x:Key="Brush.Glass.Sheen" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Glass.InnerShadow" Color="#40080E14"/>
    <SolidColorBrush x:Key="Brush.Glass.BottomShadow" Color="#59080E14"/>

    <!-- Liquid-glass button treatment -->
    <SolidColorBrush x:Key="LiquidGlassButtonForeground" Color="#E9F2F5"/>
    <DropShadowEffect x:Key="LiquidGlassButtonEffect" BlurRadius="18" OffsetX="0" OffsetY="4" Color="#4D080E14"/>
    <DropShadowEffect x:Key="LiquidGlassButtonEffectHover" BlurRadius="26" OffsetX="0" OffsetY="6" Color="#5988E0EE"/>
    <DropShadowEffect x:Key="LiquidGlassButtonEffectPressed" BlurRadius="12" OffsetX="0" OffsetY="2" Color="#66080E14"/>
    <DropShadowEffect x:Key="LiquidGlassDropShadow" BlurRadius="18" OffsetX="0" OffsetY="4" Color="#4D080E14"/>
    <DropShadowEffect x:Key="LiquidGlassDropShadowHover" BlurRadius="26" OffsetX="0" OffsetY="6" Color="#5988E0EE"/>
    <DropShadowEffect x:Key="LiquidGlassDropShadowPressed" BlurRadius="12" OffsetX="0" OffsetY="2" Color="#66080E14"/>

    <!-- Dashboard chrome -->
    <SolidColorBrush x:Key="DashboardPanelBg" Color="#CC0B121A"/>
    <SolidColorBrush x:Key="DashboardPanelBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="DashboardSectionBg" Color="#B30E1620"/>
    <SolidColorBrush x:Key="DashboardSectionBorderBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="DashboardSectionHoverBg" Color="#CC14202E"/>
    <SolidColorBrush x:Key="DashboardSectionHoverBorderBrush" Color="#5988E0EE"/>
    <SolidColorBrush x:Key="DashboardCardBg" Color="#B314202E"/>
    <SolidColorBrush x:Key="DashboardCardHoverBg" Color="#CC1C2B3A"/>
    <SolidColorBrush x:Key="DashboardCardPressedBg" Color="#CC0E1620"/>
    <SolidColorBrush x:Key="DashboardNavBg" Color="#990E1620"/>
    <SolidColorBrush x:Key="DashboardNavHoverBg" Color="#B31C2B3A"/>
    <SolidColorBrush x:Key="DashboardNavPressedBg" Color="#CC0B121A"/>
    <SolidColorBrush x:Key="DashboardNavPrimaryBg" Color="#5988E0EE"/>
    <SolidColorBrush x:Key="DashboardNavPrimaryBorderBrush" Color="#8C88E0EE"/>
    <LinearGradientBrush x:Key="DashboardTileBg" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#B314202E" Offset="0"/>
        <GradientStop Color="#990E1620" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DashboardTileHoverBg" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#CC1C2B3A" Offset="0"/>
        <GradientStop Color="#B314202E" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="DashboardTileBorderColor">#33FFFFFF</Color>
    <Color x:Key="DashboardTileHoverBorderColor">#6688E0EE</Color>
    <Color x:Key="DashboardAcrylicTint">#0E1620</Color>
    <Color x:Key="DashboardAcrylicFallback">#140E1620</Color>

    <!-- Misc keys the shared views expect -->
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#F48771"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#A2E8C0"/>
    <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#801C2B3A"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#9914202E"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#5988E0EE"/>

    <!-- Surface overlay + header tokens derived from this theme's own palette.

         These were previously defined only in the app-level PhantomTheme fallback, so
         they never re-tinted with the selected skin — and because that fallback is
         chosen by the light/dark variant rather than by the skin, a light skin could
         receive dark-theme overlay values and render hover states invisibly. -->
    <SolidColorBrush x:Key="SubtleBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0B121A"/>
    <SolidColorBrush x:Key="HeaderPrimaryBrush" Color="#0E1620"/>

</ResourceDictionary>
