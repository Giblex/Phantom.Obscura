<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Giblex.Controls"
             x:Class="PhantomVault.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhantomVault.UI/Resources/Strings.en-US.axaml"/>
                <ResourceInclude Source="avares://Phantom.UI.Shared/Icons/VectorIcons.axaml"/>
                <!-- App-wide, so every window can use the shared converters. The icon picker
                     referenced IconPathToBitmapConverter without merging this file itself,
                     threw on layout and took the app down when adding an entry. -->
                <ResourceInclude Source="avares://PhantomVault.UI/Resources/Converters/ConverterResources.axaml"/>

            </ResourceDictionary.MergedDictionaries>

            <!-- Elevation that differs by light/dark. These surfaces had pure-black shadows
                 tuned for the dark page (up to 92% black), which read as heavy grey slabs on a
                 light background. Dark keeps the original values; Light uses faint navy-tinted
                 shadows with a negative spread so they hug each card's rounded corners. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <BoxShadows x:Key="Shadow.SettingsPanel">-46 0 150 -10 #EA000000, -22 0 60 -8 #C0000000, -8 0 22 -4 #90000000</BoxShadows>
                    <SolidColorBrush x:Key="Brush.SettingsPanelEdge" Color="#55000000"/>
                    <BoxShadows x:Key="Shadow.SettingsHeader">0 6 18 -4 #80000000, 0 2 6 -2 #60000000</BoxShadows>
                    <BoxShadows x:Key="Shadow.SettingsCard">0 5 20 0 #52000000</BoxShadows>
                    <BoxShadows x:Key="Shadow.ListTile">0 9 18 -5 #A0000000, 0 3 7 -2 #80000000</BoxShadows>
                    <BoxShadows x:Key="Shadow.GridTile">0 10 24 -6 #B0000000, 0 3 8 -2 #80000000, inset 0 1 0 0 #35FFFFFF, inset 0 -1 0 0 #40000000</BoxShadows>
                    <!-- Kept within the header card's 8px margin so it never reaches (and gets
                         cut square at) the list column's edge. -->
                    <BoxShadows x:Key="Shadow.ListHeader">0 4 10 -5 #80000000</BoxShadows>
                    <!-- A flat inset "shadow" with a huge spread fills the panel with a faint white
                         lift over whatever WindowBackgroundBrush the theme uses (solid or gradient),
                         lightening the sidebar and display column without replacing the brush. -->
                    <!-- Real layers (inset BoxShadows did not render here). PanelLift is painted
                         as the sidebar's and detail column's scroll background, over the window
                         brush, to lighten both panels. SearchWellShade darkens the top of the
                         search field and fades down, so it reads as recessed. -->
                    <!-- Blue, not white: white over the navy washed it out to grey. -->
                    <SolidColorBrush x:Key="Brush.PanelLift" Color="#245B8FD6"/>
                    <!-- Sidebar / detail view: the same blue lift plus a faint dot every 8px (the
                         website pattern, fainter than the window's), as one tiled brush. -->
                    <DrawingBrush x:Key="Brush.PanelLiftDots" TileMode="Tile" Stretch="None"
                                  SourceRect="0,0,8,8" DestinationRect="0,0,8,8">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#245B8FD6">
                                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#16FFFFFF">
                                    <GeometryDrawing.Geometry><EllipseGeometry Rect="0,0,1.5,1.5"/></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                    <!-- Copy-on-click fields in the display view: hover is a slightly deeper blue
                         than the resting field (not Fluent's near-black), with a faint edge. -->
                    <SolidColorBrush x:Key="Brush.CopyFieldHover" Color="#2E3D6E9E"/>
                    <SolidColorBrush x:Key="Brush.CopyFieldPressed" Color="#403D6E9E"/>
                    <SolidColorBrush x:Key="Brush.CopyFieldHoverBorder" Color="#4D7FAEDC"/>
                    <LinearGradientBrush x:Key="Brush.SearchWellShade" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#8C000000"/>
                        <GradientStop Offset="0.5" Color="#33000000"/>
                        <GradientStop Offset="1" Color="#1A000000"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <BoxShadows x:Key="Shadow.SettingsPanel">-24 0 60 -16 #33203040, -6 0 18 -6 #1A203040</BoxShadows>
                    <SolidColorBrush x:Key="Brush.SettingsPanelEdge" Color="#1F203040"/>
                    <BoxShadows x:Key="Shadow.SettingsHeader">0 4 12 -6 #1F203040</BoxShadows>
                    <BoxShadows x:Key="Shadow.SettingsCard">0 6 18 -8 #24203040, 0 1 3 0 #12203040</BoxShadows>
                    <BoxShadows x:Key="Shadow.ListTile">0 4 10 -6 #1F203040, 0 1 2 0 #10203040</BoxShadows>
                    <BoxShadows x:Key="Shadow.GridTile">0 8 20 -10 #26203040, 0 1 3 0 #14203040, inset 0 1 0 0 #99FFFFFF</BoxShadows>
                    <BoxShadows x:Key="Shadow.ListHeader">0 4 10 -5 #26203040</BoxShadows>
                    <SolidColorBrush x:Key="Brush.PanelLift" Color="#33FFFFFF"/>
                    <DrawingBrush x:Key="Brush.PanelLiftDots" TileMode="Tile" Stretch="None"
                                  SourceRect="0,0,8,8" DestinationRect="0,0,8,8">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#33FFFFFF">
                                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8"/></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#14203040">
                                    <GeometryDrawing.Geometry><EllipseGeometry Rect="0,0,1.5,1.5"/></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                    <SolidColorBrush x:Key="Brush.CopyFieldHover" Color="#1A2F6FB0"/>
                    <SolidColorBrush x:Key="Brush.CopyFieldPressed" Color="#282F6FB0"/>
                    <SolidColorBrush x:Key="Brush.CopyFieldHoverBorder" Color="#4D5C8FC8"/>
                    <LinearGradientBrush x:Key="Brush.SearchWellShade" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#33203040"/>
                        <GradientStop Offset="0.5" Color="#12203040"/>
                        <GradientStop Offset="1" Color="#00203040"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>
            <x:Double x:Key="ToolTipFontSize">12</x:Double>
            <x:Boolean x:Key="ScrollBarAllowAutoHide">True</x:Boolean>

            <!-- Was previously declared in a second <Application.Resources> element after
                 <Application.Styles>. Two property elements for the same property is
                 ambiguous — depending on loader behaviour the later one can replace the
                 earlier, which would have silently dropped the Strings and VectorIcons
                 merges above. Folded in here so there is exactly one declaration. -->
            <ExperimentalAcrylicMaterial x:Key="LiquidAcrylic"
                                         TintColor="#9FD8FF"
                                         TintOpacity="0.18"
                                         MaterialOpacity="0.38"
                                         FallbackColor="#66FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>

    <FluentTheme />

        <!-- Colour wheel used by the icon library. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <Style Selector="ToolTip">
            <Setter Property="FontSize" Value="{DynamicResource ToolTipFontSize}"/>
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="{DynamicResource ScrollBarAllowAutoHide}"/>
        </Style>

        <StyleInclude Source="avares://PhantomVault.UI/Assets/Styles/LiquidGlass.axaml" />

        <StyleInclude Source="avares://PhantomVault.UI/Assets/Animations/ModernAnimations.axaml" />

        <StyleInclude Source="avares://PhantomVault.UI/Styles/Animations.axaml" />

        <StyleInclude Source="avares://PhantomVault.UI/Assets/Styles/GlobalStyles.axaml" />

        <!-- After GlobalStyles so these templates win for CheckBox/RadioButton/ToggleSwitch. -->
        <StyleInclude Source="avares://PhantomVault.UI/Resources/Styles/SelectionControls.axaml" />

        <StyleInclude Source="avares://PhantomVault.UI/Styles/EntryFormStyles.axaml" />

        <Style Selector="Window.animated-window">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Window.animated-window[IsVisible=True]:not(.reduce-motion)">
            <Style.Animations>
                <Animation Duration="0:0:0.35" FillMode="Forward" Easing="0.16,1,0.3,1">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Window.animated-window.reduce-motion[IsVisible=True]">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Border.overlay-fade">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Window:not(.reduce-motion) Border.overlay-fade[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.20" FillMode="Forward" Easing="SineEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Window.reduce-motion Border.overlay-fade[IsVisible=True]">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Control.fade-toggle">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Window:not(.reduce-motion) Control.fade-toggle[IsVisible=True]">
            <Style.Animations>
                <Animation Duration="0:0:0.16" FillMode="Forward" Easing="SineEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Window.reduce-motion Control.fade-toggle[IsVisible=True]">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Reduce Transparency (accessibility). The liquid-glass look is intentional
             brand identity, so this does not remove it — it replaces the translucent
             glass fills and sheen with opaque equivalents drawn from the active theme,
             which keeps the shape and depth language while removing the see-through
             layering that causes legibility problems. Applied as a window class by
             ThemeAwareWindow whenever AccessibilityService.ReduceTransparency is on. -->
        <!-- Implemented with direct property Setters rather than by overriding the
             Brush.Glass.* keys in Style.Resources. A Setter value resolves through the
             normal control -> window -> application lookup chain, which is reliable;
             a DynamicResource used as the Color of a brush declared inside Style.Resources
             is a far more fragile lookup and fails to an invisible surface, which is worse
             than the problem being solved. -->

        <!-- Liquid-glass buttons: opaque body, solid border, no sheen/blur. -->
        <Style Selector="Window.reduce-transparency Button">
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        <Style Selector="Window.reduce-transparency Button /template/ Border#BaseBorder">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Window.reduce-transparency Button:pointerover /template/ Border#BaseBorder">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UserAccentBrush}"/>
        </Style>
        <Style Selector="Window.reduce-transparency Button:pressed /template/ Border#BaseBorder">
            <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}"/>
        </Style>
        <Style Selector="Window.reduce-transparency Button /template/ Border#Sheen">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <!-- Glass and surface cards drop to their opaque card equivalents. -->
        <Style Selector="Window.reduce-transparency Border.glass-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Soft}"/>
        </Style>
        <Style Selector="Window.reduce-transparency Border.surface-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>
        <Style Selector="Window.reduce-transparency Border.panel">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        </Style>
        <Style Selector="Window.reduce-transparency Border.nav-bar">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}"/>
        </Style>
        <Style Selector="Window.reduce-transparency Border.hero">
            <Setter Property="Background" Value="{DynamicResource HeaderPrimaryBrush}"/>
        </Style>

        <!-- Acrylic composites against whatever sits behind the window, which is the
             single largest source of see-through. Force it off. -->
        <Style Selector="Window.reduce-transparency ExperimentalAcrylicBorder">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Deliberately NOT forcing TransparencyLevelHint/Background on the window
             itself. Some windows use window transparency for their *shape* rather than
             for decoration — the unlock dialog is an undecorated circle that relies on
             a transparent background to not be a square — so blanket-disabling it turns
             a shaped dialog into an opaque rectangle. Reduce Transparency is about
             see-through *surfaces*, which the acrylic and glass rules above handle. -->
        <Style Selector="Window.reduce-transparency:not(.shaped-window) Border.app-chrome">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        </Style>

        <Style Selector="Window.flat-buttons Button">
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource UserAccentBrush}"/>
        </Style>
        <Style Selector="Window.flat-buttons Button /template/ Border#BaseBorder">
            <Setter Property="Background" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Window.flat-buttons Button /template/ Border#Sheen">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Window.flat-buttons Button:pointerover /template/ Border#BaseBorder">
            <Setter Property="Background" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Window.flat-buttons Button:pressed /template/ Border#BaseBorder">
            <Setter Property="Background" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Flat button BORDERS only — keep the liquid-glass body fill but replace the
             glass-gradient border with a standard flat 1px border, drop all the shadow
             depth (inner shadow, bottom shadow, drop-shadow glow effect, sheen highlight,
             animated border-trace runner) and remove the colour-transition animations so
             hover state changes happen instantly. UseFlatButtons takes precedence when
             both are on. -->
        <Style Selector="Window.flat-button-borders Button">
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>
        <Style Selector="Window.flat-button-borders Button /template/ Border#BaseBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>
        <Style Selector="Window.flat-button-borders Button /template/ Border#Sheen">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions" Value="{x:Null}"/>
        </Style>
        <Style Selector="Window.flat-button-borders Button /template/ Border#InnerShadow">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Window.flat-button-borders Button /template/ Border#BottomShadow">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Window.flat-button-borders Button /template/ local|BorderEnergyTrace#BorderTrace">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Window.flat-button-borders Button:pointerover">
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        <Style Selector="Window.flat-button-borders Button:pointerover /template/ Border#BaseBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Window.flat-button-borders Button:pressed">
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>
        <Style Selector="Window.flat-button-borders Button:pressed /template/ Border#BaseBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource UserAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

    </Application.Styles>
</Application>

