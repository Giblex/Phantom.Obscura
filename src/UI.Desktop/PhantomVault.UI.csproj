<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
  <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateTargetPlatformAttribute>false</GenerateTargetPlatformAttribute>
    <AvaloniaUseCompiledXaml>true</AvaloniaUseCompiledXaml>
    <UseWpf>false</UseWpf>
    <!-- Use Avalonia for cross‑platform desktop UI. -->

    <!-- Application Icon (Desktop/Taskbar icon) -->
    <ApplicationIcon>Assets\Visuals\Giblex Icons\Parent Icon.ico</ApplicationIcon>
    <!--
      App manifest: requests administrator at process start so per-call UAC prompts
      from diskpart / USB write-protection IOCTLs are suppressed (one prompt at
      launch instead of one per invocation).
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- CS1591: Missing XML comment for publicly visible type or member - Temporarily suppressed -->
    <!-- CS0618: Obsolete method usage - Some internal uses of deprecated methods are intentional -->
    <!-- CS1573, CS1574, CS1571: XML documentation parameter mismatches - Fix in future refactor -->
    <!-- CS1998: Async methods without await - Some methods are async for interface consistency -->
    <!-- CS8625: Nullable reference type warnings - Cleaned up in future refactor -->
    <!-- TODO: Add XML documentation comments for all public APIs -->
    <!-- NU1903: vulnerable transitive dep (Tmds.DBus.Protocol via Avalonia.Linux) — suppressed until Avalonia ships a fix -->
    <!-- NU1510: System.Text.Json inbox in .NET 10 — any residual explicit ref is harmless -->
    <NoWarn>$(NoWarn);1591;CS0618;CS1573;CS1574;CS1571;CS1998;CS8625;CS0012;NU1903;NU1510</NoWarn>
  </PropertyGroup>

  <!--
    WinFsp (optional dependency): backs the encrypted virtual-drive mount.
    The managed binding is resolved from the machine's WinFsp install via the
    registry. When WinFsp is not installed the mount code compiles to inert
    stubs (the WINFSP symbol is undefined), so the build never hard-fails.
  -->
  <PropertyGroup>
    <WinFspDir>$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\WinFsp@InstallDir)</WinFspDir>
    <WinFspAssembly>$(WinFspDir)bin\winfsp-msil.dll</WinFspAssembly>
    <HasWinFsp Condition="'$(WinFspDir)' != '' and Exists('$(WinFspAssembly)')">true</HasWinFsp>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HasWinFsp)' == 'true'">
    <DefineConstants>$(DefineConstants);WINFSP</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HasWinFsp)' == 'true'">
    <Reference Include="winfsp-msil">
      <HintPath>$(WinFspAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Exclude legacy snapshots from the build so they don't register duplicate Avalonia resources -->
  <ItemGroup>
    <Compile Remove="bin\**;obj\**;obj_*\**" />
    <Compile Remove="Legacy\**\*" />
    <AvaloniaXaml Remove="Legacy\**\*.axaml" />
    <AvaloniaResource Remove="Legacy\**\*" />
    <None Remove="Legacy\**\*" />
    <!-- Note: IntegratedRecoveryService.cs, RecoveryDeveloperMode.cs, and RecoveryPanel.axaml(.cs) 
         have been moved to Legacy folder. Stub replacements are in use. -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <ProjectReference Include="..\Core\PhantomVault.Core.csproj" />
    <ProjectReference Include="..\Platform\PhantomVault.Platform.csproj" />
    <ProjectReference Include="..\Crypto\GiblexVault.Security.ZK.csproj" />
    <ProjectReference Include="..\Autofill\PhantomVault.Autofill.csproj" />
    <!-- Build the privileged helper before the UI, but don't reference its assembly;
         it is copied into a Broker subfolder of the output (see CopyPrivilegedBroker). -->
    <ProjectReference Include="..\PrivilegedBroker\PhantomVault.PrivilegedBroker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\..\..\Phantom.Root\Giblex.AssetShield\Giblex.AssetShield.csproj" />
    <!-- PhantomKey broker client for the embedded Unlock window. -->
    <ProjectReference Include="..\..\..\Phantom.Key\src\PhantomKey.Integration\PhantomKey.Integration.csproj" />
    <ProjectReference Include="..\..\..\Phantom.Root\Phantom.UI.Shared\Phantom.UI.Shared.csproj" />
    <!-- Keyless cross-app suite-session coordinator (carries no key material). -->
    <ProjectReference Include="..\..\..\Phantom.Root\Phantom.Suite.Session\Phantom.Suite.Session.csproj" />
    <!-- Suite-wide USB partition provisioner (PhantomVolumeProvisioner) -->
    <ProjectReference Include="..\..\..\Phantom.Root\Phantom.Sync\Phantom.Sync.csproj" />
    <!-- <ProjectReference Include="..\..\..\PhantomRecovery\PhantomRecovery.App\PhantomRecovery.App.csproj" /> -->
    <!-- <ProjectReference Include="..\..\..\PhantomRecovery\PhantomRecovery.Core\PhantomRecovery.Core.csproj" /> -->
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.11" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.3.11" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.0.0" />
    <PackageReference Include="Avalonia.Xaml.Interactivity" Version="11.3.0.6" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <!-- MVVM Toolkit for ObservableObject and RelayCommand -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Serilog for structured logging -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    
    <!-- Embed policy files as resources for runtime verification -->
    <EmbeddedResource Include="Assets\Policies\root_public.json" />
    <EmbeddedResource Include="Assets\Policies\obscura_root.crt" />
    <EmbeddedResource Include="Assets\Policies\base_policy.signed.json" />
    <None Include="..\..\Policies\base_policy.json" Link="Policies\base_policy.json" CopyToOutputDirectory="PreserveNewest" />
    
    <!-- Include all icon and image files -->
    <!-- New organized Visuals folder structure -->
    <AvaloniaResource Include="Assets\Visuals\Giblex Icons\**\*.*" />
    <AvaloniaResource Include="Assets\Visuals\App Icons\**\*.png" />
    <AvaloniaResource Include="Assets\Visuals\App Icons\**\*.svg" />
    <AvaloniaResource Include="Assets\Visuals\Cat Icons\**\*.png" />
    <AvaloniaResource Include="Assets\Visuals\Entry Logos\**\*.png" />
    
    <AvaloniaResource Include="Assets\noise_128.png" />
    <AvaloniaResource Include="Assets\palette-icon.png" />
    <AvaloniaResource Include="Assets\phantom_obscura_tray.png" />
    <AvaloniaResource Include="Assets\phantom_obscura_tray.ico" />
    <AvaloniaResource Include="Assets\PO Icon.png" />
    <AvaloniaResource Include="Assets\PO.svg" />
    <AvaloniaResource Include="Assets\Logo Transparent.svg" />
    <AvaloniaResource Include="Assets\ok.svg" />
    <AvaloniaResource Include="Assets\ok.png" />
    <AvaloniaResource Include="Assets\dot_pattern.png" />
    <!-- Include SVG icons for UI elements -->
    <AvaloniaResource Include="Assets\Icons\*.svg" />
    <AvaloniaResource Include="Assets\SVG\*.svg" />
    <AvaloniaResource Include="Assets\SVG\Current\*.svg" />
  <!-- Include OS Icons used in multiple UI controls, including filenames with spaces -->
  <AvaloniaResource Include="Assets\Icons\OS Icons\**\*.*" />
    
    <!-- Include extracted XAML resources for modular UI architecture -->
    <!-- Note: .axaml files are auto-included by the Avalonia SDK as AvaloniaResource.
         Explicit includes would cause duplicate key errors at startup. -->
    <!-- System.Text.Json is inbox in .NET 10; no explicit reference needed -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy all logo files to output directory for IconManager runtime access -->
    <None Include="Assets\Icons\Logos\PNG\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Icons\Logos\Ico\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Icons\Logos\Circle\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Icons\Logos\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Icons\Logos\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Icons\Logos\import\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  <!-- Copy PO UI folder (stored under Logos) so IconManager can enumerate files at runtime -->
  <None Include="Assets\Icons\Logos\PO UI\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  <!-- Bundled drivers (e.g. WinFsp MSI). Drop winfsp-<ver>.msi into src\UI.Desktop\drivers
       and it ships to the app's drivers\ folder so the Storage step can install it
       automatically (elevated, passive) without a manual download. -->
  <None Include="drivers\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  <!-- Copy OS Icons to output as well for runtime enumeration -->
  <None Include="Assets\Icons\OS Icons\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  <!-- Copy only Entry Logos and Cat Icons to output for IconManager runtime access -->
  <Content Include="Assets\Visuals\Entry Logos\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Assets\Visuals\Entry Logos\**\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Assets\Visuals\Entry Logos\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Assets\Visuals\Entry Logos\**\*.ico" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Assets\Visuals\Cat Icons\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Assets\Visuals\Cat Icons\**\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Assets\Visuals\Cat Icons\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
  <Content Include="Assets\Visuals\Cat Icons\**\*.ico" CopyToOutputDirectory="PreserveNewest" />
  <!-- (removed) previously added copy rule for Assets\Icons\Icons\PNG - icons live under Assets\Icons\Logos\PNG -->
  </ItemGroup>


  <Target Name="DumpAvaloniaItems">
    <Message Text="AvaloniaXaml: @(AvaloniaXaml->'%(Identity)')" Importance="High" />
    <Message Text="AvaloniaResource: @(AvaloniaResource->'%(Identity)')" Importance="High" />
  </Target>

  <!--
    Deploy the privileged helper into a Broker\ subfolder of the app output so it
    travels with its own dependencies (Core, Hosting, etc.). The UI resolves and
    installs it from here via BrokerServiceController.
  -->
  <Target Name="CopyPrivilegedBroker" AfterTargets="Build">
    <PropertyGroup>
      <_BrokerOutDir>$(MSBuildProjectDirectory)\..\PrivilegedBroker\bin\$(Configuration)\net10.0-windows10.0.19041.0\</_BrokerOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_BrokerFiles Include="$(_BrokerOutDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BrokerFiles)" DestinationFiles="@(_BrokerFiles->'$(OutDir)Broker\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('$(_BrokerOutDir)')" />
  </Target>

  <!-- AssetShield: Encrypt all published files except the main exe -->
  <Target Name="EncryptPublishedAssets" AfterTargets="Publish">
    <PropertyGroup>
      <_AssetShieldToolProject>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', '..', 'Phantom.Root', 'Giblex.AssetShield', 'Tool', 'Giblex.AssetShield.Tool.csproj'))</_AssetShieldToolProject>
    </PropertyGroup>
    <Exec Command="dotnet run --project &quot;$(_AssetShieldToolProject)&quot; -c $(Configuration) -- &quot;$(PublishDir)&quot; &quot;$(AssemblyName).exe&quot;" />
  </Target>

  <!-- Opt-in Authenticode signing for Release publish. See the .targets file
       for docs. No effect unless SignOutput=true is passed at publish time. -->
  <Import Project="..\..\..\Phantom.Root\build\SignPublishOutput.targets" />

</Project>





