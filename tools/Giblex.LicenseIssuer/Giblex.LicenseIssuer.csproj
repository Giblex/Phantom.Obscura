<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Giblex.LicenseIssuer</RootNamespace>
    <AssemblyName>license-issuer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuses the exact codec and claim shape the client verifies with, so a token
         minted here cannot drift from what the app accepts. -->
    <ProjectReference Include="..\..\src\Core\PhantomVault.Core.csproj" />
  </ItemGroup>

</Project>
